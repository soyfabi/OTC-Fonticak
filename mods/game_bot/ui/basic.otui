-- Bot-wide panel look (overrides client FlatPanel while bot styles are loaded)
FlatPanel < Panel
  image-source: /images/ui/panel_flat_border
  image-border: 1

ScrollableFlatPanel < ScrollablePanel
  image-source: /images/ui/panel_flat_border
  image-border: 1

BotButton < Button
  height: 17
  margin-top: 2
  font: verdana-11px-antialised
  text-align: center
  text-offset: 0 0
  padding: 0
  $pressed:
    text-offset: 0 0
  $on:
    text-offset: 0 0

BotSwitch < Button
  margin-top: 2
  height: 17
  font: verdana-11px-antialised
  text-align: center
  text-offset: 0 0
  padding: 0
  image-color: green
  $on:
    image-color: green
    text-offset: 0 0
  $!on:
    image-color: red
    text-offset: 0 0
  $pressed:
    text-offset: 0 0

SmallBotSwitch < Button
  margin-top: 2
  height: 15
  font: verdana-11px-antialised
  text-align: center
  text-offset: 0 0
  padding: 0
  image-color: green
  $on:
    image-color: green
    text-offset: 0 0
  $!on:
    image-color: red
    text-offset: 0 0
  $pressed:
    text-offset: 0 0

BotLabel < Label
  margin-top: 2
  height: 15
  font: verdana-11px-antialised
  text-auto-resize: true
  text-align: center
  text-wrap: true

BotItem < Item
  virtual: true
  &selectable: true
  &editable: true

BotTextEdit < TextEdit
  @onClick: modules.client_textedit.show(self)
  text-align: center
  multiline: false
  focusable: false
  height: 20

BotSeparator < HorizontalSeparator
  margin-top: 5
  margin-bottom: 3

BotSmallScrollBar < VerticalQtScrollBar
  width: 12
  step: 5
  pixels-scroll: true

BotPanel < Panel
  margin-top: 1
  ScrollablePanel
    id: content
    anchors.fill: parent
    margin-right: 14
    margin-left: 1
    margin-bottom: 5
    vertical-scrollbar: botPanelScroll
    layout:
      type: verticalBox

  VerticalQtScrollBar
    id: botPanelScroll
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-top: 1
    margin-bottom: 1
    width: 12
    step: 5
    pixels-scroll: true

CaveBotLabel < Label
  background-color: alpha
  text-offset: 2 0
  focusable: true

  $focus:
    background-color: #00000055

SlotComboBoxPopupMenu < ComboBoxPopupMenu
SlotComboBoxPopupMenuButton < ComboBoxPopupMenuButton
SlotComboBox < ComboBox
  @onSetup: |
    self:addOption("Head")
    self:addOption("Neck")
    self:addOption("Back")
    self:addOption("Body")
    self:addOption("Right")
    self:addOption("Left")
    self:addOption("Leg")
    self:addOption("Feet")
    self:addOption("Finger")
    self:addOption("Ammo")
    self:addOption("Purse")
