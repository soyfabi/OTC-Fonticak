BotContainer < Panel
  height: 34

  BotSmallScrollBar
    id: scroll
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    width: 12
    step: 5
    pixels-scroll: true

  ScrollablePanel
    id: items
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: scroll.left
    margin-right: 2
    vertical-scrollbar: scroll
    layout:
      type: grid
      cell-size: 34 34
      flow: true
