BotTabBar < TabBar
  tab-spacing: 1
  margin-left: 1
  margin-right: 1
  height: 20

  $on:
    visible: true
    margin-top: 2

  $!on:
    visible: false
    margin-top: -20

BotTabBarPanel < TabBarPanel
BotTabBarButton < UIButton
  height: 18
  image-source: /images/ui/tabbutton_square
  image-color: #dfdfdf
  image-clip: 0 0 98 18
  image-border: 3
  icon-color: #dfdfdf
  color: #dfdfdf
  anchors.top: parent.top
  padding: 2
  padding-right: 2
  font: verdana-11px-antialised
  text-horizontal-auto-resize: false
  text-align: center
  text-offset: 0 0

  $first:
    anchors.left: parent.left

  $!first:
    anchors.left: prev.right
    margin-left: 0

  $hover !checked:
    image-clip: 0 18 98 18
    color: #dfdfdf
    text-offset: 0 0

  $disabled:
    image-color: #dfdfdf88
    icon-color: #dfdfdf

  $pressed:
    text-offset: 0 0

  $checked:
    image-clip: 0 36 98 18
    color: #dfdfdf
    text-offset: 0 0

  $checked pressed:
    text-offset: 0 0

  $on !checked:
    color: #de6f6f

MiniWindow
  id: botWindow
  !text: tr('Bot Hub')
  height: 600
  @onClose: modules.game_bot.onMiniWindowClose()
  &save: true
  &autoOpen: 10

  UIWidget
    id: miniwindowIcon
    anchors.top: miniwindowHeader.top
    anchors.left: miniwindowHeader.left
    margin-top: 0
    margin-left: 3
    size: 16 16
    image-source: /images/topbuttons/bot
    image-smooth: false

  Label
    id: miniwindowTitle
    anchors.top: miniwindowHeader.top
    anchors.left: miniwindowHeader.left
    anchors.right: miniwindowHeader.right
    margin-top: 2
    margin-left: 20
    margin-right: 50
    font: Verdana Bold-11px
    height: 13
    color: #9d9d9dff
    !text: tr('Bot Hub')

  MiniWindowContents
    anchors.right: parent.right
    margin-right: 3
    always-show-vertical-scrollbar: false

    ComboBox
      id: config
      &menuScroll: true
      &menuHeight: 450
      &menuScrollStep: 100
      &parentWidth: true
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 2
      margin-left: 2
      margin-right: 75
      padding-right: 24
      text-offset: 3 0
      text-align: left
      font: verdana-11px-rounded

    Button
      id: editConfig
      anchors.top: prev.top
      anchors.left: prev.right
      anchors.right: parent.right
      !text: tr('Edit')
      @onClick: modules.game_bot.edit()
      margin-left: 3
      margin-right: 37
      font: verdana-11px-antialised

    Button
      id: enableButton
      anchors.top: prev.top
      anchors.left: prev.right
      anchors.right: parent.right
      margin-left: 3
      margin-right: 2
      font: verdana-11px-antialised
      text-align: center
      text-offset: 0 0
      padding: 0

      $on:
        text: ON
        color: #00AA00
        text-offset: 0 0

      $!on:
        text: OFF
        color: #FF0000
        text-offset: 0 0

      $pressed:
        text-offset: 0 0

      $hover:
        text-offset: 0 0

    Label
      id: statusLabel
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      text-wrap: true
      text-auto-resize: true
      text-align: center
      !text: tr('Status: waiting')
      margin-left: 3
      margin-right: 3

      $on:
        margin-top: 3

      $!on:
        text:
        margin-top: -13

    HorizontalSeparator
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-top: 3
      margin-left: 2
      margin-right: 2

    Panel
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      id: messages
      layout:
        type: verticalBox
        fit-children: true

    HorizontalSeparator
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-top: 5
      margin-left: 2
      margin-right: 2

    BotTabBar
      id: botTabs
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-left: 1
      margin-right: 2

    Panel
      id: botPanel
      margin-top: 2
      anchors.top: prev.bottom
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
