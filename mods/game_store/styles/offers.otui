&var-text-color: #dfdfdf
&var-text-cip-color-white: #f7f7f7
&var-text-cip-color-highlight: #f4f4f4
&var-text-cip-color-grey: #909090
&var-text-cip-color: #c0c0c0
&var-cip-inactive-color: #707070
&var-text-cip-color-green: #44ad25
&var-text-color-disabled: #dfdfdf88
&var-text-cip-color-orange: #ff9854
&var-text-cip-color-yellow: #ffda34
&var-text-cip-color-light-red: #f75f5f
&var-text-cip-color-blue: #1872c3
&var-text-cip-color-green-disabled: #255f15
&var-text-cip-store-disabled: #565656
&var-text-cip-store-red: #D33C3C
&var-text-cip-store-red-disabled: #6d2626
&var-text-cip-store-sale: #ffda34
&var-text-cip-store-sale-disabled: #6f5f18
&var-text-cip-store-timed: #1872c3
&var-text-cip-store-timed-disabled: #183f63
&var-textlist-selected: #585858
&var-textlist-even: #414141
&var-textlist-odd: #484848
&var-main-font: verdana-11px-antialised
&var-cip-main-font: Verdana Bold-11px
&var-cip-font: verdana-11px-antialised
&var-cip-font-off: verdana-11px-antialised
&var-cip-font-wheel: Verdana Bold-11px-wheel
&var-cip-font-mono-rounded: verdana-11px-mono-rounded
&var-cip-font-rounded-lowspace: verdana-11px-rounded-lowspace
PackageLabel < Label
  size: 140 20
  text-wrap: true
  margin-top: 10
  text-auto-resize: true
  !text: tr('This package contains:')

CreatureLabel < Panel
  size: 260 64
  UICreature
    id: creature
    size: 64 64
    anchors.top: parent.top
    anchors.left: parent.left
    phantom: true
    creature-size: 64
    creature-center: true
    idle-animate: true
    animate: true
  Label
    id: name
    width: 210
    margin-top: 20
    margin-left: 10
    text-wrap: true
    anchors.top: parent.top
    anchors.left: prev.right
    text-align: bottomleft

GeneralOffersPanel < Panel
  id: generalOffersPanel
  anchors.top: parent.top
  anchors.left: parent.left
  size: 563 540
  border-width: 2
  margin-top: -6
  border-color-top: #646464
  border-color-left: #646464
  border-color-right: #363636
  border-color-bottom: #363636
  FlatPanel
    id: optionsMaped
    size: 550 25
    anchors.top: parent.top
    anchors.right: parent.right
    anchors.left: parent.left
    margin: 6 6 6 6
    image-source: /images/store/optionsMaped
    image-border: 3
    ComboBox
      id: customOptions
      anchors.left: parent.left
      anchors.top: parent.top
      margin-top: 2
      margin-right: 2
      margin-left: 2
      size: 260 20
      text-align: center
      text-offset: -8 0
      @onSetup: |
        self:addOption("Show All")
      @onOptionChange: modules.game_store.Offers:refreshOptions(self:getId(), self:getCurrentOption())
    ComboBox
      id: normalOptions
      anchors.left: customOptions.right
      anchors.right: parent.right
      anchors.top: parent.top
      margin-top: 2
      margin-right: 2
      margin-left: 2
      height: 20
      text-align: center
      text-offset: -8 0
      @onOptionChange: modules.game_store.Offers:checkOrder(self:getId(), self.currentIndex)
      @onSetup: |
        self:addOption("Most Popular First")
        self:addOption("Alphabetically")
        self:addOption("Newest First")
  StoreScrollablePanel
    id: offers
    size: 262 497
    anchors.top: prev.bottom
    anchors.left: parent.left
    vertical-scrollbar: offerListScrollBar
    image-source: /images/ui/1pixel-down-frame
    image-border: 1
    margin-top: 6
    margin-left: 6
    layout:
      type: grid
      cell-size: 240 82
      cell-spacing: 2
      flow: true
    padding: 4
    padding-bottom: 2
    padding-left: 5
  VerticalScrollBar
    id: offerListScrollBar
    anchors.top: prev.top
    anchors.bottom: prev.bottom
    anchors.right: prev.right
    margin-bottom: 1
    margin-right: 1
    margin-top: 1
    step: 80
  Label
    id: offerName
    anchors.top: prev.top
    anchors.right: parent.right
    anchors.left: prev.right
    margin-top: 5
    text-align: center
    color: $var-text-cip-color
    font: $var-cip-font
    text-auto-resize: true
  UIWidget
    id: infopanel
    size: 130 130
    anchors.left: offerListScrollBar.right
    anchors.top: prev.bottom
    image-source: /images/ui/1pixel-down-frame
    image-border: 1
    margin-top: 5
    margin-left: 11
    UIWidget
      id: image
      anchors.fill: parent
      margin: 2 2 2 2
      size: 128 128
      phantom: true
      image-fixed-ratio: true
    UICreature
      id: outfit
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter
      size: 128 128
      creature-size: 128
      creature-center: true
      animate: true
      phantom: true
    UIItem
      id: item
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter
      size: 128 128
      padding: 28
      phantom: true
      virtual: true
      &drawRarity: false
      fixed-size: true
  Button
    id: buy1
    size: 144 20
    anchors.top: prev.top
    anchors.right: parent.right
    margin-left: 5
    margin-right: 7
    image-source: /images/store/buybutton
    image-clip: 0 0 144 20
    enabled: true
    tooltip-font: $var-cip-font-wheel
    $hover !on:
      image-clip: 0 0 144 20

    $pressed:
      image-clip: 0 20 144 20

    $on !pressed:
      image-clip: 0 0 144 20

    $!on:
      image-clip: 0 40 144 20

  UIWidget
    id: price1
    size: 144 20
    anchors.top: prev.bottom
    anchors.right: parent.right
    margin-top: 5
    margin-right: 7
    image-source: /images/store/price1
    image-clip: 0 0 144 20
    UIWidget
      id: image
      size: 12 12
      image-border: 0
      image-source: /images/store/icon-tibiacoin
      anchors.left: priceOff.right
      anchors.top: parent.top
      margin-top: 5
      margin-left: 20
    // AQUI SE PRICEOFF ESTIVER VISIVEL DEVEMOS MUDAR ESTE MARGIN para 50 se tiver 6 digitos no price se tiver menos que isso o margin deve ser 45
    Label
      id: price
      !text: tr('0')
      anchors.top: parent.top
      anchors.right: prev.left
      margin-right: 3
      margin-top: 3
      text-auto-resize: true
      font: $var-cip-font
      color: $var-text-cip-color
    UIWidget
      id: priceOff
      !text: tr('2,000')
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 3
      margin-left: 27
      font: $var-cip-font-off
      color: $var-cip-inactive-color
      text-auto-resize: true
      visible: false
  Button
    id: buy2
    size: 144 20
    anchors.top: prev.bottom
    anchors.right: parent.right
    margin-top: 5
    margin-right: 7
    image-source: /images/store/buybutton
    image-clip: 0 0 144 20
    visible: false
    tooltip-font: $var-cip-font-wheel
    $hover !on:
      image-clip: 0 0 144 20

    $pressed:
      image-clip: 0 20 144 20

    $on !pressed:
      image-clip: 0 0 144 20

    $!on:
      image-clip: 0 40 144 20

  UIWidget
    id: price2
    size: 144 20
    anchors.top: prev.bottom
    anchors.right: parent.right
    margin-right: 7
    margin-top: 5
    image-source: /images/store/price1
    image-clip: 0 0 144 20
    visible: false
    UIWidget
      id: image
      size: 12 12
      image-border: 0
      image-source: /images/store/icon-tibiacoin
      anchors.right: parent.right
      anchors.top: parent.top
      margin-top: 5
      margin-right: 55
    Label
      id: price
      !text: tr('0')
      anchors.top: parent.top
      anchors.right: prev.left
      margin-right: 3
      margin-top: 3
      text-auto-resize: true
      font: $var-cip-font
      color: $var-text-cip-color
  Button
    id: tryOn
    size: 144 20
    visible: false
    anchors.bottom: next.top
    anchors.right: parent.right
    margin-bottom: 10
    margin-right: 7
    image-source: /images/store/tryon
    image-clip: 0 0 144 20
    $hover:
      image-clip: 0 0 144 20
    $pressed:
      image-clip: 0 20 144 20

  TextList
    id: description
    size: 279 332
    vertical-scrollbar: descriptionScrollBar
    anchors.top: infopanel.bottom
    anchors.left: infopanel.left
    anchors.right: parent.right
    margin-top: 10
    margin-right: 7
    focusable: false
    // Textured scrollarea background

    image-source: /images/ui/scrollarea
    image-border: 1
    background-color: alpha
    border-width: 0
    padding-top: 5
    padding-right: 15
    padding-left: 5
    layout:
      type: verticalBox
      align-top: true

    Label
      id: error
      height: 0
      text-wrap: true
      color: $var-text-cip-store-red
      visible: false
      margin-left: 2

    Label
      id: image
      text-wrap: true
      color: $var-text-cip-store-red
      visible: true
      margin-left: 2
      width: 260
      color: #f4f4f4

    Panel
      id: package
      height: 20
      visible: true
      margin-left: 2
      phantom: true
      layout:
        type: verticalBox
        align-top: true

  VerticalScrollBar
    id: descriptionScrollBar
    anchors.top: description.top
    anchors.bottom: description.bottom
    anchors.right: description.right
    margin-top: 1
    margin-right: 1
    margin-bottom: 1
    step: 14
    pixels-scroll: true
