        !text: tr('Dodge')
      SkillValueLabel

    SmallSkillButton
      id: onslaught
      visible: false
      SkillNameLabel
        !text: tr('Onslaught')
        margin-left: -3
      SkillValueLabel
      margin-top: -2
      margin-right: 9

    HorizontalSeparator
      id: separadorOnDefenseInfoChange
      margin-top: 4
      margin-left: 1
      margin-right: -1
      image-offset: 1 -1
      visible: false
      margin-bottom: 7

    SmallSkillButton
      id: physicalResist
      visible: false
      margin-top: -2
      SkillNameLabel
        !text: tr('Physical')
      SkillValueLabel
        margin-right: 15
      ImageAbsorb
        image-source: /game_cyclopedia/images/bestiary/icons/monster-icon-physical-resist

    SmallSkillButton
