&var-cip-font: verdana-11px-antialised
&var-text-cip-color: #c0c0c0

MiniWindow
  id: skillWindow
  height: 150
  @onOpen: modules.game_skills.onMiniWindowOpen()
  @onClose: modules.game_skills.onMiniWindowClose()
  &save: true
  &moveOnlyToSideBars: true

  UIWidget
    id: miniwindowIcon
    anchors.top: miniwindowHeader.top
    anchors.left: miniwindowHeader.left
    margin-top: 2
    margin-left: 4
    image-source: /images/topbuttons/skills
    image-rect: 0 0 12 12
    image-smooth: false

  Label
    id: miniwindowTitle
    anchors.top: miniwindowHeader.top
    anchors.left: miniwindowHeader.left
    anchors.right: miniwindowHeader.right
    margin-top: 1
    margin-left: 20
    margin-right: 50
    font: $var-cip-font
    height: 13
    !text: tr('Skills')
    color: #9d9d9dff

  MiniWindowContents
    padding-left: 5
    padding-right: 5
    layout: verticalBox

    SkillButton
      margin-top: 8
      id: level
      SkillNameLabel
        !text: tr('Level')
      SkillValueLabel
      RedPercentPanel
        margin-top: 13

    SkillButton
      id: experience
      height: 15
      SkillNameLabel
        !text: tr('XP') 
        color: #1bd625ff
      SkillValueLabel
      margin-top: -2

    SkillButton
      id: xpGainRate
      height: 15
      SkillNameLabel
        !text: tr('XP Gain Rate')
        color: #ffea79
      SkillValueLabel
      margin-top: -3

    XpBoostButton
      id: xpBoos

    SkillButton
      margin-top: -14
      id: health
      height: 15
      SkillNameLabel
        !text: tr('Hit Points')
      SkillValueLabel

    SkillButton
      id: mana
      height: 15
      SkillNameLabel
        !text: tr('Mana')
      SkillValueLabel
      margin-top: -3

    SkillButton
      id: soul
      height: 15
      SkillNameLabel
        !text: tr('Soul Points')
      SkillValueLabel
      margin-top: -3

    SkillButton
      id: capacity
      height: 15
      SkillNameLabel
        !text: tr('Capacity')
      SkillValueLabel
      margin-top: -3 

    SkillButton
      id: speed
      height: 15
      SkillNameLabel
        !text: tr('Speed')
      SkillValueLabel
      margin-top: -3

    SkillButton
      id: regenerationTime
      height: 15
      SkillNameLabel
        !text: tr('Food')
      SkillValueLabel
      margin-top: -3

    SkillButton
      id: stamina
      SkillNameLabel
        !text: tr('Stamina')
        text-offset: 0 -3
      SkillValueLabel
        text-offset: 0 -3
      RedPercentPanel
        margin-top: 10

    SkillButton
      id: offlineTraining
      SkillNameLabel
        !text: tr('Offline Training')
        text-offset: 0 -5
      SkillValueLabel
        text-offset: 0 -5
      RedPercentPanel
        margin-top: 8

    HorizontalSeparator
      id: separatorSkills
      margin-top: -3
      margin-left: 2
      image-offset: 1 0
      margin-right: -1
      margin-bottom: 5

    SkillButton
      id: magiclevel
      SkillNameLabel
        !text: tr('Magic')
      SkillValueLabel
      ImageSkill
        image-source: /images/game/creatures/icons-skills
        image-clip: 27 0 9 9
        image-size: 9 9
        margin-left: 1
      SkillPercentPanel
        background-color: #00c000

    SkillButton
      id: skillId0
      SkillNameLabel
        !text: tr('Fist')
      SkillValueLabel
      ImageSkill
        image-source: /images/game/creatures/icons-skills
        image-clip: 0 0 9 9
        image-size: 9 9
        margin-left: 1
      SkillPercentPanel
      margin-top: 2

    SkillButton
      id: skillId1
      SkillNameLabel
        !text: tr('Club')
      SkillValueLabel
      ImageSkill
        image-source: /images/game/creatures/icons-skills
        image-clip: 45 0 9 9
        image-size: 9 9
        margin-left: 1
      SkillPercentPanel
      margin-top: 2

    SkillButton
      id: skillId2
      SkillNameLabel
        !text: tr('Sword')
      SkillValueLabel
      ImageSkill
        image-source: /images/game/creatures/icons-skills
        image-clip: 36 0 9 9
        image-size: 9 9
        margin-left: 1
      SkillPercentPanel
      margin-top: 2

    SkillButton
      id: skillId3
      SkillNameLabel
        !text: tr('Axe')
      SkillValueLabel
      ImageSkill
        image-source: /images/game/creatures/icons-skills
        image-clip: 54 0 9 9
        image-size: 9 9
        margin-left: 1
      SkillPercentPanel
      margin-top: 2

    SkillButton
      id: skillId4
      SkillNameLabel
        !text: tr('Distance')
      SkillValueLabel
      ImageSkill
        image-source: /images/game/creatures/icons-skills
        image-clip: 18 0 9 9
        image-size: 9 9
        margin-left: 1
      SkillPercentPanel
      margin-top: 2

    SkillButton
      id: skillId5
      SkillNameLabel
        !text: tr('Shielding')
      SkillValueLabel
      ImageSkill
        image-source: /images/game/creatures/icons-skills
        image-clip: 63 0 9 9
        image-size: 9 9
        margin-left: 1
      SkillPercentPanel
      margin-top: 2

    SkillButton
      id: skillId6
      SkillNameLabel
        !text: tr('Fishing')
      SkillValueLabel
      ImageSkill
        image-source: /images/game/creatures/icons-skills
        image-clip: 72 0 9 9
        image-size: 9 9
        margin-left: 1
      SkillPercentPanel
      margin-top: 2

    HorizontalSeparator
      id: separadorOnOffenceInfoChange
      margin-top: 7
      margin-left: 1
      margin-right: -1
      image-offset: 1 0
      margin-bottom: 6

    SmallSkillButton
      id: skillId7
      visible: false
      SkillNameLabel
        !text: tr('Critical Hit Chance')
      SkillValueLabel

    SmallSkillButton
      id: skillId8
      visible: false
      SkillNameLabel
        !text: tr('Critical Hit Damage')
      SkillValueLabel

    SmallSkillButton
      id: skillId9
      visible: false
      SkillNameLabel
        !text: tr('Life Leech Chance')
      SkillValueLabel

    SmallSkillButton
      id: skillId10
      visible: false
