        !text: tr('Mana Leech')
        margin-left: -3
      SkillValueLabel
      margin-top: -2
      margin-right: 9

    SmallSkillButton
      visible: false
      id: criticalHit
      SkillNameLabel
        !text: tr('Critical Hit:')
        margin-top: -2

    SmallSkillButton
      id: criticalChance
      visible: false
      SkillNameLabel
        margin-left: 7
        !text: tr('Chance')
      SkillValueLabel
      margin-top: -4
      margin-right: 9

    SmallSkillButton
      id: criticalExtraDamage
      visible: false
      SkillNameLabel
        margin-left: 7
        !text: tr('Extra Dam...')
      SkillValueLabel
      margin-top: -2
      margin-right: 9

    SmallSkillButton
      id: skillId13
      visible: false
      SkillNameLabel
        !text: tr('Fatal')
      SkillValueLabel

    SmallSkillButton
      id: skillId14
      visible: false
