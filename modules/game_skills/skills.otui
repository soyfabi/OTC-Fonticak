        !text: tr('Momentum')
      SkillValueLabel

    SmallSkillButton
      id: skillId16
      visible: false
      SkillNameLabel
        !text: tr('Transcendence')
      SkillValueLabel

    SmallSkillButton
      id: damageHealing
      visible: false
      SkillNameLabel
        !text: tr('Damage/Healing')
        text-offset: -4 0
      SkillValueLabel
      margin-right: 9

    SmallSkillButton
      id: attackValue
      visible: false
      SkillNameLabel
        !text: tr('Attack Value')
      SkillValueLabel
        margin-right: 15
      ImageAbsorb
      margin-top: -2

    SmallSkillButton
      visible: false
      id: convertedDamage
      SkillNameLabel
        !text: tr('Converted ...')
      SkillValueLabel
        margin-right: 15
      ImageAbsorb
      margin-top: -2

    SmallSkillButton
      id: lifeLeech
      visible: false
      SkillNameLabel
        !text: tr('Life Leech')
