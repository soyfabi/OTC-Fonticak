Module
  name: dev_otui
  description: Editor/inspector de telas .otui com preview fiel dentro do proprio cliente
  author: Renan
  website: none
  sandboxed: true
  scripts: [ otml, dev_otui ]
  // Off by default so a broken/partial load cannot affect login or game UI.
  // Enable manually in Module Manager, or set autoload: true while developing.
  autoload: false
  dependencies: [ client_topmenu ]
  @onLoad: init()
  @onUnload: terminate()
