Module
  name: game_podium_player
  description: Player outfit podium (Podium of Renown)
  author: Fonticak
  sandboxed: true
  dependencies: [ game_interface ]
  scripts: [ player_podium_protocol, renown_podium ]
  @onLoad: |
    initPlayerPodiumProtocol()
    init()
  @onUnload: |
    terminate()
    terminatePlayerPodiumProtocol()
