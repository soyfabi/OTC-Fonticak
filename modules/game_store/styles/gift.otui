&var-text-color: #dfdfdf
&var-text-cip-color-white: #f7f7f7
&var-text-cip-color-highlight: #f4f4f4
&var-text-cip-color-grey: #909090
&var-text-cip-color: #c0c0c0
&var-cip-inactive-color: #707070
&var-text-cip-color-green: #44ad25
&var-text-color-disabled: #dfdfdf88
&var-text-cip-color-orange: #ff9854
&var-text-cip-color-yellow: #ffda34
&var-text-cip-color-light-red: #f75f5f
&var-text-cip-color-blue: #1872c3
&var-text-cip-color-green-disabled: #255f15
&var-text-cip-store-disabled: #565656
&var-text-cip-store-red: #D33C3C
&var-text-cip-store-red-disabled: #6d2626
&var-text-cip-store-sale: #ffda34
&var-text-cip-store-sale-disabled: #6f5f18
&var-text-cip-store-timed: #1872c3
&var-text-cip-store-timed-disabled: #183f63
&var-textlist-selected: #585858
&var-textlist-even: #414141
&var-textlist-odd: #484848
&var-main-font: verdana-11px-antialised
&var-cip-main-font: Verdana Bold-11px
&var-cip-font: verdana-11px-antialised
&var-cip-font-off: verdana-11px-antialised
&var-cip-font-wheel: Verdana Bold-11px-wheel
&var-cip-font-mono-rounded: verdana-11px-mono-rounded
&var-cip-font-rounded-lowspace: verdana-11px-rounded-lowspace
GiftWindow < NewMainWindow
  id: countWithdraw
  !text: tr('Gift Coins')
  size: 279 238

  Panel
    id: contentPanel
    anchors.fill: parent
    margin: 15 12 12 14
    SpinBox
      id: spinBox
      anchors.left: parent.left
      anchors.top: parent.top
      width: 1
      height: 1
      phantom: true
      margin-top: 2
      focusable: false

    UIWidget
      id: information
      size: 225 122
      padding-left: 4
      anchors.top: parent.top
      anchors.left: parent.left
      image-source: /images/store/labels/transfer-label

    TextEdit
      id: nameText
      size: 150 16
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 61
      margin-left: 97
      @onTextChange: modules.game_store.onRecipientTextChange(self)
      focusable: true
    Label
      anchors.top: prev.bottom
      anchors.left: parent.left
      !text: tr('Transferable Coins:')
      font: $var-cip-font
      color: $var-text-cip-color
      text-auto-resize: true
      margin-top: 10
    Label
      id: totalAmount
      anchors.top: nameText.bottom
      anchors.left: prev.right
      !text: tr('0')
      margin-top: 10
      margin-left: 6
      font: $var-cip-font
      color: $var-text-cip-color
      text-auto-resize: true
    UIWidget
      size: 12 12
      image-border: 0
      image-source: /images/store/icon-tibiacointransferable
      anchors.top: prev.top
      anchors.left: prev.right
      margin-top: 1
      margin-left: 7
    Label
      id: currentAmount
      anchors.top: totalAmount.bottom
      anchors.left: parent.left
      !text: tr('0')
      margin-top: 8
      margin-left: 101
      font: $var-cip-font
      color: $var-text-cip-color
      text-auto-resize: true
    UIWidget
      size: 12 12
      image-border: 0
      image-source: /images/store/icon-tibiacointransferable
      anchors.top: prev.top
      anchors.left: prev.right
      margin-top: 1
      margin-left: 7

    HorizontalScrollBar
      id: countScrollBar
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-top: 16
      focusable: false
      default-scroll: true
      increment: 25
      ctrl-increment: 2500
      shift-increment: 250
      auto-press-delay: 60

    HorizontalSeparator
      id: separator
      anchors.bottom: next.top
      anchors.right: parent.right
      anchors.left: parent.left
      margin-bottom: 10

    Button
      id: buttonCancel
      !text: tr('Cancel')
      height: 20
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      focusable: false

    Button
      id: buttonOk
      !text: tr('Gift')
      height: 20
      anchors.bottom: parent.bottom
      anchors.right: prev.left
      margin-right: 10
      focusable: false
      enabled: false
