&var-text-color: #dfdfdf
&var-text-cip-color-white: #f7f7f7
&var-text-cip-color-highlight: #f4f4f4
&var-text-cip-color-grey: #909090
&var-text-cip-color: #c0c0c0
&var-cip-inactive-color: #707070
&var-text-cip-color-green: #44ad25
&var-text-color-disabled: #dfdfdf88
&var-text-cip-color-orange: #ff9854
&var-text-cip-color-yellow: #ffda34
&var-text-cip-color-light-red: #f75f5f
&var-text-cip-color-blue: #1872c3
&var-text-cip-color-green-disabled: #255f15
&var-text-cip-store-disabled: #565656
&var-text-cip-store-red: #D33C3C
&var-text-cip-store-red-disabled: #6d2626
&var-text-cip-store-sale: #ffda34
&var-text-cip-store-sale-disabled: #6f5f18
&var-text-cip-store-timed: #1872c3
&var-text-cip-store-timed-disabled: #183f63
&var-textlist-selected: #585858
&var-textlist-even: #414141
&var-textlist-odd: #484848
&var-main-font: verdana-11px-antialised
&var-cip-main-font: Verdana Bold-11px
&var-cip-font: verdana-11px-antialised
&var-cip-font-off: verdana-11px-antialised
&var-cip-font-wheel: Verdana Bold-11px-wheel
&var-cip-font-mono-rounded: verdana-11px-mono-rounded
&var-cip-font-rounded-lowspace: verdana-11px-rounded-lowspace
BuyOfferWindow < NewMainWindow
  size: 380 235
  !text: tr('Confirmation of Purchase')
  @onEscape: modules.game_store.onBuyOffer(self, 0, 0, 'cancelButton')

  Label
    id: productWarning
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 11
    margin-left: 11
    margin-right: 12
    !text: tr('Do you want to buy the product?')
    font: $var-cip-font
    color: $var-text-cip-color
    text-auto-resize: true
    text-wrap: true

  FlatPanel
    id: icon
    anchors.top: productWarning.bottom
    anchors.left: parent.left
    margin-top: 8
    margin-left: 12
    size: 80 80
    image-source: /images/ui/scrollarea

    UICreature
      id: creature
      size: 64 64
      anchors.verticalCenter: parent.verticalCenter
      anchors.horizontalCenter: parent.horizontalCenter
      creature-size: 64
      creature-center: true
      animate: true
    UIItem
      id: item
      size: 64 64
      anchors.verticalCenter: parent.verticalCenter
      anchors.horizontalCenter: parent.horizontalCenter
      animate: true
      virtual: true
      &drawRarity: false
    UIWidget
      id: image
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter
      size: 64 64
      virtual: true
      image-fixed-ratio: true

  FlatPanel
    id: description
    anchors.top: productWarning.bottom
    anchors.left: prev.right
    anchors.right: parent.right
    margin-top: 8
    margin-left: 10
    margin-right: 13
    image-source: /images/ui/scrollarea
    size: 260 80
    font: $var-cip-font
    color: $var-text-cip-color

    Label
      id: offerName
      width: 235
      anchors.top: parent.top
      anchors.left: parent.left
      margin-left: 10
      margin-top: 23
      !text: tr('ok')
      font: $var-cip-font
      color: $var-text-cip-color
      text-wrap: true
    Label
      id: offerPrice
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 5
      margin-left: 10
      font: $var-cip-font
      color: $var-text-cip-color
      text-auto-resize: true
      !text: tr('Price: 100')
    UIWidget
      id: coinType
      size: 12 12
      image-border: 0
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 5
      margin-top: 2
      image-source: /images/store/icon-tibiacointransferable

  Button
    id: cancelButton
    size: 43 20
    margin-right: 12
    margin-bottom: 12
    !text: tr('Cancel')
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: modules.game_store.onBuyOffer(self)

  Button
    id: okBuyButton
    size: 43 20
    margin-right: 5
    margin-bottom: 12
    anchors.right: prev.left
    anchors.bottom: parent.bottom
    image-source: /images/store/small-buybutton
    image-clip: 0 0 43 20
    $hover:
      image-clip: 0 0 43 20
    $pressed:
      image-clip: 0 20 43 20

  HorizontalSeparator
    id: separator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: okBuyButton.top
    margin-bottom: 10
    margin-left: 12
    margin-right: 12

  FlatLabel
    id: buttonAdvanced
    anchors.bottom: separator.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-right: 12
    margin-bottom: 12
    margin-left: 12
    size: 348 22
    CheckBox
      id: storeAskBeforeBuyingProducts
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6
      margin-top: 1
      !text: tr('Do not show this dialog again!')
      text-auto-resize: true
      font: $var-cip-font
      color: $var-text-cip-color
      text-offset: 18 -2
      @onCheckChange: |
        -- Checked = "Do not show again" => disable ask-before-buy.
        modules.client_options.setOption('storeAskBeforeBuyingProducts', not self:isChecked())

      $!enabled:
        color: $var-text-cip-color-grey
