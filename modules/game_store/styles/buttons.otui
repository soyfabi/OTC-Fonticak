&var-text-color: #dfdfdf
&var-text-cip-color-white: #f7f7f7
&var-text-cip-color-highlight: #f4f4f4
&var-text-cip-color-grey: #909090
&var-text-cip-color: #c0c0c0
&var-cip-inactive-color: #707070
&var-text-cip-color-green: #44ad25
&var-text-color-disabled: #dfdfdf88
&var-text-cip-color-orange: #ff9854
&var-text-cip-color-yellow: #ffda34
&var-text-cip-color-light-red: #f75f5f
&var-text-cip-color-blue: #1872c3
&var-text-cip-color-green-disabled: #255f15
&var-text-cip-store-disabled: #565656
&var-text-cip-store-red: #D33C3C
&var-text-cip-store-red-disabled: #6d2626
&var-text-cip-store-sale: #ffda34
&var-text-cip-store-sale-disabled: #6f5f18
&var-text-cip-store-timed: #1872c3
&var-text-cip-store-timed-disabled: #183f63
&var-textlist-selected: #585858
&var-textlist-even: #414141
&var-textlist-odd: #484848
&var-main-font: verdana-11px-antialised
&var-cip-main-font: Verdana Bold-11px
&var-cip-font: verdana-11px-antialised
&var-cip-font-off: verdana-11px-antialised
&var-cip-font-wheel: Verdana Bold-11px-wheel
&var-cip-font-mono-rounded: verdana-11px-mono-rounded
&var-cip-font-rounded-lowspace: verdana-11px-rounded-lowspace
TreeItem < UIWidget
  height: 20
  anchors.top: parent.bottom
  anchors.left: parent.left
  anchors.right: parent.right
  margin-left: 5
  margin-right: 5
  margin-top: 12
  draggable: false
  // Do not clip the TreeItem itself: mainButton/icon overflow above height 20 on purpose.
  // Accordion slide enables clipping only while animating (see Categories.lua).
  Button
    id: mainButton
    image-color: #FFFFFF
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    size: 170 24
    margin-top: -5
    margin-left: 2
    image-source: /images/store/categorie-up
    image-clip: 0 0 166 22
    image-border: 4
    $hover:
      image-clip: 0 0 166 22
    $pressed:
      image-source: /images/store/categorie-down
      image-clip: 0 0 166 22
    UIWidget
      id: icon
      size: 13 13
      anchors.top: parent.top
      anchors.left: parent.left
      margin-left: -3
      margin-top: -6
    Label
      id: text
      anchors.top: parent.top
      anchors.left: icon.right
      margin-left: 5
      margin-top: -6
      font: $var-cip-font
      color: $var-text-cip-color
    UIWidget
      id: scroll
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: -2
      margin-right: 2
      visible: false
      image-source: /images/arrows/icon-arrow7x7-right
  FlatPanel
    id: panel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 20
    margin-left: 3
    margin-right: 2
    image-source: /images/store/arrow-panel
    visible: false
    clipping: true
  UIWidget
    id: arrow
    size: 4 7
    image-source: /images/store/arrow
    anchors.top: panel.top
    anchors.left: parent.left
    margin-top: 2
    margin-left: 7
    visible: false

  $first:
    anchors.top: parent.top
  $!first:
    anchors.top: prev.bottom

TreeButton < Button
  size: 152 20
  anchors.top: parent.top
  anchors.left: parent.left
  anchors.right: parent.right
  margin-left: 12
  margin-top: 2
  padding: 0
  image-border: 0
  image-source: /images/store/subcategory
  image-clip: 0 0 152 20
  $hover !pressed !on:
    image-clip: 0 0 152 20
  $pressed:
    image-clip: 0 20 152 20
  $on:
    image-clip: 0 20 152 20
  UIWidget
    id: icon
    size: 13 13
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: parent.left
    margin-left: 8
    margin-top: 0
  Label
    id: text
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: icon.right
    margin-left: 5
    margin-top: 0
    font: $var-cip-font
    color: $var-text-cip-color
  $first:
    anchors.top: parent.top
  $!first:
    anchors.top: prev.bottom

// Offer buyable
ImageOffer < UIWidget
  size: 240 82
  image-source: /images/store/store-offer-box
  image-clip: 0 0 240 82
  UIWidget
    id: image
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 10
    margin-left: 10
    size: 64 64
    phantom: true
    image-auto-resize: false
    image-fixed-ratio: true
  UIWidget
    id: grayHover
    background-color: black
    opacity: 0.3
    anchors.fill: parent
    phantom: true
    visible: false
    margin: 2
  Label
    id: name
    width: 140
    height: 45
    text-wrap: true
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 80
    margin-top: 8
    color: $var-text-cip-color
    font: $var-cip-font
    text-auto-resize: true
  Label
    id: count1
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    text-auto-resize: true
    text-align: right
    font: $var-cip-font
    color: $var-text-cip-color
    margin-bottom: 8
    margin-right: 110
  Label
    id: price1
    !text: tr('0')
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-bottom: 8
    margin-right: 24
    font: $var-cip-font
    color: $var-text-cip-color
    text-auto-resize: true
  UIWidget
    id: coin1
    size: 12 12
    image-border: 0
    image-source: /images/store/icon-tibiacoin
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-bottom: 9
    margin-right: 8
  UIWidget
    id: priceOff
    !text: tr('2,000')
    anchors.bottom: parent.bottom
    anchors.right: price1.left
    margin-bottom: 8
    margin-right: 3
    font: $var-cip-font-off
    color: $var-cip-inactive-color
    text-auto-resize: true
    visible: false
  Label
    id: price2
    size: 80 20
    !text: tr('0')
    color: $var-text-cip-color
    font: $var-cip-font
    text-align: right
    anchors.bottom: price1.top
    anchors.right: parent.right
    margin-bottom: 6
    margin-right: 24
    visible: false
  UIWidget
    id: coin2
    size: 12 12
    image-border: 0
    image-source: /images/store/icon-tibiacoin
    anchors.bottom: price2.bottom
    anchors.right: parent.right
    margin-bottom: 4
    margin-right: 8
    visible: false
  Label
    id: count2
    anchors.bottom: count1.bottom
    anchors.right: parent.right
    text-auto-resize: true
    text-align: right
    font: $var-cip-font
    color: $var-text-cip-color
    margin-bottom: 22
    margin-right: 110
    visible: false
  UIWidget
    id: flag
    size: 28 28
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-bottom: 2
    margin-left: 2
    image-source: /images/store/store-flag-new
    phantom: true
    visible: false

