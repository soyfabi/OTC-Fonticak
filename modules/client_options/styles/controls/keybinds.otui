OptionContainer < FlatPanel
  height: 22
  padding: 3

KeybindsPrimaryKeyColumnCell < UIWidget
  focusable: false
  height: 18
  margin-top: 1
  margin-bottom: 1
  background-color: #363636
  border-width: 1
  border-color: #272727
  change-cursor-image: true

  Label
    id: value
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin-right: 2
    color: #c0c0c0
    text-align: left
    text-offset: 2 0
    font: verdana-11px-monochrome
    phantom: true

KeybindsSecondaryKeyColumnCell < UIWidget
  focusable: false
  height: 18
  margin-top: 1
  margin-bottom: 1
  background-color: #363636
  border-width: 1
  border-color: #272727
  change-cursor-image: true

  Label
    id: value
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin-right: 2
    color: #c0c0c0
    text-align: left
    text-offset: 2 0
    font: verdana-11px-monochrome
    phantom: true

KeybindsHotkeyRow < UIWidget
  focusable: true
  height: 20
  background-color: alpha
  even-background-color: alpha
  odd-background-color: #484848

  $focus:
    background-color: #585858

  Label
    id: actionName
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    width: 286
    color: #c0c0c0
    text-align: left
    focusable: false
    text-offset: 18 0
    font: verdana-11px-monochrome

  VerticalSeparator
    id: separatorPrimary
    anchors.left: actionName.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom

  KeybindsPrimaryKeyColumnCell
    id: primaryCol
    anchors.left: separatorPrimary.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    width: 100

  VerticalSeparator
    id: separatorSecondary
    anchors.left: primaryCol.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom

  KeybindsSecondaryKeyColumnCell
    id: secondaryCol
    anchors.left: separatorSecondary.right
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom

KeybindsCategoryHeader < UIButton
  height: 20
  margin-top: 1
  background-color: alpha
  focusable: false

  $hover:
    background-color: #484848

  $pressed:
    background-color: #585858

  UIWidget
    id: indicator
    size: 7 7
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    image-source: /images/arrows/icon-arrow7x7-down
    focusable: false
    phantom: true

  Label
    id: title
    anchors.left: indicator.right
    margin-left: 4
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    font: verdana-11px-monochrome
    color: #8cb4d9
    text-align: left
    focusable: false
    phantom: true

KeybindsCategorySection < UIWidget
  layout:
    type: verticalBox

  KeybindsCategoryHeader
    id: header

  Panel
    id: rowsPanel
    layout:
      type: verticalBox

KeybindsListHeader < Panel
  height: 18

  Label
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    width: 286
    font: verdana-11px-monochrome
    text-offset: 2 0
    text-align: left
    color: #c0c0c0
    !text: tr('Function')

  VerticalSeparator
    id: headerSeparatorPrimary
    anchors.left: prev.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom

  Label
    anchors.left: headerSeparatorPrimary.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    width: 100
    font: verdana-11px-monochrome
    text-offset: 2 0
    text-align: left
    color: #c0c0c0
    !text: tr('Primary Key')

  VerticalSeparator
    id: headerSeparatorSecondary
    anchors.left: prev.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom

  Label
    anchors.left: headerSeparatorSecondary.right
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    font: verdana-11px-monochrome
    text-offset: 2 0
    text-align: left
    color: #c0c0c0
    !text: tr('Secondary Key')

KeybindsTreeHelpDemoLine < Label
  height: 16
  font: verdana-11px-monochrome
  color: #c0c0c0
  text-align: left
  focusable: false
  phantom: true

KeybindsTreeHelpDemoCategory < Label
  height: 18
  font: verdana-11px-monochrome
  color: #8cb4d9
  text-align: left
  focusable: false
  phantom: true

KeybindsTreeHelpSection < UIWidget
  layout:
    type: verticalBox
  height: 128
  margin-top: 8
  margin-left: 2
  margin-right: 2
  focusable: false

  HorizontalSeparator
    margin-top: 4
    margin-bottom: 6

  Label
    id: helpIntro
    height: 28
    font: verdana-11px-monochrome
    color: #c0c0c0
    text-align: left
    text-wrap: true
    focusable: false
    phantom: true
    !text: tr('Clicking the category header toggles the category:')

  Panel
    id: helpColumns
    layout:
      type: horizontalBox
      spacing: 8
    height: 92

    Panel
      id: helpExpanded
      width: 248
      layout:
        type: verticalBox

      Label
        id: expandedCaption
        height: 16
        font: verdana-11px-monochrome
        color: #a0a0a0
        text-align: left
        focusable: false
        phantom: true
        !text: tr('Expanded:')

      KeybindsTreeHelpDemoCategory
        id: expandedCategory
        text-offset: 0 0
        !text: tr('- Windows')

      KeybindsTreeHelpDemoLine
        text-offset: 18 0
        !text: tr('Bestiary Tracker')

      KeybindsTreeHelpDemoLine
        text-offset: 18 0
        !text: tr('Battle List')

      KeybindsTreeHelpDemoLine
        text-offset: 18 0
        !text: tr('VIP List')

    Panel
      id: helpCollapsed
      width: 248
      layout:
        type: verticalBox

      Label
        id: collapsedCaption
        height: 16
        font: verdana-11px-monochrome
        color: #a0a0a0
        text-align: left
        focusable: false
        phantom: true
        !text: tr('Collapsed:')

      KeybindsTreeHelpDemoCategory
        id: collapsedCategory
        text-offset: 0 0
        !text: tr('> Windows')

UIWidget
  anchors.fill: parent
  visible: false
  Panel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    id: presets
    height: 20
    layout:
      type: horizontalBox
      spacing: 5

    OptionsComboBox
      id: list
      width: 320

    SmallButton
      id: add
      width: 30
      !text: tr("Add")
      @onClick: addNewPreset()

    SmallButton
      id: copy
      width: 35
      !text: tr("Copy")
      @onClick: copyPreset()

    SmallButton
      id: rename
      width: 45
      !text: tr("Rename")
      @onClick : renamePreset()

    SmallButton
      id: remove
      width: 45
      !text: tr("Remove")
      @onClick : removePreset()
  
  SmallReversedQtPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    height: 22
    margin-top: 7
    
    OptionCheckBoxMarked
      id: autoSwitchPreset
      !text: tr('Auto-Switch Hotkey Preset')
      !tooltip: tr('Automatically activates a preset on login. A preset matching\nthe character name takes priority; otherwise, a preset matching the\ncharacter vocation (Druid, Knight, Paladin, Sorcerer or Monk) is used.')

  SmallReversedQtPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    height: 24
    margin-top: 7
    id: panel

    OptionContainer
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      height: 16
      padding: 0
      image-source: ""
      !tooltip: tr('There are two chat modes for each hotkey preset: Chat On and Chat\n Off.You can find a small button that tells you which chat mode is\n currently active on the right side of the entry line of the chat console.Press this button to switch between the two chat modes.\nOf course, you can also set a hotkey to toggle between Chat On and Off.\n- Chat On\nIn this mode, you will be able to write text in the entry line of the chat console.\nHowever, if you have assigned an action to a letter key, the action will be triggered.\n- Chat On*\nThis is the temporary Chat On mode.\nIn the default hotkey preset, the Return key switches between Chat Off and this mode.\nIf the chat mode is off and you press this hotkey, it temporarily activates the chat mode so that you can write one message in the console.\nAs soon as you press Return to send the message, your chat mode will be set to Chat Off again so that you can continue walking with WASD, for example.\n- Chat Off\nIn this mode, you will not be able to write any text in the entry line of the console, but you can use your predefined hotkeys to walk or cast spells, for example.\nYou can assign functions to all keys of your keyboard, e.g. walk with WASD.')

      id: chatMode
      $!first:
        margin-left: 40

      CheckBoxCircle
        id: on
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        text-horizontal-auto-resize: true
        !text: tr("Chat Mode On")
        text-offset: 20 -1

      CheckBoxCircle
        id: off
        anchors.left: on.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 127
        text-horizontal-auto-resize: true
        !text: tr("Chat Mode Off")
        text-offset: 20 -1
        $mobile:
          margin-left: -120

    UIWidget
      id: toolTipWidget
      image-source: /images/icons/show_gui_help_grey
      size: 12 12  
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 3
      !tooltip: tr('There are two chat modes for each hotkey preset: Chat On and Chat \nOff. You can find a small button that tells you which chat mode is \ncurrently active on the right side of the entry line of the chat \nconsole. Press this button to switch between the two chat modes. Of \ncourse, you can also set a hotkey to toggle between Chat On and Off.\n\tChat On\n\t\tIn this mode, you will be able to write text in the entry line of\n the chat console. However, if you have assigned an action to \na letter key, the action will be \t\ttriggered.\n\n\n\tChat On\n\t\tThis is the temporary Chat On mode. In the default hotkey \npreset, the Return key switches between Chat Off and this\n mode. If the chat mode is off and you press \t\tthis hotkey, it \ntemporarily activates the chat mode so that you can write \none message in the console. As soon as you press Return to \nsend the message, your chat \t\tmode will be set to \nChat Off again so that you can continue walking with WASD, for\n example.\n\n\tChat Off\n\t\tIn this mode, you will not be able to write any text in the entry line of the\n console, but you can use your predefined\n hotkeys to walk or cast spells, for \t\texample. You can assign\n functions to all keys of your keyboard, e.g. walk with WASD')
     
  Panel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    id: search
    height: 20
    margin-top: 7
    
    Label
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      font: verdana-11px-monochrome
      !text: tr('Type to search for a hotkey:')
    
    TextEdit
      id: field
      anchors.left: prev.right
      anchors.right: clear.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6
      margin-right: 4
      @onTextChange: searchActions()
      $mobile:
        width: 140

    UIButton
      id: clear
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      image-source: /images/ui/button-clear-18x18-up
      image-clip: 0 0 20 20
      width: 20

      $pressed:
        image-source: /images/ui/button-clear-18x18-down
      @onClick : self:getParent().field:clearText()

  Panel
    id: tablePanel
    focusable: true
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    height: 305
    margin-top: 5
    image-source: /images/ui/1pixel_down_frame
    image-border: 1
    background: #404040

    KeybindsListHeader
      id: listHeader
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: scrollBar.left
      margin: 1 0 0 1
      background: #363636

    Label
      id: overwriteNotice
      anchors.top: listHeader.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 0
      margin: 0 15 0 1
      font: verdana-11px-monochrome
      color: #f0c040
      text-align: center
      focusable: false
      phantom: true
      visible: false

    UIWidget
      id: overwriteNoticeIcon
      size: 12 12
      anchors.top: listHeader.bottom
      anchors.left: parent.left
      margin-top: 4
      margin-left: 0
      image-source: /images/ui/hotkey-conflict-warning
      focusable: false
      phantom: true
      visible: false

    UIScrollArea
      id: keybindsScroll
      anchors.top: listHeader.bottom
      anchors.left: parent.left
      anchors.right: scrollBar.left
      anchors.bottom: parent.bottom
      margin: 0 0 1 1
      padding-bottom: 1
      vertical-scrollbar: scrollBar
      layout:
        type: verticalBox

    VerticalQtScrollBar
      id: scrollBar
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      step: 16
      pixels-scroll: true
  
  Panel
    id: buttons
    height: 20
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom

    OptionsQtButton
      id: reset
      !text: tr('Reset')
      !tooltip: tr('Reset all General Hotkeys of the current preset to their default keys.')
      @onClick: resetActions()
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 8
      size: 80 20
