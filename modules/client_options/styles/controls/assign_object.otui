CustomObjectWindow < NewMainWindow
  id: customAssignItemWindow
  size: 275 210
  font: verdana-11px-antialised
  color: #ffffff

  Panel
    id: contentPanel
    anchors.fill: parent
    margin: 12 12 12 12

    UIItem
      id: item
      size: 64 64
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 8
      margin-left: 11
      padding: 1
      image-source: /images/ui/item/none
      &selectable: true
      &editable: false
      priceable: false
      virtual: true

    UIWidget
      id: tier
      size: 18 16
      anchors.top: prev.top
      anchors.right: prev.right
      image-source: /images/game/items/tiers-strip-big
      image-clip: 0 0 18 16
      visible: false

    Panel
      id: checks
      width: 155
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-left: 92
      margin-top: 2
      layout:
        type: verticalBox
        fit-children: true

      RoundCheckBox
        id: UseOnYourself
        text: Use on yourself
        enabled: false
        margin-top: 0

      RoundCheckBox
        id: UseOnTarget
        text: Use on target
        enabled: false

      RoundCheckBox
        id: UseAtCursorPosition
        text: Use on cursor location
        enabled: false

      RoundCheckBox
        id: SelectUseTarget
        text: With crosshair
        enabled: false

      RoundCheckBox
        id: Equip
        text: Equip/Unequip
        enabled: false

      SmartMode
        id: smart
        visible: false

      RoundCheckBox
        id: Use
        text: Use
        enabled: false

    ObjectAssignButton
      id: select
      size: 86 20
      anchors.top: item.bottom
      anchors.left: parent.left
      margin-top: 10
      text: Select Object

    HorizontalSeparator
      anchors.top: select.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 10

    ObjectAssignButton
      id: buttonClose
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      size: 43 20
      text: Cancel

    ObjectAssignButton
      id: buttonApply
      anchors.right: buttonClose.left
      anchors.bottom: parent.bottom
      margin-right: 6
      size: 43 20
      text: Apply

    ObjectAssignButton
      id: buttonOk
      anchors.right: buttonApply.left
      anchors.bottom: parent.bottom
      margin-right: 6
      size: 43 20
      text: Ok
