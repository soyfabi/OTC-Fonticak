UIWidget
  anchors.fill: parent
  visible: false

  SmallReversedQtPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    height: 22

    OptionCheckBoxMarked
      id: disableMinimapAnimations
      !text: tr('Disable Animations')
      !tooltip: tr('Pause water, animated objects, and pulsing player markers in the minimap and Cyclopedia.')

  SmallReversedQtPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 7
    height: 22

    OptionCheckBoxMarked
      id: disableMinimapHd
      !text: tr('Disable HD 3D Map')
      !tooltip: tr('Use the classic map in the minimap and Cyclopedia.')

  SmallReversedQtPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 7
    height: 22

    OptionCheckBoxMarked
      id: disableMinimapFloorItems
      !text: tr('Disable Items Floor')
      !tooltip: tr('Hide items that can be picked up from the floor on the HD minimap and Cyclopedia.')

  SmallReversedQtPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 7
    height: 22

    OptionCheckBoxMarked
      id: disableMinimapSmoothZoom
      !text: tr('Disable Smooth Zoom')
      !tooltip: tr('Switch zoom levels instantly in the minimap and Cyclopedia.')

  SmallReversedQtPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 7
    height: 22

    OptionCheckBoxMarked
      id: showNearbyMinimapPlayers
      !text: tr('Show Nearby Players')
      !tooltip: tr('Mark nearby players when the minimap or Cyclopedia is zoomed in. Hover over a marker to see the player name.')

  SmallReversedQtPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 7
    height: 22

    OptionsLabel
      id: nearbyMinimapPlayerLimit
      anchors.fill: parent
      text-align: left
      text-offset: 18 0

      HorizontalQtScrollBar
        id: valueBar
        minimum: 2
        maximum: 40
        step: 1
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 3
        width: 174
        @onValueChange: modules.client_options.setOption(self:getParent():getId(), self:getValue())

  OptionsQtButton
    id: downloadHdMap
    anchors.left: parent.left
    anchors.top: prev.bottom
    margin-top: 9
    width: 160
    visible: false
    !text: tr('Download Map HD')
    !tooltip: tr('Download the static HD map for the minimap and Cyclopedia.')
    @onClick: modules.client_options.toggleMinimapPackDownload(false)

  OptionsLabel
    id: hdDownloadStatus
    anchors.left: downloadHdMap.right
    anchors.verticalCenter: downloadHdMap.verticalCenter
    margin-left: 8
    width: 155
    text-align: left
    visible: false

  OptionsQtButton
    id: uninstallHdMap
    anchors.right: parent.right
    anchors.verticalCenter: downloadHdMap.verticalCenter
    width: 88
    visible: false
    !text: tr('Uninstall')
    @onClick: modules.client_options.confirmMinimapPackUninstall(false)

  OptionsQtButton
    id: downloadAnimationMap
    anchors.left: parent.left
    anchors.top: downloadHdMap.bottom
    margin-top: 5
    width: 160
    visible: false
    !text: tr('Download Animation Map')
    !tooltip: tr('Download animations for the static HD map. The same pack is used by the minimap and Cyclopedia.')
    @onClick: modules.client_options.toggleMinimapPackDownload(true)

  OptionsLabel
    id: animationDownloadStatus
    anchors.left: downloadAnimationMap.right
    anchors.verticalCenter: downloadAnimationMap.verticalCenter
    margin-left: 8
    width: 155
    text-align: left
    visible: false

  OptionsQtButton
    id: uninstallAnimationMap
    anchors.right: parent.right
    anchors.verticalCenter: downloadAnimationMap.verticalCenter
    width: 88
    visible: false
    !text: tr('Uninstall')
    @onClick: modules.client_options.confirmMinimapPackUninstall(true)
