UIWidget
  anchors.fill: parent
  visible: false

  ScrollablePanel
    id: animationScroll
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: resetAnimationButton.top
    margin-top: 2
    margin-bottom: 6
    margin-right: 14
    vertical-scrollbar: animationScrollBar

    Panel
      id: animationInner
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      height: 690

      QtPanel
        id: animationBarsPanel
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top
        height: 265

        Panel
          id: animationBarsColumn
          anchors.fill: parent
          margin-left: 2
          margin-right: 2
          margin-top: 2
          margin-bottom: 6

          SmallReversedQtPanel
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: parent.top
            height: 22

            OptionCheckBoxMarked
              id: showAnimationMaster
              !text: tr('Show Animation Master')
              !tooltip: tr('Master switch for UI bar animations (skills, health, mana, arcs).\nDoes not affect Show Spell Animation or Show Outfit Master.')

          SmallReversedQtPanel
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: prev.bottom
            margin-top: 4
            margin-left: 16
            height: 22

            OptionCheckBoxMarked
              id: showAnimationSkillBar
              !text: tr('Show Animation Skill Bar')
              !tooltip: tr('Smooth ease-out fill for Magic Level and fighting skill\npercent bars (Skills window and Status Bars).')

          SmallReversedQtPanel
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: prev.bottom
            margin-top: 4
            margin-left: 16
            height: 22

            OptionCheckBoxMarked
              id: showAnimationLevelBar
              !text: tr('Show Animation Level Bar')
              !tooltip: tr('Smooth ease-out fill for the Level / experience percent bar\n(Skills window and Status Bars).')

          SmallReversedQtPanel
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: prev.bottom
            margin-top: 4
            margin-left: 16
            height: 22

            OptionCheckBoxMarked
              id: showAnimationHealthBar
              !text: tr('Show Animation Health Bar')
              !tooltip: tr('Smooth ease-out for the side-panel health bar.')

          SmallReversedQtPanel
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: prev.bottom
            margin-top: 4
            margin-left: 16
            height: 22

            OptionCheckBoxMarked
              id: showAnimationManaBar
              !text: tr('Show Animation Mana Bar')
              !tooltip: tr('Smooth ease-out for the side-panel mana bar.')

          SmallReversedQtPanel
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: prev.bottom
            margin-top: 4
            margin-left: 16
            height: 22

            OptionCheckBoxMarked
              id: showAnimationHudHealthBar
              !text: tr('Show Animation HUD Health Bar')
              !tooltip: tr('Smooth ease-out for health on Customisable Status Bars\n(top/bottom HUD) and the nameplate bar above your character.')

          SmallReversedQtPanel
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: prev.bottom
            margin-top: 4
            margin-left: 16
            height: 22

            OptionCheckBoxMarked
              id: showAnimationHudManaBar
              !text: tr('Show Animation HUD Mana Bar')
              !tooltip: tr('Smooth ease-out for mana on Customisable Status Bars\n(top/bottom HUD) and the nameplate bar above your character.')

          SmallReversedQtPanel
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: prev.bottom
            margin-top: 4
            margin-left: 16
            height: 22

            OptionCheckBoxMarked
              id: showAnimationArcs
              !text: tr('Show Animation Arcs')
              !tooltip: tr('Smooth ease-out for health, mana, experience and skill\narcs around the game window.')

          SmallReversedQtPanel
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: prev.bottom
            margin-top: 4
            margin-left: 16
            height: 32

            OptionScaleScrollInline
              id: uiBarAnimationSpeed
              &minimumScrollValue: 50
              &maximumScrollValue: 200
              &scrollSize: 21
              @onSetup: |
                local value = modules.client_options.getOption('uiBarAnimationSpeed')
                self:setText(tr('Animation Speed: %s%%', value))

      QtPanel
        id: outfitAnimationPanel
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        height: 210
        margin-top: 7

        Panel
          id: outfitAnimationColumn
          anchors.fill: parent
          margin-left: 2
          margin-right: 2
          margin-top: 2
          margin-bottom: 6

          SmallReversedQtPanel
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: parent.top
            height: 22

            OptionCheckBoxMarked
              id: showOutfitAnimationMaster
              !text: tr('Show Outfit Master')
              !tooltip: tr('Master switch for outfit window preview animations\n(floor, outfit, addons, mount, familiar).')

          SmallReversedQtPanel
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: prev.bottom
            margin-top: 4
            margin-left: 16
            height: 22

            OptionCheckBoxMarked
              id: showOutfitAnimationFloor
              !text: tr('Show Animation Floor')
              !tooltip: tr('Smooth settle animation when toggling Show Floor\nin the outfit window.')

          SmallReversedQtPanel
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: prev.bottom
            margin-top: 4
            margin-left: 16
            height: 22

            OptionCheckBoxMarked
              id: showOutfitAnimationOutfit
              !text: tr('Show Animation Outfit')
              !tooltip: tr('Smooth settle animation when toggling Show Outfit\nin the outfit window.')

          SmallReversedQtPanel
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: prev.bottom
            margin-top: 4
            margin-left: 16
            height: 22

            OptionCheckBoxMarked
              id: showOutfitAnimationAddon
              !text: tr('Show Animation Addon')
              !tooltip: tr('Smooth settle animation when toggling Addon 1 or Addon 2\nin the outfit window.')

          SmallReversedQtPanel
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: prev.bottom
            margin-top: 4
            margin-left: 16
            height: 22

            OptionCheckBoxMarked
              id: showOutfitAnimationMount
              !text: tr('Show Animation Mount')
              !tooltip: tr('Smooth settle animation when toggling Mount\nin the outfit window.')

          SmallReversedQtPanel
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: prev.bottom
            margin-top: 4
            margin-left: 16
            height: 22

            OptionCheckBoxMarked
              id: showOutfitAnimationFamiliar
              !text: tr('Show Animation Familiar')
              !tooltip: tr('Smooth slide animation when toggling Show Familiar\nin the outfit window.')

          SmallReversedQtPanel
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: prev.bottom
            margin-top: 4
            margin-left: 16
            height: 32

            OptionScaleScrollInline
              id: outfitAnimationSpeed
              &minimumScrollValue: 50
              &maximumScrollValue: 200
              &scrollSize: 21
              @onSetup: |
                local value = modules.client_options.getOption('outfitAnimationSpeed')
                self:setText(tr('Animation Speed: %s%%', value))

      QtPanel
        id: slideAnimationPanel
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        height: 140
        margin-top: 7

        Panel
          id: slideAnimationColumn
          anchors.fill: parent
          margin-left: 2
          margin-right: 2
          margin-top: 2
          margin-bottom: 6

          SmallReversedQtPanel
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: parent.top
            height: 22

            OptionCheckBoxMarked
              id: showSlideAnimationMaster
              !text: tr('Show Slide Master')
              !tooltip: tr('Master switch for accordion slide animations\n(Options categories and Store panels).')

          SmallReversedQtPanel
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: prev.bottom
            margin-top: 4
            margin-left: 16
            height: 22

            OptionCheckBoxMarked
              id: showOptionsAnimation
              !text: tr('Show Options Animation')
              !tooltip: tr('Smooth accordion slide when expanding or collapsing\ncategories in the Options window.')

          SmallReversedQtPanel
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: prev.bottom
            margin-top: 4
            margin-left: 16
            height: 22

            OptionCheckBoxMarked
              id: showStoreAnimation
              !text: tr('Show Store Animation')
              !tooltip: tr('Smooth accordion slide when expanding or collapsing\ncategories in the Store window.')

          SmallReversedQtPanel
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: prev.bottom
            margin-top: 4
            margin-left: 16
            height: 32

            OptionScaleScrollInline
              id: slideAnimationSpeed
              &minimumScrollValue: 50
              &maximumScrollValue: 200
              &scrollSize: 21
              @onSetup: |
                local value = modules.client_options.getOption('slideAnimationSpeed')
                self:setText(tr('Animation Speed: %s%%', value))

      SmallReversedQtPanel
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 7
        height: 22

        OptionCheckBoxMarked
          id: showSpellAnimation
          !text: tr('Show Spell Animation')
          !tooltip: tr('When you unlock a spell by leveling up, play a short animation\nof the spell icon flying into an empty action bar slot.\nRequires Auto Assign Spell.\nIndependent from Animation Master, Outfit Master, Slide Master and Animation Speed.')

  VerticalScrollBar
    id: animationScrollBar
    anchors.top: animationScroll.top
    anchors.bottom: animationScroll.bottom
    anchors.right: parent.right
    step: 28
    pixels-scroll: true

  OptionsQtButton
    id: resetAnimationButton
    !text: tr('Reset')
    !tooltip: tr('Reset all Animation options to their default values.')
    @onClick: modules.client_options.resetAnimation()
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    size: 80 20
