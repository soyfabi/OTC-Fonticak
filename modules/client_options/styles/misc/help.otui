UIWidget
  anchors.fill: parent
  visible: false
  SmallReversedQtPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    height: 110

    OptionsQtButton
      id: clientHelpBtn
      !text: tr('Client Help')
      anchors.left: parent.left
      anchors.top: parent.top
      size: 130 20
      margin-bottom: 10
      margin-right: 10
      @onClick: |
        if modules.game_clienthelp then
          modules.game_clienthelp.toggleClientHelp()
        end

    UIWidget
      image-source: /images/icons/show_gui_help_grey
      size: 12 12
      anchors.right: parent.right
      anchors.verticalCenter: clientHelpBtn.verticalCenter
      margin-right: 5
      !tooltip: tr('Activate Client Help mode to learn what each interface element does.')

    OptionsQtButton
      !text: tr('Wiki')
      anchors.left: parent.left
      anchors.top: clientHelpBtn.bottom
      size: 130 20
      margin-top: 5
      margin-right: 10
      @onClick: g_platform.openUrl("https://github.com/mehah/otclient/wiki")

    OptionsQtButton
      !text: tr('Info')
      size: 130 20
      margin-top: 5
     
      anchors.top: prev.bottom
      anchors.left: parent.left

      @onClick: g_platform.openUrl("https://github.com/mehah/otclient/wiki")

  SmallReversedQtPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    height: 55
    margin-top: 5

    OptionsQtButton
      !text: tr('Clear Cache')
      size: 130 20
      margin-bottom: 10
      margin-right: 10
      anchors.left: parent.left
      anchors.top: parent.top
      @onClick: |
        g_settings.clear()
        controller:scheduleEvent(function()
          g_app.restart()
        end, 1000)
    OptionsQtButton
      !text: tr('Change language')
      size: 130 20
      margin-top: 5
      anchors.top: prev.bottom
      anchors.left: parent.left
      @onClick: |
        modules.client_locales.createWindow()
