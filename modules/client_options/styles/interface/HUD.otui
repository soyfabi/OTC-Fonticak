UIWidget
  anchors.fill: parent
  visible: false
  @onVisibilityChange: |
    if self:isVisible() then
      scheduleEvent(function()
        if self:isDestroyed() then return end
        local scroll = self:recursiveGetChildById('hudScrollBar')
        if scroll then
          scroll:setValue(0)
        end
      end, 1)
    end

  UIScrollArea
    id: hudScrollArea
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-right: 14
    margin-bottom: 28
    vertical-scrollbar: hudScrollBar

    QtPanel
      id: ownOtherPanel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      height: 190
      margin-top: 2

      Panel
        id: ownColumn
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        width: 230
        margin-left: 2
        margin-top: 2
        margin-bottom: 6

        SmallReversedQtPanel
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.top: parent.top
          height: 22

          OptionCheckBox
            id: ownHUDCharacter
            !text: tr('Show HUD for Own Character')

        SmallReversedQtPanel
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.top: prev.bottom
          margin-top: 4
          margin-left: 16
          height: 22

          OptionCheckBox
            id: showOwnBars
            !text: tr('Show Bars')

        SmallReversedQtPanel
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.top: prev.bottom
          margin-top: 4
          margin-left: 16
          height: 22

          OptionCheckBox
            id: showOwnName
            !text: tr('Show Name')

        SmallReversedQtPanel
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.top: prev.bottom
          margin-top: 4
          margin-left: 16
          height: 22

          OptionCheckBox
            id: showOwnHealth
            !text: tr('Show Health')

        SmallReversedQtPanel
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.top: prev.bottom
          margin-top: 4
          margin-left: 16
          height: 22

          OptionCheckBox
            id: showOwnMana
            !text: tr('Show Mana')

        SmallReversedQtPanel
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.top: prev.bottom
          margin-top: 4
          margin-left: 16
          height: 22

          OptionCheckBoxMarked
            id: displayHarmony
            !text: tr('Show Harmony')
            !tooltip: tr('Can be enabled only in version 15.00 or higher')

      VerticalSeparator
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.left: ownColumn.right
        margin-top: 6
        margin-bottom: 6
        margin-left: 4

      Panel
        id: otherColumn
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.left: prev.right
        anchors.right: parent.right
        margin-left: 6
        margin-top: 2
        margin-bottom: 6
        margin-right: 2

        SmallReversedQtPanel
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.top: parent.top
          height: 22

          OptionCheckBox
            id: otherHUDCreatures
            !text: tr('Show HUD for Other Creatures')

        SmallReversedQtPanel
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.top: prev.bottom
          margin-top: 4
          margin-left: 16
          height: 22

          OptionCheckBox
            id: displayNames
            !text: tr('Show Name')

        SmallReversedQtPanel
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.top: prev.bottom
          margin-top: 4
          margin-left: 16
          height: 22

          OptionCheckBox
            id: displayHealth
            !text: tr('Show Health')

    QtPanel
      id: arcsPanel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      height: 210
      margin-top: 7

      SmallReversedQtPanel
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top
        margin-top: 2
        height: 22

        OptionCheckBox
          id: showHealthManaCircle
          !text: tr('Show Health/Mana Arcs')
          !tooltip: tr('Enable both health and mana arcs around your character.')

      SmallReversedQtPanel
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 4
        margin-left: 16
        height: 22

        OptionCheckBox
          id: healthCheckBox
          !text: tr('Health')
          !tooltip: tr('Show health red circle.')
          anchors.left: parent.left
          anchors.right: parent.horizontalCenter
          anchors.top: parent.top
          margin-right: 4

        OptionCheckBox
          id: manaCheckBox
          !text: tr('Mana')
          !tooltip: tr('Show mana blue circle.')
          anchors.left: parent.horizontalCenter
          anchors.right: parent.right
          anchors.top: parent.top
          margin-left: 4

      SmallReversedQtPanel
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 4
        margin-left: 16
        height: 22

        OptionCheckBox
          id: experienceCheckBox
          !text: tr('Experience')
          !tooltip: tr('Show experience yellow circle.')
          anchors.left: parent.left
          anchors.right: parent.horizontalCenter
          anchors.top: parent.top
          margin-right: 4

        OptionCheckBox
          id: skillCheckBox
          !text: tr('Skill')
          !tooltip: tr('Show skill purple circle.')
          anchors.left: parent.horizontalCenter
          anchors.right: parent.right
          anchors.top: parent.top
          margin-left: 4

      SmallReversedQtPanel
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 4
        margin-left: 16
        height: 28

        OptionsLabel
          !text: tr('Skill')
          anchors.left: parent.left
          margin-left: 18
          anchors.verticalCenter: parent.verticalCenter
          color: #c0c0c0ff
          width: 36

        OptionsComboBox
          id: chooseSkillComboBox
          width: 120
          anchors.left: prev.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 4
          mouse-scroll: false
          @onTextChange: modules.game_healthcircle.setSkillType(self:getCurrentOption().data)

        OptionsLabel
          !text: tr('Size')
          anchors.left: prev.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 12
          color: #c0c0c0ff
          width: 32

        OptionsComboBox
          id: sizeBox
          width: 110
          anchors.left: prev.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 4
          mouse-scroll: false

      SmallReversedQtPanel
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 4
        margin-left: 16
        height: 22

        OptionScaleScroll
          id: distFromCenScrollbar
          !text: tr('Distance')
          !tooltip: tr('Set distance from center.')
          anchors.fill: parent
          &minimumScrollValue: 0
          &maximumScrollValue: 100

      SmallReversedQtPanel
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 4
        margin-left: 16
        height: 22

        OptionScaleScroll
          id: opacityScrollbar
          !text: tr('Opacity')
          !tooltip: tr('Set circle opacity.')
          anchors.fill: parent
          &minimumScrollValue: 0
          &maximumScrollValue: 100

      SmallReversedQtPanel
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 4
        margin-left: 16
        height: 28

        OptionsLabel
          !text: tr('Bars')
          anchors.left: parent.left
          margin-left: 18
          anchors.verticalCenter: parent.verticalCenter
          color: #c0c0c0ff
          width: 36

        OptionsComboBox
          id: chooseStatsBarPlacement
          width: 90
          anchors.left: prev.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 4
          mouse-scroll: false
          @onTextChange: modules.game_healthcircle.updateStatsBar()

        OptionsComboBox
          id: chooseStatsBarDimension
          width: 90
          anchors.left: prev.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 6
          mouse-scroll: false
          @onTextChange: modules.game_healthcircle.updateStatsBar()

    SmallReversedQtPanel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-top: 7
      height: 22

      $!mobile:
        height: 0
        margin-top: 0
        visible: false

      OptionCheckBox
        id: rightJoystick
        !text: tr('Joystick in RightPanel')

        $!mobile:
          visible: false

    SmallReversedQtPanel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      height: 22
      margin-top: 7
      OptionScaleScroll
        id: hudScale
        anchors.fill: parent
        &minimumScrollValue: 1
        &maximumScrollValue: 5
        &scrollSize: 21

    SmallReversedQtPanel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      height: 22
      margin-top: 7
      OptionScaleScroll
        id: creatureInformationScale
        anchors.fill: parent
        &minimumScrollValue: 1
        &maximumScrollValue: 9
        &scrollSize: 21

    SmallReversedQtPanel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-top: 7
      height: 22

      OptionScaleScroll
        id: staticTextScale
        anchors.fill: parent
        &minimumScrollValue: 1
        &maximumScrollValue: 9
        &scrollSize: 21

    SmallReversedQtPanel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-top: 7
      height: 22

      OptionScaleScroll
        id: animatedTextScale
        anchors.fill: parent
        &minimumScrollValue: 1
        &maximumScrollValue: 9
        &scrollSize: 21


    HorizontalSeparator
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 11
      margin-left: 5
      margin-right: 5



    OptionsLabel
      id: specialConditionLabel
      !text: tr('Special Conditions')
      text-auto-resize: true
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 5
      margin-left: 4



    OptionsLabel
      id: showInHudLabel
      anchors.top: prev.top
      anchors.left: specialConditionLabel.right
      margin-left: 123
      !text: tr('Show in HUD')
      text-auto-resize: true
      $mobile:
        margin-left: -5


    CheckBox
      id: hudMasterCheckBox
      size: 12 12
      anchors.bottom: prev.bottom
      anchors.left: prev.right
      margin-left: 8
      margin-bottom: 2
      image-source: /images/ui/checkbox
      image-clip: 0 0 12 12



    OptionsLabel
      id: showInBarLabel
      anchors.top: showInHudLabel.top
      anchors.left: prev.right
      margin-left: 16
      !text: tr('Show in Bar')
      text-auto-resize: true


    CheckBox
      id: barMasterCheckBox
      size: 12 12
      anchors.bottom: prev.bottom
      anchors.left: prev.right
      margin-left: 8
      margin-bottom: 2
      image-source: /images/ui/checkbox
      image-clip: 0 0 12 12


    TextList
      id: conditionsList
      size: 455 100
      anchors.left: parent.left
      anchors.top: specialConditionLabel.bottom
      margin-top: 5
      margin-left: 5
      vertical-scrollbar: conditionsListScrollBar

      $mobile:
        size: 270 100

    VerticalScrollBar
      id: conditionsListScrollBar
      anchors.top: prev.top
      anchors.right: prev.right
      anchors.bottom: prev.bottom
      margin-top: 1
      margin-bottom: 1
      margin-right: 1
      step: 16
      pixels-scroll: true


    UIButton
      id: upButton
      size: 20 20
      anchors.top: conditionsList.top
      anchors.right: parent.right
      margin-right: -2
      tooltip: Click to move the selected button up.
      image-source: /images/ui/buttons/automap-button-moveup-up
      $pressed:
        image-source: /images/ui/buttons/automap-button-moveup-down


    UIButton
      id: downButton
      size: 20 20
      anchors.top: prev.bottom
      anchors.right: parent.right
      margin-right: -2
      margin-top: 5
      tooltip: Click to move the selected button down.
      image-source: /images/ui/buttons/automap-button-movedown-up
      $pressed:
        image-source: /images/ui/buttons/automap-button-movedown-down



    SmallReversedQtPanel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: conditionsList.bottom
      margin-top: 7
      height: 22
      OptionScaleScroll
        id: conditionIconSize
        anchors.fill: parent
        &minimumScrollValue: 1
        &maximumScrollValue: 3
        &scrollSize: 21

    SmallReversedQtPanel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-top: 7
      height: 22
      OptionCheckBox
        id: showConditionInfo
        !text: tr('Show Condition Information')
        !tooltip: tr('When enabled, hovering a condition icon shows its description.\nWhen disabled, no tooltip is shown.')

    SmallReversedQtPanel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-top: 7
      height: 22
      OptionCheckBox
        id: showCustomisableStatusBars
        !text: tr('Show Customisable Status Bars')
        !tooltip: tr('Check this box to show the status bars for your character\'s most \nimportant attributes: their health and their mana. \nIf you have enabled this option and you right-click on the status \nbars field, a menu will open up which allows you to individualise \nyour status bars even further: \n* You can switch your status bars to one of the four sides \naround your game window. \n* You can display your status bars in different styles. \n* Additionally, you can decide to show the progress bars for \none, several or all of your skills or your experience level. If \nyou place your mouse pointer on one of the bars, a tooltip \nwill open up which shows your progress to the next skill or \nlevel in percent.')


    SmallReversedQtPanel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-top: 7
      height: 22
      OptionCheckBox
        id: showStatusBars
        !text: tr('Show Status Bars')
        !tooltip: tr('Check this box to show your character\'s status bars for mana and \nhealth in the sidebar.')

    SmallReversedQtPanel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-top: 7
      height: 22

      OptionCheckBox
        id: displayText
        !text: tr('Display text messages')

    SmallReversedQtPanel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-top: 7
      height: 22

      OptionCheckBoxMarked
        id: showPing
        !text: tr('Show connection ping')
        !tooltip: tr('Display connection speed to the server (milliseconds)')

    SmallReversedQtPanel
      id: showPingPositionPanel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-top: 7
      height: 22
      visible: false
      OptionScaleScroll
        id: showPingPosition
        anchors.fill: parent
        !text: tr('Position Show Ping: Top Left')
        &minimumScrollValue: 1
        &maximumScrollValue: 4
        &scrollSize: 21

  VerticalScrollBar
    id: hudScrollBar
    anchors.top: parent.top
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-bottom: 28
    step: 16
    pixels-scroll: true

  OptionsQtButton
    id: resetHUDButton
    !text: tr('Reset')
    !tooltip: tr('Reset all HUD options to their default values.')
    @onClick: modules.client_options.resetHUD()
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-right: 14
    margin-bottom: 2
    size: 80 20
