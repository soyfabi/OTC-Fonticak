      anchors.bottom: fullMap.top
      margin-bottom: 2
      size: 20 20
      @onClick: zoomIn()

      $hover !disabled:
        image-clip: 0 40 20 20

      $pressed !disabled:
        image-clip: 20 40 20 20

    Button
