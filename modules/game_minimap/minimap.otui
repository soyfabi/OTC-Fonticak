    UIWidget
      id: horizontalDragHandle
      anchors.top: minimapBorder.top
      anchors.left: minimapBorder.left
      image-source: /images/ui/miniborder-top-left
      image-smooth: false
      size: 14 14
      margin-top: 1
      margin-left: 1
      focusable: false
      phantom: false
      cursor: pointer
