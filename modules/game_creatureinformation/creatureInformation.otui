IconInformation < UIWidget
  anchors.top: prev.top
  anchors.left: prev.right
  margin-left: 3

HarmonySegment < UIWidget
  width: 7
  height: 4
  background-color: #404040
  $on:
    background-color: #FF9854

UIWidget
  id: creatureInformation
  size: 32 48
  !margin-left: math.floor(-32/ 1.5)
  !margin-top: math.floor(-32 / 2)

  UILabel
    id: name
    text-auto-resize: true
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.HorizontalCenter: parent.HorizontalCenter
    !font: g_gameConfig.getCreatureNameFontName()

  ProgressBar
    id: lifeBar
    width: 40
    height: 4
    image-draw-order: 2
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.HorizontalCenter: parent.HorizontalCenter

  ProgressBar
    id: manaBar
    visible: false
    background-color: blue
    width: 40
    height: 4
    margin-top: 2
    image-draw-order: 2
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.HorizontalCenter: parent.HorizontalCenter

  Panel
    id: harmonyBar
    visible: false
    width: 40
    height: 4
    margin-top: 2
    image-draw-order: 2
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    layout:
      type: horizontalBox
      spacing: 1
    HarmonySegment
    HarmonySegment
    HarmonySegment
    HarmonySegment
    HarmonySegment

  UIWidget
    id: sereneBar
    visible: false
    width: 13
    height: 4
    margin-top: 2
    image-draw-order: 2
    background-color: #404040
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    $on:
      background-color: #D437FF

  UIWidget
    id: icons
    size: 128 32
    visible: false
    anchors.top: lifeBar.bottom
    anchors.left: lifeBar.right
