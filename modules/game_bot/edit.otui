ArchivoBlackLabel < Label
  ttf-font: ArchivoBlack
  ttf-font-size: 12
  text-auto-resize: true
  text-align: center
  text-wrap: true

MainWindow
  id: editWindow
  !text: tr("Config editor & manager")
  @onEscape: self:hide()
  size: 700 540
  $mobile:
    size: 550 240

  Panel
    id: manager
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 165

    ArchivoBlackLabel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      !text: tr("Config Manager\nUpload a config to get a hash code. Share that hash so someone else can download it on their Fonticak client.\nThe hash is copied to the clipboard automatically after upload.")

    HorizontalSeparator
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 3
      height: 2

    Panel
      id: upload
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.horizontalCenter
      anchors.bottom: parent.bottom
      margin-top: 3

      ArchivoBlackLabel
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        !text: tr("Upload config")

      ArchivoBlackLabel
        anchors.top: prev.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 7
        !text: tr("Select config to upload")

      ComboBox
        id: config
        anchors.top: prev.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 4
        margin-left: 20
        margin-right: 20
        text-offset: 3 0

      BotButton
        id: submit
        anchors.top: prev.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        !text: tr('Upload config')
        margin-top: 4
        margin-left: 40
        margin-right: 40
        height: 20
        @onClick: modules.game_bot.uploadConfig()

    Panel
      id: download
      anchors.top: prev.top
      anchors.left: parent.horizontalCenter
      anchors.right: parent.right
      anchors.bottom: parent.bottom

      ArchivoBlackLabel
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        !text: tr("Download config")

      ArchivoBlackLabel
        anchors.top: prev.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 7
        !text: tr("Paste the hash code here")

      TextEdit
        id: config
        anchors.top: prev.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 4
        margin-left: 20
        margin-right: 20

      BotButton
        id: submit
        anchors.top: prev.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        !text: tr('Download config')
        margin-top: 4
        margin-left: 40
        margin-right: 40
        height: 20
        @onClick: modules.game_bot.downloadConfig()

  HorizontalSeparator
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 3
    height: 2

  Panel
    id: infoPanel
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 5
    height: 330
    $mobile:
      visible: false

    ArchivoBlackLabel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      !text: tr("Bot configs are stored in:")

    TextEdit
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: prev.bottom
      height: 20
      width: 520
      margin-top: 5
      editable: false
      !text: g_resources.getWriteDir() .. "bot"
      text-align: center

    BotButton
      id: documentationButton
      !text: tr('Open bot directory')
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: prev.bottom
      margin-top: 5
      width: 220
      height: 20
      @onClick: g_platform.openDir(g_resources.getWriteDir():gsub("[/\\]+", "\\") .. "bot")

    ArchivoBlackLabel
      margin-top: 5
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      !text: tr("Each folder inside the bot directory is a different config.\nTo create a new config, just create a new folder with any name.")

    Label
      margin-top: 5
      anchors.top: prev.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      height: 98
      width: 671
      image-source: folderconfig.png
      image-fixed-ratio: true
      image-smooth: false
      image-size: 671 98

    ArchivoBlackLabel
      margin-top: 3
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      !text: tr("Put .lua and .otui files inside each config folder.\nFiles load in alphabetical order: .otui first, then .lua.")

    ArchivoBlackLabel
      id: reloadHint
      margin-top: 3
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      !text: tr("To reload a config, turn the bot Off and On again.")

  BotButton
    !text: tr('Forum')
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    width: 80
    height: 20
    @onClick: g_platform.openUrl("https://github.com/soyfabi/OTC-Fonticak")

  BotButton
    !text: tr('Discord')
    anchors.bottom: parent.bottom
    anchors.left: prev.right
    margin-left: 5
    width: 80
    height: 20
    @onClick: g_platform.openUrl("https://discord.com/invite/GxTm7DyXVe")

  BotButton
    id: cancelButton
    !text: tr('Close')
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    width: 60
    height: 20
    @onClick: self:getParent():hide()
