NewMainWindow
  id: assignTextWindow
  size: 275 155
  font: verdana-11px-antialised
  color: #ffffff

  Panel
    id: contentPanel
    anchors.fill: parent
    margin: 12 12 12 12

    Label
      anchors.top: parent.top
      anchors.left: parent.left
      text: Text:
      font: Verdana Bold-11px
      color: #c0c0c0
      text-horizontal-auto-resize: true

    TextEdit
      id: text
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      max-length: 255

    FlatPanel
      id: checkPanel
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      height: 22
      image-source: /images/ui/panel_flat_border
      image-border: 1
      CheckBox
        id: tick
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        anchors.right: parent.right
        margin-left: 5
        text: Send automatically
        font: Verdana Bold-11px
        color: #c0c0c0
        checked: false

    HorizontalSeparator
      id: separator
      anchors.top: checkPanel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 10

    Button
      id: buttonClose
      anchors.top: separator.bottom
      anchors.right: parent.right
      margin-top: 8
      size: 58 20
      font: verdana-11px-monochrome
      color: #ffffff
      padding: 0
      text-offset: 0 3
      text: Cancel

    Button
      id: buttonOk
      anchors.top: separator.bottom
      anchors.right: buttonClose.left
      margin-top: 8
      margin-right: 6
      size: 43 20
      font: verdana-11px-monochrome
      color: #ffffff
      padding: 0
      text-offset: 0 3
      text: Ok
