SmartMode < CheckBox
  text: Smart mode
  margin-top: 4
  margin-left: 32
  height: 14
  font: Verdana Bold-11px
  color: #c0c0c0
  text-offset: 18 -1

RoundCheckBox < CheckBoxCircle
  height: 14
  font: Verdana Bold-11px
  color: #c0c0c0
  text-offset: 18 -1
  text-auto-resize: false
  change-cursor-image: false
  margin-top: 3

  $hover !disabled:
    color: #ffffff

  $disabled:
    color: #707070

ObjectAssignButton < Button
  font: verdana-11px-monochrome
  color: #ffffff
  size: 43 20
  padding: 0
  text-offset: 0 3
  text-align: center

  $pressed:
    image-clip: 0 20 43 20
    text-offset: 1 4

  $disabled:
    color: #ffffff88
    opacity: 0.8
