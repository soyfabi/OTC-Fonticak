EquipmentAssignSlot < UIWidget
  size: 66 66
  image-source: /images/ui/item66
  phantom: false

  UIWidget
    id: hoverPlaceholder
    anchors.fill: parent
    margin: 3
    phantom: true
    focusable: false
    visible: false
    background-color: #8CB8E8

EquipmentAssignItem < Item
  anchors.centerIn: parent
  size: 64 64
  fixed-item-size: false
  padding: 0
  image-source:
  virtual: true
  phantom: true
  focusable: false
  show-count: false

  UIWidget
    id: tier
    visible: false

EquipmentAssignNeckSlot < EquipmentAssignSlot
  UIWidget
    id: slotIcon
    anchors.centerIn: parent
    size: 64 64
    image-source: /images/inventory/inventory_neck
    phantom: true

  EquipmentAssignItem
    id: equippedItem

EquipmentAssignHeadSlot < EquipmentAssignSlot
  UIWidget
    id: slotIcon
    anchors.centerIn: parent
    size: 64 64
    image-source: /images/inventory/inventory_head
    phantom: true

  EquipmentAssignItem
    id: equippedItem

EquipmentAssignBackSlot < EquipmentAssignSlot
  UIWidget
    id: slotIcon
    anchors.centerIn: parent
    size: 64 64
    image-source: /images/inventory/inventory_back
