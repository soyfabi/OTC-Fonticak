EquipmentTypeButton < CheckBoxButton
  size: 13 13
  image-source: /images/ui/button-grey-up
  image-border: 2
  change-cursor-image: true
  cursor: pointer
  padding: 0
  $checked:
    image-source: /images/ui/button-grey-down

  UIWidget
    id: typeIcon
    anchors.centerIn: parent
    size: 9 9
    phantom: true
    visible: false

EquipmentAssignButton < Button
  font: verdana-11px-monochrome
  color: #ffffff
  size: 43 20
  padding: 0
  text-offset: 0 3
  text-align: center

  $pressed:
    image-clip: 0 20 43 20
    text-offset: 1 4

  $disabled:
    color: #ffffff88
    opacity: 0.8

EquipmentIconPickerOption < UIButton
  size: 38 38
  image-source: /images/game/actionbar/slot-actionbar-filled
  image-size: 34 34
  image-clip: 0 0 34 34
  focusable: false
  phantom: false

  UIWidget
    id: icon
    anchors.centerIn: parent
    size: 32 32
    image-source: /images/game/spells/equipment-icons
    image-size: 32 32
    image-offset: -2 -1
    phantom: true

MainWindowHigh
  !text: tr('Assign Equipment Icon')
  size: 285 258
  @onEscape: modules.game_actionbar.closeEquipmentAssignIconWindow(true)
  @onEnter: modules.game_actionbar.equipmentAssignIconOk()

  Label
    id: descriptionLabel
    !text: tr('Enter a short description:')
    text-auto-resize: true
    height: 20
    margin-top: 4
    anchors.top: parent.top
    anchors.left: parent.left
    font: verdana-11px-antialised
    color: #c0c0c0

  TextEdit
    id: descriptionTextEdit
    height: 16
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6

  Label
    id: iconLabel
    !text: tr('Select an icon:')
    text-auto-resize: true
    height: 20
    margin-top: 12
    anchors.top: descriptionTextEdit.bottom
    anchors.left: parent.left
    font: verdana-11px-antialised
    color: #c0c0c0

  Panel
    id: iconScrollFrame
    image-source: /images/ui/1pixel-down-frame
    image-border: 1
    anchors.top: iconLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 54
    margin-top: 6
    padding: 4

    HorizontalQtScrollBar
      id: iconHorizontalScroll
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-bottom: -3
      margin-left: -3
      margin-right: -3
      height: 12
      step: 40
      pixels-scroll: true
      focusable: false

    ScrollablePanel
      id: iconScrollPanel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: iconHorizontalScroll.top
      margin-bottom: 3
      horizontal-scrollbar: iconHorizontalScroll
      layout:
        type: horizontalBox
        spacing: 4

  Label
    id: typeLabel
    !text: tr('Select a type:')
    text-auto-resize: true
    height: 20
    margin-top: 12
    anchors.top: iconScrollFrame.bottom
    anchors.left: parent.left
    font: verdana-11px-antialised
    color: #c0c0c0

  UIWidget
    id: typeButtonsPanel
    anchors.top: typeLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    height: 13
    layout:
      type: horizontalBox
      spacing: 3

  HorizontalSeparator
    id: equipmentIconSeparator
    anchors.top: typeButtonsPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 2
    margin-top: 11

  EquipmentAssignButton
    id: cancelButton
    text: Cancel
    anchors.top: equipmentIconSeparator.bottom
    anchors.right: parent.right
    margin-top: 8
    margin-right: 8
    @onClick: modules.game_actionbar.closeEquipmentAssignIconWindow(true)

  EquipmentAssignButton
    id: okButton
    text: Ok
    anchors.top: cancelButton.top
    anchors.right: cancelButton.left
    margin-right: 6
    @onClick: modules.game_actionbar.equipmentAssignIconOk()
