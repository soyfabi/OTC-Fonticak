NewMainWindow
  id: assignSpellWindow
  size: 375 609
  font: verdana-11px-antialised
  color: #ffffff

  Panel
    id: contentPanel
    anchors.fill: parent
    margin: 12 12 12 12

    SpellPreview
      id: preview
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      focusable: false
      $!checked:
        background-color: alpha
      $checked:
        background-color: alpha

    HorizontalSeparator
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 9

    TextList
      id: spellList
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 11
      height: 420
      padding: 1
      padding-top: 26
      focusable: false
      vertical-scrollbar: listScrollBar
      image-source: /images/ui/panel_flat_border
      image-border: 1
      background-color: #636363

    TextEdit
      id: searchText
      size: 160 20
      anchors.top: prev.top
      anchors.left: prev.left
      anchors.right: prev.right
      margin-top: 1
      margin-right: 1
      margin-left: 1
      !placeholder: tr('Type to search')
      padding: 2
      font: Verdana Bold-11px
      placeholder-color: #707070

    Button
      id: clearButton
      anchors.top: prev.top
      anchors.right: prev.right
      margin-top: 1
      margin-right: 1
      size: 18 18
      image-source: /images/store/button-erase-small-up
      image-clip: 0 0 18 18
      $pressed:
        image-source: /images/store/button-erase-small-down
        image-clip: 0 0 18 18
      $!hover:
        image-source: /images/store/button-erase-small-up
        image-clip: 0 0 18 18

    VerticalScrollBar
      id: listScrollBar
      anchors.top: searchText.bottom
      anchors.right: spellList.right
      margin: 6 1 1 0
      anchors.bottom: spellList.bottom
      step: 14
      pixels-scroll: true

    FlatPanel
      id: checkPanel
      anchors.top: spellList.bottom
      margin-top: 6
      anchors.left: parent.left
      anchors.right: parent.right
      height: 22
      image-source: /images/ui/panel_flat_border
      image-border: 1

      CheckBox
        id: tick
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 5
        text: Filter: Level
        font: Verdana Bold-11px
        color: #c0c0c0
        checked: false
        change-cursor-image: false
        text-auto-resize: true
        $hover !disabled:
          color: #c0c0c0

      CheckBox
        id: sortByLevel
        anchors.left: tick.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 16
        text: Sort by Level
        font: Verdana Bold-11px
        color: #c0c0c0
        checked: false
        change-cursor-image: false
        text-auto-resize: true
        $hover !disabled:
          color: #c0c0c0

    Label
      id: paramLabel
      anchors.top: prev.bottom
      margin-top: 7
      anchors.left: parent.left
      text: Parameter:
      font: Verdana Bold-11px
      color: #c0c0c0
      text-auto-resize: true
      text-offset: -2 0
      on: false

      $on:
        color: #c0c0c0

      $!on:
        color: #707070

    TextEdit
      id: paramText
      anchors.top: prev.top
      anchors.left: prev.right
      anchors.right: parent.right
      margin-top: -1
      margin-left: 5
      enabled: true

    HorizontalSeparator
      id: separator
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 11

    Button
      id: buttonShowAll
      anchors.top: separator.bottom
      anchors.left: parent.left
      margin-top: 8
      size: 72 20
      font: verdana-11px-monochrome
      color: #ffffff
      padding: 0
      text-offset: 0 3
      text: Show All

    Button
      id: buttonClose
      anchors.top: separator.bottom
      anchors.right: parent.right
      margin-top: 8
      size: 58 20
      font: verdana-11px-monochrome
      color: #ffffff
      padding: 0
      text-offset: 0 3
      text: Cancel

    Button
      id: buttonOk
      anchors.top: separator.bottom
      anchors.right: buttonClose.left
      margin-top: 8
      margin-right: 6
      size: 43 20
      font: verdana-11px-monochrome
      color: #ffffff
      padding: 0
      text-offset: 0 3
      text: Ok
