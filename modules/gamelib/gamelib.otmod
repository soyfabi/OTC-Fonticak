Module
  name: gamelib
  description: Contains game related classes
  author: OTClient team
  website: https://github.com/edubart/otclient

  @onLoad: |
    dofile 'const'
    dofile 'util'
    dofile 'protocol'
    dofile 'protocollogin'
    dofile 'protocolgame'
    dofile 'position'
    dofile 'game'

    dofile 'monk'
    dofile 'creature'
    dofile 'creature_list'
    dofile 'engine_compat'
    dofile 'player'
    dofile 'market'
    dofile 'textmessages'
    dofile 'thing'
    dofile 'spell_icons'
    dofile 'spells'
    dofile 'tile'
    dofile 'items'
    dofile 'custom_forge_protocol'
    dofile 'custom_store_protocol'
    dofile 'taskboard_compat'
    dofile 'taskboard_protocol'
    dofiles 'ui'
