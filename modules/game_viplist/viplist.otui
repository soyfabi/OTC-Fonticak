VipListLabel < GameLabel
  text-offset: 14 0
  image-rect: 0 1 12 12
  image-clip: 0 0 12 12
  image-source: /images/game/creatures/vip-icons
  font: verdana-11px-monochrome
  margin-top: 2
  phantom: false
  tooltip-delay: 80

VipGroupButton < UIButton
  font: cipsoftFont
  height: 18
  padding-left: 5
  padding-right: 5
  text-offset: 0 1
  image-source: /images/ui/button-grey-up
  image-border: 2
  tooltip-delay: 80
  $on:
    image-source: /images/ui/button-grey-down
    text-offset: 1 2
  $checked:
    image-source: /images/ui/button-grey-down
    text-offset: 1 2

VipAddGroupButton < UIButton
  font: cipsoftFont
  color: #dfdfdf
  size: 16 18
  text: +
  text-offset: 0 0
  image-source: /images/ui/button-grey-up
  image-border: 2
  tooltip-delay: 80
  $hover:
    color: #ffffff
  $pressed:
    image-source: /images/ui/button-grey-down
    text-offset: 1 1

VipGroupList < UIWidget
  size: 156 20
  margin-top: 6

  Label
    id: group
    anchors.top: parent.top
    anchors.left: parent.left
    font: Verdana Bold-11px-new
    text-align: topLeft
    !text: tr('No Group')
    text-auto-resize: true
  
  HorizontalSeparator
    width: 158
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 15
  
  Panel
    id: panel
    size: 156 45
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 19
    layout:
      type: verticalBox
      fit-children: true

MiniWindow
  id: vipWindow
  height: 150
  @onOpen: modules.game_viplist.onMiniWindowOpen()
  @onClose: modules.game_viplist.onMiniWindowClose()
  &save: true

  UIWidget
    id: miniwindowIcon
    anchors.top: miniwindowHeader.top
    anchors.left: miniwindowHeader.left
    margin-top: 2
    margin-left: 4
    image-source: /images/topbuttons/viplist
    image-rect: 0 0 12 12
    image-smooth: false

  Label
    id: miniwindowTitle
    anchors.top: miniwindowHeader.top
    anchors.left: miniwindowHeader.left
    anchors.right: miniwindowHeader.right
    margin-top: 1
    margin-left: 20
    margin-right: 50
    font: verdana-11px-monochrome
    height: 13
    !text: tr('VIP')
    color: #909090

  UIButton
    id: prevGroupButton
    height: 18
    width: 14
    visible: false
    anchors.top: miniwindowHeader.bottom
    anchors.left: parent.left
    margin-top: 2
    margin-left: 2
    image-source: /images/game/console/leftarrow
    image-clip: 0 0 16 16
    opacity: 1.0
    image-color: #ffffff
    $hover:
      opacity: 0.8
    $pressed:
      opacity: 0.6

  UIButton
    id: nextGroupButton
    height: 18
    width: 14
    visible: false
    anchors.top: miniwindowHeader.bottom
    anchors.right: miniwindowScrollBar.left
    margin-top: 2
    margin-right: 1
    image-source: /images/game/console/rightarrow
    image-clip: 0 0 16 16
    opacity: 1.0
    image-color: #ffffff
    $hover:
      opacity: 0.8
    $pressed:
      opacity: 0.6

  ScrollablePanel
    id: groupsPanel
    height: 0
    visible: false
    anchors.top: miniwindowHeader.bottom
    anchors.left: parent.left
    anchors.right: miniwindowScrollBar.left
    margin-top: 0
    margin-left: 3
    margin-right: 1
    layout:
      type: horizontalBox
      spacing: 2

  MiniWindowContents
    anchors.top: miniwindowHeader.bottom
    anchors.left: parent.left
    anchors.right: miniwindowScrollBar.left
    anchors.bottom: parent.bottom
    margin-top: 2
    padding-left: 5
    padding-right: 5
    layout: verticalBox
    &onMousePress: modules.game_viplist.onVipListMousePress
  
  UIWidget
    id: miniborder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    image-source: /images/ui/miniborder-bottom-left
    size: 14 14
    margin-left: 2
    margin-bottom: 2
