VipGroupBox < CheckBox
  !text: tr('Empty')
  font: Verdana Bold-11px-new
  color: #c0c0c0
  change-cursor-image: false
  text-offset: 16 0

IconButton < CheckBoxButton
  size: 16 16
  image-source: /images/ui/button-grey-up
  image-border: 3
  margin-top: 2
  margin-bottom: 2
  margin-right: 2
  margin-left: 2
  icon: /images/game/creatures/vip-icons
  icon-clip: 0 0 12 12

  $checked:
    image-source: /images/ui/button-grey-down

  $first:
    margin-left: 0

  $!first:
    margin-left: 3

MainWindowHigh
  size: 285 376
  !text: tr('Edit VIP')
  font: Verdana Bold-11px-new
  color: #909090
  text-offset: 0 2

  Label
    id: nameLabel
    text: Name
    font: Verdana Bold-11px-new
    color: #c0c0c0
    anchors.top: parent.top
    anchors.left: parent.left
    width: 180
    margin-left: -1
    margin-top: -7

  HorizontalSeparator
    id: separator1
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: nameLabel.bottom
    margin-top: 5

  Label
    id: selectTypeLabel
    text: Select a type:
    font: Verdana Bold-11px-new
    color: #c0c0c0
    anchors.top: separator1.bottom
    anchors.left: parent.left
    width: 180
    margin-left: -1
    margin-top: 9

  UIWidget
    id: iconsPanel
    layout: horizontalBox
    anchors.top: selectTypeLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    height: 20

    IconButton
      id: icon0

    IconButton
      id: icon1
      icon-clip: 12 0 12 12

    IconButton
      id: icon2
      icon-clip: 24 0 12 12

    IconButton
      id: icon3
      icon-clip: 36 0 12 12

    IconButton
      id: icon4
      icon-clip: 48 0 12 12

    IconButton
      id: icon5
      icon-clip: 60 0 12 12

    IconButton
      id: icon6
      icon-clip: 72 0 12 12

    IconButton
      id: icon7
      icon-clip: 84 0 12 12

    IconButton
      id: icon8
      icon-clip: 96 0 12 12

    IconButton
      id: icon9
      icon-clip: 108 0 12 12

    IconButton
      id: icon10
      icon-clip: 120 0 12 12
  
  Label
    id: descriptionLabel
    text: Enter a short description:
    font: Verdana Bold-11px-new
    color: #c0c0c0
    anchors.top: iconsPanel.bottom
    anchors.left: parent.left
    margin-left: -1
    margin-top: 9
    text-auto-resize: true

  TextEdit
    id: descriptionText
    anchors.top: descriptionLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 58
    margin-top: 5
    multiline: true
    text-wrap: true
    padding-right: 14
    max-length: 40
    vertical-scrollbar: descriptionTextScrollBar

  VerticalQtScrollBar
    id: descriptionTextScrollBar
    anchors.top: descriptionText.top
    anchors.bottom: descriptionText.bottom
    anchors.right: descriptionText.right
    margin-top: 1
    margin-bottom: 1
    margin-right: 1
    step: 16

  Label
    id: descriptionWarnLabel
    anchors.top: descriptionText.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    height: 14
    font: Verdana Bold-11px-new
    text-align: left

  UIWidget
    id: notifyBox
    size: 253 22
    image-source: /images/ui/1pixel-down-frame
    image-border: 5
    anchors.top: descriptionWarnLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4

    OptionCheckBox
      id: checkBoxNotify
      !text: tr('Notify on login')
      anchors.left: parent.left
      anchors.top: parent.top
      text-offset: 16 1
      margin-left: 4
      margin-top: 3
      color: #c0c0c0
      font: Verdana Bold-11px-new

  HorizontalSeparator
    id: separator2
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: notifyBox.bottom
    margin-top: 8

  Label
    id: groupsLabel
    !text: tr('Member of the following groups:')
    font: Verdana Bold-11px-new
    color: #c0c0c0
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: separator2.bottom
    margin-top: 6
    margin-left: -1
    text-auto-resize: true

  Panel
    id: groups
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: groupsLabel.bottom
    anchors.bottom: separator3.top
    margin-top: 6
    margin-bottom: 12
    layout:
      type: grid
      cell-spacing: 3
      cell-size: 241 15
      num-columns: 1

  HorizontalSeparator
    id: separator3
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: buttonOK.top
    margin-bottom: 12

  Button
    id: buttonOK
    !text: tr('Ok')
    size: 43 20
    text-offset: 0 0
    anchors.right: buttonCancel.left
    anchors.bottom: parent.bottom
    margin-right: 11

  Button
    id: buttonCancel
    !text: tr('Cancel')
    size: 43 20
    text-offset: 0 0
    anchors.right: parent.right
    anchors.bottom: parent.bottom
