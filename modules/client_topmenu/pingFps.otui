testPingPanel < UIWidget
  height: 20
  width: 150
  focusable: false
  layout:
    type: horizontalBox
  pingImg
  pingFpsLabel


pingImg < UIWidget
  size: 17 17
  margin-right: 2
  phantom: true
  focusable: false

pingFpsLabel < UIWidget
  height: 14
  text-auto-resize: true
  text-horizontal-auto-resize: true
  text-align: left
  phantom: true
  font: verdana-11px-rounded
  focusable: false


Panel
  id: pingFpsRoot
  anchors.top: parent.top
  anchors.left: parent.left
  height: 50
  width: 150
  margin-top: 2
  margin-left: 2
  phantom: true
  focusable: false
  Panel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 20
    layout:
      type: horizontalBox

  Panel
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    height: 20
    layout:
      type: horizontalBox
