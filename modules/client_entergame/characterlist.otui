CharacterWidget < UIWidget
  height: 14
  &updateOnStates: |
    function(self)
      local children = self:getChildren()
      for i=1,#children do
        children[i]:setOn(self:isFocused())
      end
      local parent = self:getParent()
      for i, children in ipairs(parent:getChildren()) do
        if i % 2 == 1 and not children:isFocused() then
          children:setBackgroundColor("#484848")
        elseif children:isFocused() then
          children:setBackgroundColor("#ffffff22")
        else
          children:setBackgroundColor("alpha")
        end
      end
    end
  @onFocusChange: self:updateOnStates()
  @onSetup: |
    self:updateOnStates()
    self:setHeight(66)

  UIWidget
    id: outfit
    size: 70 70
    &baseWidth: 70
    anchors.top: parent.top
    anchors.left: parent.left

    UICreature
      id: outfitCreatureBox
      size: 64 64
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter
      creatureDisplay:setCreature(creature)
      margin-left: -2
      margin-top: -1
      fixed-creature-size: true

  Label
    id: name
    color: #bbbbbb
    anchors.top: parent.top
    anchors.left: prev.right
    color: #c0c0c0
    font: Verdana Bold-11px
    text-auto-resize: true
    background-color: alpha
    margin-left: -2

    $on:
      color: #ffffff

  UIWidget
    id: mainCharacter
    size: 9 8
    anchors.verticalCenter: name.verticalCenter
    anchors.left: name.right
    margin-left: 3
    image-source: /images/game/entergame/maincharacter
    image-clip: 0 0 9 8
    visible: false
    !tooltip: tr('Main Character')

  UIWidget
    id: characterPin
    size: 12 12
    image-source: /images/ui/fix-button
    image-size: 12 12
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 264
    margin-top: 2
    visible: false
    focusable: false
    cursor: pointer
    !tooltip: tr('Pin this character to keep it at the top of the list')

  UIWidget
    id: characterHideButton
    size: 14 14
    image-source: /images/ui/hide_eye_small
    image-clip: 2 2 14 14
    anchors.top: characterPin.bottom
    anchors.left: characterPin.left
    margin-top: 2
    margin-left: -1
    visible: false
    focusable: false
    cursor: pointer
    !tooltip: tr('Hide Character')

  UIWidget
    id: statusCell
    width: 55
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-left: 277
    phantom: true

    UIWidget
      id: statusIcons
      height: 19
      anchors.verticalCenter: parent.verticalCenter
      anchors.horizontalCenter: parent.horizontalCenter
      layout:
        type: horizontalBox
        spacing: 3
        fit-children: true

      UIWidget
        id: statusDailyReward
        size: 11 19
        focusable: false
        phantom: false
        image-source: /images/game/entergame/dailyreward_notcollected
        image-clip: 0 0 11 19
        !tooltip: tr('Your daily reward has not been collected, yet.')

      UIWidget
        id: statusHidden
        size: 11 19
        focusable: false
        phantom: false
        image-source: /images/game/entergame/hidden
        image-clip: 0 0 11 19
        visible: false
        !tooltip: tr('Hidden Character')

  UIWidget
    id: levelCell
    width: 50
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-left: 332
    phantom: true

    Label
      id: level
      anchors.centerIn: parent
      color: #c0c0c0
      font: Verdana Bold-11px
      text-auto-resize: true
      text-align: center
      background-color: alpha

      $on:
        color: #ffffff

  UIWidget
    id: vocationCell
    width: 115
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-left: 382
    phantom: true

    Label
      id: vocation
      anchors.centerIn: parent
      color: #c0c0c0
      font: Verdana Bold-11px
      text-auto-resize: true
      text-align: center
      background-color: alpha

      $on:
        color: #ffffff

  UIWidget
    id: worldCell
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 497
    phantom: true

    Label
      id: worldName
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter
      margin-top: -7
      color: #c0c0c0
      font: Verdana Bold-11px
      text-auto-resize: true
      text-align: center
      background-color: alpha
      &baseText: '%s'
      @onSetup: |
        self.baseText = '%s'

      $on:
        color: #ffffff

    Label
      id: worldPvpType
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: worldName.bottom
      margin-top: -1
      color: #c0c0c0
      font: Verdana Bold-11px
      text-auto-resize: true
      text-align: center
      background-color: alpha
      &baseText: '(%s)'
      @onSetup: |
        self.baseText = '%s'

      $on:
        color: #ffffff

MainWindow
  id: charactersWindow
  !text: tr('Select Character')
  color: #909090
  visible: false
  padding-left: 15
  padding-top: 25
  image-source: /images/ui/popupwindow
  text-offset: 0 1
  draggable: false
  @onEnter: CharacterList.doLogin()
  @onEscape: CharacterList.hide(true)
  @onSetup: |
    g_keyboard.bindKeyPress('Up', function()
      local list = self:recursiveGetChildById('characters')
      if not list then return end
      list:focusPreviousChild(KeyboardFocusReason)
      local focused = list:getFocusedChild()
      if focused then list:ensureChildVisible(focused) end
    end, self)
    g_keyboard.bindKeyPress('Down', function()
      local list = self:recursiveGetChildById('characters')
      if not list then return end
      list:focusNextChild(KeyboardFocusReason)
      local focused = list:getFocusedChild()
      if focused then list:ensureChildVisible(focused) end
    end, self)
    self:setSize({width = 745, height = 429})

  Button
    id: createCharacterButton
    !text: tr('Create Character')
    size: 118 20
    anchors.right: manageAccountButton.left
    anchors.top: parent.top
    margin-top: 4
    margin-right: 6
    padding: 0
    font: cipsoftFont
    text-offset: 0 1
    @onClick: CharacterList.createCharacter()

  Button
    id: manageAccountButton
    !text: tr('Manage Account')
    size: 118 20
    anchors.right: parent.right
    anchors.top: parent.top
    margin-top: 4
    margin-right: 1
    padding: 0
    font: cipsoftFont
    text-offset: 0 1
    @onClick: CharacterList.manageAccount()

  Label
    id: recoverySetupLabel
    anchors.left: parent.left
    anchors.right: createCharacterButton.left
    anchors.verticalCenter: manageAccountButton.verticalCenter
    margin-left: 1
    margin-right: 10
    height: 20
    text-align: left
    font: Verdana Bold-11px
    color: #FF9854
    !text: tr('You need to complete the recovery setup process!')
    visible: true
    cursor: pointer
    @onClick: CharacterList.manageAccount()

  UIWidget
    id: charactersListFrame
    image-source: /images/ui/1pixel-down-frame
    image-border: 5
    @onSetup: |
      self:breakAnchors()
      self:setSize({ width = 713, height = 263 })
      self:addAnchor(AnchorTop, 'manageAccountButton', AnchorBottom)
      self:addAnchor(AnchorLeft, 'parent', AnchorLeft)
      self:setMarginTop(8)
      self:setMarginLeft(1)
      self:setMarginBottom(0)

    UIWidget
      id: charactersListInner
      anchors.fill: parent
      margin: 1
      background-color: #414141

      UIWidget
        id: charactersTableHeader
        height: 15
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        background-color: #363636

        UIWidget
          id: characterHeaderCell
          size: 275 15
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          focusable: false
          change-cursor-image: true
          cursor: pointer
          @onClick: CharacterList.toggleSortOrder()

          Label
            id: characterHeaderLabel
            margin-left: 68
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            !text: tr('Character') .. ''
            font: verdana-11px-monochrome
            color: #c0c0c0
            text-align: center
            text-offset: 0 0
            phantom: true

        UIButton
          id: characterSortButton
          size: 7 4
          anchors.verticalCenter: parent.verticalCenter
          anchors.left: parent.left
          margin-left: 266
          image-source: /images/game/entergame/sort-button
          image-clip: 0 4 7 4
          cursor: pointer
          !tooltip: tr('Sort by level: Highest to Lowest')
          @onClick: CharacterList.toggleSortOrder()

        UIWidget
          id: statusHeaderCell
          size: 55 15
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 277
          focusable: false
          change-cursor-image: true
          cursor: pointer

          Label
            id: statusHeaderLabel
            anchors.centerIn: parent
            !text: tr('Status') .. ''
            font: verdana-11px-monochrome
            color: #c0c0c0
            text-align: center
            phantom: true

        UIWidget
          id: levelHeaderCell
          size: 50 15
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 332
          focusable: false
          change-cursor-image: true
          cursor: pointer

          Label
            id: levelHeaderLabel
            anchors.centerIn: parent
            !text: tr('Level') .. ''
            font: verdana-11px-monochrome
            color: #c0c0c0
            text-align: center
            phantom: true

        UIWidget
          id: vocationHeaderCell
          size: 115 15
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 382
          focusable: false
          change-cursor-image: true
          cursor: pointer

          Label
            id: vocationHeaderLabel
            anchors.centerIn: parent
            !text: tr('Vocation') .. ''
            font: verdana-11px-monochrome
            color: #c0c0c0
            text-align: center
            phantom: true

        UIWidget
          id: worldHeaderCell
          height: 15
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 497
          focusable: false
          change-cursor-image: true
          cursor: pointer

          Label
            id: worldHeaderLabel
            anchors.centerIn: parent
            !text: tr('World') .. ''
            font: verdana-11px-monochrome
            color: #c0c0c0
            text-align: center
            phantom: true

        // A-Z sorting / server order (disabled for now)
        //Button
        //  id: sortOrderButton
        //  anchors.right: parent.right
        //  anchors.verticalCenter: parent.verticalCenter
        //  margin-right: 2
        //  size: 30 14
        //  text: 'Srv'
        //  text-offset: 0 -1
        //  font: Verdana Bold-11px
        //  tooltip: tr('Sorted by server order')

      TextList
        id: characters
        anchors.top: charactersHeaderSeparator.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        border-width: 0
        padding: 0
        focusable: false
        auto-focus: first
        @onSetup: |
          if g_game.getFeature(GameEnterGameShowAppearance) then
            self:setBackgroundColor("#414141")
          else
            self:setBackgroundColor("#565656")
          end

      VerticalSeparator
        anchors.left: parent.left
        anchors.top: charactersTableHeader.top
        anchors.bottom: characters.bottom
        margin-left: 277

      VerticalSeparator
        anchors.left: parent.left
        anchors.top: charactersTableHeader.top
        anchors.bottom: characters.bottom
        margin-left: 332

      VerticalSeparator
        anchors.left: parent.left
        anchors.top: charactersTableHeader.top
        anchors.bottom: characters.bottom
        margin-left: 382

      VerticalSeparator
        anchors.left: parent.left
        anchors.top: charactersTableHeader.top
        anchors.bottom: characters.bottom
        margin-left: 497

      HorizontalSeparator
        id: charactersHeaderSeparator
        anchors.top: charactersTableHeader.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-left: 0
        margin-right: 0
        z-index: 2

  VerticalQtScrollBar
    id: characterListScrollBar
    anchors.top: charactersListFrame.top
    anchors.bottom: charactersListFrame.bottom
    anchors.right: parent.right
    margin-bottom: 1
    margin-top: 1
    margin-right: 1
    step: 20
    pixels-scroll: true
    parent-scroll: false

  UIButton
    id: getPremiumButton
    anchors.right: parent.right
    anchors.bottom: separator.top
    margin-bottom: 12
    image-border: 5
    cursor: pointer
    image-source: /images/ui/button-green-up
    size: 85 20
    text: "Get Premium"
    text-offset: 0 1
    font: cipsoftFont
    visible: false
    @onClick: CharacterList.onGetPremiumClick()

    $pressed:
      image-source: /images/ui/button-green-down
      text-offset: 1 2

  Label
    id: accountStatusCaption
    !text: tr('Account Status') .. ':'
    anchors.left: parent.left
    anchors.bottom: next.top
    color: #c0c0c0
    font: Verdana Bold-11px
    @onSetup: |
      self:setMarginBottom(6)

  UIWidget
    id: accountStatusIcon
    size: 22 20
    anchors.left: parent.left
    anchors.bottom: next.bottom
    margin-bottom: 1
    margin-left: 1
    focusable: false
    phantom: false
    image-source: /images/game/entergame/premium
    image-clip: 0 0 22 20
    !tooltip: tr('Get a Premium account to enjoy exclusive benefits. Click \'Get Premium\' to upgrade.')

  Label
    id: accountStatusLabel
    !text: tr('Free Account')
    anchors.left: parent.left
    text-auto-resize: true
    font: Verdana Bold-11px
    color: #c0c0c0
    !tooltip: tr('Get a Premium account to enjoy exclusive benefits. Click \'Get Premium\' to upgrade.')
    @onSetup: |
      self:setMarginBottom(10)
      self:setPaddingBottom(4)
      self:setTextOffset({x = 27, y = 0})
      self:addAnchor(AnchorBottom, 'next', AnchorBottom)

  HorizontalSeparator
    id: separator
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 1
    anchors.bottom: next.top
    margin-bottom: 11

  UIWidget
    id: characterBoxBackground
    size: 184 22
    image-source: /images/ui/button-grey-down
    image-border: 3
    margin-left: 1
    anchors.left: parent.left
    anchors.bottom: parent.bottom

  QtCheckBox
    id: hiddenCharacterBox
    !text: tr('Show Hidden Characters')
    anchors.verticalCenter: characterBoxBackground.verticalCenter
    anchors.horizontalCenter: characterBoxBackground.horizontalCenter
    margin-left: 2
    margin-top: -1
    text-offset: 16 0
    width: 180
    color: #c0c0c0
    font: Verdana Bold-11px
    @onCheckChange: modules.client_entergame.toggleHiddenCharacters(self:isChecked())

  UIWidget
    id: outfitBoxBackground
    size: 107 22
    image-source: /images/ui/button-grey-down
    image-border: 3
    margin-left: 11
    anchors.left: characterBoxBackground.right
    anchors.bottom: parent.bottom

  QtCheckBox
    id: showOutfitBox
    !text: tr('Show Outfits')
    anchors.verticalCenter: outfitBoxBackground.verticalCenter
    anchors.horizontalCenter: outfitBoxBackground.horizontalCenter
    width: 100
    margin-top: -1
    text-offset: 16 0
    color: #c0c0c0
    font: Verdana Bold-11px
    checked: true
    @onCheckChange: modules.client_entergame.toggleShowOutfit(self:isChecked())

  Button
    id: autoReconnect
    anchors.left: outfitBoxBackground.right
    anchors.bottom: parent.bottom
    margin-left: 11
    margin-bottom: 1
    width: 140
    height: 20
    font: Verdana Bold-11px
    text-offset: 0 1
    $!on:
      image-color: red
    $on:
      image-color: green

  Button
    id: buttonOk
    !text: tr('Ok')
    size: 43 20
    anchors.right: next.left
    anchors.bottom: parent.bottom
    margin-bottom: 1
    margin-right: 11
    text-offset: 0 0
    @onClick: CharacterList.doLogin()

  Button
    id: buttonCancel
    !text: tr('Cancel')
    size: 43 20
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-bottom: 1
    text-offset: 0 0
    @onClick: CharacterList.hide(true)
