EnterGameWindow < MainWindow
  !text: tr('Journey Onwards')
  size: 280 246
  color: #909090
  font: Verdana Bold-11px
  text-offset: 0 1
  padding-left: 15

SavedAccountRow < UIWidget
  height: 22

  QtButton
    id: account
    anchors.left: parent.left
    anchors.right: passwordSaved.left
    anchors.verticalCenter: parent.verticalCenter
    height: 21
    margin-right: 4
    padding: 0 2
    text-align: left
    text-offset: 5 1
    image-color: #d7d7d7

    $hover !pressed:
      image-color: #ffffff

    $on !pressed:
      image-color: #ffffff

  UIWidget
    id: passwordSaved
    anchors.right: pin.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 3
    size: 8 12
    image-source: /images/game/wheel/icon-locked
    !tooltip: tr('Password saved')
    focusable: false
    visible: false

  QtButton
    id: pin
    anchors.right: remove.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 4
    size: 22 21
    padding: 0
    icon-source: /images/icons/icon-star-inactive

    $on:
      icon-source: /images/icons/icon-star-active

  QtButton
    id: remove
    text: X
    !tooltip: tr('Remove saved account')
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    size: 22 21
    padding: 0

EnterGameAccounts < Window
  !text: tr('Accounts')
  size: 216 204
  image-source: /images/ui/popupwindow-rounded
  draggable: false
  visible: false
  padding: 31 10 10 10
  font: Verdana Bold-11px
  color: #c0c0c0
  text-offset: 0 1

  QtCheckBox
    id: saveAccount
    !text: tr('Save Account')
    !tooltip: tr('Save this account after a successful login. The password is stored only if Remember Password is checked.')
    anchors.left: parent.left
    anchors.right: renameAccount.left
    anchors.bottom: parent.bottom
    margin-right: 3
    text-offset: 16 0
    color: #c0c0c0
    font: Verdana Bold-11px

  QtButton
    id: renameAccount
    !text: tr('Rename')
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-bottom: -2
    size: 1 18
    padding: 0
    visible: false

  UIWidget
    id: accountUndoBar
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: saveAccount.top
    height: 1
    focusable: false
    visible: false

    Label
      !text: tr('Account removed')
      anchors.left: parent.left
      anchors.right: undo.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 4
      phantom: true

    QtButton
      id: undo
      !text: tr('Undo')
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      size: 43 19
      padding: 0

  ScrollablePanel
    id: accountList
    phantom: false
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: accountScroll.left
    anchors.bottom: accountUndoBar.top
    margin-right: 3
    margin-bottom: 8
    vertical-scrollbar: accountScroll
    layout:
      type: verticalBox
      spacing: 3

  VerticalQtScrollBar
    id: accountScroll
    anchors.top: parent.top
    anchors.right: parent.right
    anchors.bottom: accountUndoBar.top
    margin-bottom: 8
    step: 25
    pixels-scroll: true

  Label
    id: emptyAccounts
    !text: tr('No saved accounts')
    anchors.centerIn: accountList
    text-auto-resize: true
    color: #c0c0c0
    phantom: true

EnterGameWindow
  id: enterGame
  draggable: false
  size: 280 246
  image-source: /images/ui/popupwindow-rounded
  @onEnter: EnterGame.doLogin()

  UIButton
    id: accountsToggle
    anchors.left: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 13
    margin-top: -10
    size: 22 86
    padding: 0
    overflow: visible
    focusable: true
    !tooltip: tr('Tab to Accounts, Enter to open, Up and Down to select, Esc to close')
    @onClick: EnterGame.showAccounts()

    UIWidget
      anchors.centerIn: parent
      margin-left: 1
      size: 86 22
      image-source: /images/ui/popupwindow-rounded
      image-clip: 0 17 236 190
      image-border: 5
      image-border-top: 0
      rotation: -90
      phantom: true

    Label
      id: accountTabLabel
      !text: tr('Account')
      anchors.centerIn: parent
      margin-bottom: 7
      size: 76 18
      text-align: center
      rotation: 90
      phantom: true

    UIWidget
      id: accountTabArrow
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.bottom: parent.bottom
      margin-right: 1
      margin-bottom: 9
      size: 7 7
      image-source: /images/ui/icon-arrow7x7-right
      image-color: #ff6666
      rotation: 0
      phantom: true

      $on:
        image-color: #63df82
        rotation: 180

  Label
    id: emailLabel
    !text: tr('Email/Acc. Name:')
    anchors.left: parent.left
    anchors.top: parent.top
    color: #c0c0c0
    font: Verdana Bold-11px
    margin-top: -4
    margin-left: -2
    text-offset: 2 0

  Label
    id: passwordLabel
    !text: tr('Password:')
    anchors.left: emailLabel.left
    anchors.top: emailLabel.bottom
    margin-top: 17
    color: #c0c0c0
    font: Verdana Bold-11px
    text-offset: 2 0

  TextQtHideToggleBox
    id: accountEmailVisibilityBox
    anchors.right: parent.right
    anchors.verticalCenter: emailLabel.verticalCenter
    !tooltip: tr('Show Email/Account Name')

    UICheckBox
      id: accountEmailVisibilityToggle
      size: 18 18
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter
      image-rect: 0 0 18 18
      margin-right: 1
      image-source: /images/ui/hide_eye_small
      !tooltip: tr('Show Email/Account Name')
      @onCheckChange: |
        local isShown = self:isChecked()
        local tip = isShown and tr('Hide Email/Account Name') or tr('Show Email/Account Name')
        self:setTooltip(tip)
        self:getParent():setTooltip(tip)
        self:getParent():getParent():getChildById('accountNameTextEdit'):setTextHidden(not isShown)
        self:getParent():getParent():getChildById('accountNameTextEdit'):setTextWrap(false)

      $!checked:
        image-clip: 0 0 18 18

      $checked:
        image-clip: 0 18 18 18

  HiddenTextQtEdit
    id: accountNameTextEdit
    anchors.left: passwordLabel.right
    margin-left: 5
    anchors.right: accountEmailVisibilityBox.left
    margin-right: -2
    anchors.verticalCenter: emailLabel.verticalCenter
    font: Verdana Bold-11px
    padding-left: 2
    padding-right: 1
    padding-top: 3
    text-offset: 3 0

  TextQtHideToggleBox
    id: accountPasswordVisibilityBox
    anchors.right: parent.right
    anchors.verticalCenter: passwordLabel.verticalCenter
    !tooltip: tr('Show Password')

    UICheckBox
      id: accountPasswordVisibilityToggle
      size: 18 18
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter
      image-rect: 0 0 18 18
      margin-right: 1
      image-source: /images/ui/hide_eye_small
      !tooltip: tr('Show Password')
      @onCheckChange: |
        local isShown = self:isChecked()
        local tip = isShown and tr('Hide Password') or tr('Show Password')
        self:setTooltip(tip)
        self:getParent():setTooltip(tip)
        self:getParent():getParent():getChildById('accountPasswordTextEdit'):setTextHidden(not isShown)
        self:getParent():getParent():getChildById('accountPasswordTextEdit'):setTextWrap(false)

      $!checked:
        image-clip: 0 0 18 18

      $checked:
        image-clip: 0 18 18 18

  HiddenTextQtEdit
    id: accountPasswordTextEdit
    anchors.left: passwordLabel.right
    margin-left: 5
    anchors.right: accountPasswordVisibilityBox.left
    margin-right: -2
    anchors.verticalCenter: passwordLabel.verticalCenter
    font: Verdana Bold-11px
    padding-left: 2
    padding-right: 1
    padding-top: 3
    text-offset: 3 0

  UIWidget
    id: capsLockWarning
    size: 143 21
    anchors.top: accountPasswordTextEdit.bottom
    anchors.left: accountPasswordTextEdit.left
    margin-top: 0
    background-color: #C0C0C0
    border-width: 1
    border-color: #000000
    visible: false
    z-index: 100
    phantom: true

    UIWidget
      id: capsLockWarningIcon
      size: 10 10
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 4
      image-source: /images/icons/icon-inline-warning

    Label
      id: capsLockWarningText
      anchors.left: capsLockWarningIcon.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 5
      font: verdana-11px-monochrome
      color: #3f3f3f
      !text: tr('Capslock is active!')
      text-auto-resize: true

  QtCheckBox
    id: rememberEmailBox
    !text: tr('Remember Email/Acc. Name')
    !tooltip: tr('Remember email when starts client')
    anchors.left: passwordLabel.left
    anchors.right: parent.right
    anchors.top: accountPasswordTextEdit.bottom
    margin-top: 10
    margin-left: 2
    text-offset: 16 0
    color: #c0c0c0
    font: Verdana Bold-11px
    @onCheckChange: |
      self:getParent():getChildById('rememberEmailTip'):setOn(self:isChecked())

  UIWidget
    id: rememberEmailTip
    image-source: /images/icons/show_gui_help_grey
    !specialtooltip: 'Be aware that your email address will be stored on your configuration file "config.otml" if you activate this option.'
    anchors.right: accountNameTextEdit.right
    margin-right: -19
    margin-top: 1
    anchors.verticalCenter: rememberEmailBox.verticalCenter
    visible: false

    $on:
      visible: true

    $!on:
      visible: false

  QtCheckBox
    id: rememberPasswordBox
    !text: tr('Remember Password')
    !tooltip: tr('Remember password when starts client')
    anchors.left: passwordLabel.left
    anchors.right: parent.right
    anchors.top: rememberEmailBox.bottom
    margin-top: 7
    margin-left: 2
    color: #c0c0c0
    font: Verdana Bold-11px
    text-offset: 16 0
    @onCheckChange: |
      self:getParent():getChildById('rememberPasswordTip'):setOn(self:isChecked())

  UIWidget
    id: rememberPasswordTip
    image-source: /images/icons/show_gui_help_grey
    !specialtooltip: 'Be aware that your Password address will be stored on your configuration file "config.otml" if you activate this option.'
    anchors.right: accountNameTextEdit.right
    anchors.verticalCenter: rememberPasswordBox.verticalCenter
    margin-right: -19
    margin-top: 1
    visible: false
    $on:
      visible: true
    $!on:
      visible: false

  UIWidget
    id: Forgot_password_email
    height: 14
    anchors.left: rememberEmailBox.left
    anchors.right: parent.right
    anchors.top: rememberPasswordBox.bottom
    margin-top: 6
    margin-left: 1
    focusable: false
    cursor: pointer
    @onClick: |
      local url = Services and Services.websites
      if url then
        g_platform.openUrl(url)
      end

    Label
      id: forgotPasswordLabel
      !text: tr('Forgot password and/or email')
      font: Verdana-11px-lowspace-underline
      color: #c0c0c0
      text-auto-resize: true
      anchors.left: parent.left
      anchors.top: parent.top
      phantom: true

  UIWidget
    id: btnLoginWithGoogle
    height: 23
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: Forgot_password_email.bottom
    margin-top: 8
    margin-left: 1
    margin-right: -1
    background-color: #2a4560
    border-width: 1
    border-color: #152535
    cursor: pointer
    focusable: false
    change-cursor-image: true
    @onClick: EnterGame.onGoogleLoginClick()

    $pressed:
      background-color: #1e3549
      border-color: #101c28

    UIWidget
      id: googleLoginContent
      height: 18
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter
      phantom: true
      layout:
        type: horizontalBox
        spacing: 4
        fit-children: true

      UIWidget
        id: googleLoginIcon
        size: 18 18
        image-source: /images/game/entergame/icon-google
        image-size: 18 18
        focusable: false
        change-cursor-image: true
        cursor: pointer
        @onClick: EnterGame.onGoogleLoginClick()

      Label
        id: googleLoginLabel
        !text: tr('Login with Google')
        font: Verdana Bold-11px
        color: #c0c0c0
        text-auto-resize: true
        focusable: false
        change-cursor-image: true
        cursor: pointer
        @onClick: EnterGame.onGoogleLoginClick()

  HorizontalSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: btnLoginWithGoogle.bottom
    margin-top: 15
    margin-left: 1

  QtButton
    !text: tr('Login')
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 11
    margin-right: -1
    text-offset: 0 1
    size: 88 21
    @onClick: EnterGame.doLogin()
    color: #FFFFFF

  QtButton
    id: btnCreateNewAccount
    !text: tr('Create Account')
    anchors.left: parent.left
    anchors.top: prev.top
    text-offset: 0 1
    size: 110 21
    color: #FFFFFF
    @onClick: |
      if createWidgetAccount then
        self:disable()
        createWidgetAccount()
      end


  Label
    id: serverInfoLabel
    font: verdana-11px-rounded
    anchors.top: prev.top
    anchors.left: parent.left
    margin-top: 6
    color: green
    text-auto-resize: true

