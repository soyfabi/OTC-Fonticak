InactivePreyPanel < Panel
  anchors.top: parent.top
  anchors.horizontalCenter: parent.horizontalCenter
  anchors.verticalCenter: parent.verticalCenter
  anchors.bottom: parent.bottom

  NoCreaturePanel
    id: inactivePanel
    size: 205 158
    anchors.left: parent.left
    anchors.top: parent.top

  Panel
    id: buttonsPanel
    size: 204 139
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 4

    Panel
      id: buttonsRow
      size: 204 91
      anchors.top: parent.top
      anchors.left: parent.left

      PreyButtonsRowEmpty
        id: buttonsEmpty
        anchors.fill: parent

      PreyButtonsRowFilled
        id: buttonsFilled
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 1
        visible: false

    Panel
      id: autoReroll
      size: 176 22
      anchors.top: buttonsRow.bottom
      anchors.left: parent.left
      margin-top: 4
      image-source: /images/ui/1pixel-down-frame
      image-border: 3

      CheckBox
        id: autoRerollCheck
        size: 170 15
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: parent.left
        margin-top: 2
        margin-left: 5
        image-source: /images/ui/checkbox
        image-border: 1
        text: Automatic Bonus Reroll
        text-offset: 15 -3
        font: verdana-11px-rounded
        color: #c0c0c0
        change-cursor-image: false
        @onHoverChange: modules.game_prey.onHover(self)
        $hover !disabled
          color: #c0c0c0

    Panel
      id: autoRerollPrice
      size: 26 22
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 3
      image-source: /images/ui/button-verydarkgrey-down
      image-border: 3
      image-clip: 0 0 98 40

      UIWidget
        id: cards
        anchors.top: parent.top
        anchors.right: parent.right
        margin-top: 6
        margin-right: 3
        image-source: /images/game/prey/prey-wildcards-icon
        tooltip: Prey Wildcards

      UIWidget
        id: text
        anchors.top: parent.top
        anchors.right: prev.left
        margin-top: 4
        margin-right: 2
        text: 0
        font: verdana-11px-rounded
        color: #c0c0c0
        text-auto-resize: true

    Panel
      id: lockPrey
      size: 176 22
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 3
      image-source: /images/ui/1pixel-down-frame
      image-border: 3

      CheckBox
        id: lockPreyCheck
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: parent.left
        margin-top: 2
        margin-left: 5
        image-source: /images/ui/checkbox
        image-border: 1
        size: 155 15
        font: verdana-11px-rounded
        color: #c0c0c0
        text: Lock Prey
        text-offset: 15 -3
        change-cursor-image: false
        @onHoverChange: modules.game_prey.onHover(self)
        $hover !disabled
          color: #c0c0c0

    Panel
      id: lockPreyPrice
      size: 26 22
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 3
      image-source: /images/ui/button-verydarkgrey-down
      image-border: 3
      image-clip: 0 0 98 40

      UIWidget
        id: cards
        anchors.top: parent.top
        anchors.right: parent.right
        margin-top: 6
        margin-right: 3
        image-source: /images/game/prey/prey-wildcards-icon
        tooltip: Prey Wildcards

      UIWidget
        id: text
        anchors.top: parent.top
        anchors.right: prev.left
        margin-top: 4
        margin-right: 2
        text: 0
        font: verdana-11px-rounded
        color: #c0c0c0
        text-auto-resize: true

