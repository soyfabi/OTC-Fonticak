  &type: 'prey'
  &save: true
  @onOpen: modules.game_prey.onPreyTrackerWindowOpen()
  @onClose: modules.game_prey.onPreyTrackerWindowClose()
  @onSetup: |
    do
      for _, id in ipairs({ 'newWindowButton', 'contextMenuButton', 'toggleFilterButton' }) do
        local w = self:recursiveGetChildById(id)
        if w then
          w:setVisible(false)
          w:setOn(false)
        end
      end

      -- Move the lock button right next to the minimize button.
      local lockButton = self:recursiveGetChildById('lockButton')
      local minimizeButton = self:recursiveGetChildById('minimizeButton')
      if lockButton and minimizeButton then
        lockButton:breakAnchors()
        lockButton:addAnchor(AnchorTop, minimizeButton:getId(), AnchorTop)
        lockButton:addAnchor(AnchorRight, minimizeButton:getId(), AnchorLeft)
        lockButton:setMarginRight(1)
        lockButton:setMarginTop(0)
        lockButton:setVisible(true)
        lockButton:setOn(false)
      end
    end

  UIWidget
    id: miniwindowIcon
    anchors.top: miniwindowHeader.top
    anchors.left: miniwindowHeader.left
    margin-top: 2
    margin-left: 4
    size: 12 12
    image-source: /images/icons/icon-prey-widget
    image-smooth: false

  Label
    id: miniwindowTitle
    anchors.top: miniwindowHeader.top
    anchors.left: miniwindowHeader.left
    anchors.right: miniwindowHeader.right
    margin-top: 1
    margin-left: 20
    margin-right: 50
    font: verdana-11px-monochrome
    height: 13
    !text: tr('Kill Tracker')
    color: #9d9d9dff

  MiniWindowContents
    id: contentsPanel
    anchors.top: miniwindowTopBar.bottom
    anchors.left: parent.left
    anchors.right: miniwindowScrollBar.left
    anchors.bottom: parent.bottom
    margin-left: 3
    margin-top: -2
    margin-right: 1
    vertical-scrollbar: miniwindowScrollBar
    padding-left: 3
    padding-right: 3
    padding-bottom: 3
    layout: verticalBox

    Label
      !text: tr('Prey Creatures')
      font: verdana-11px-rounded
      color: #c0c0c0
      margin-top: 2
      margin-left: 1

    HorizontalSeparator
      margin-top: 1
      margin-bottom: 4

    PreyCreatureTrack
      id: slot1
      margin-left: 2
      visible: true

    PreyCreatureTrack
      id: slot2
      margin-top: 2
      margin-left: 2
      visible: true

    PreyCreatureTrack
      id: slot3
      margin-top: 2
      margin-left: 2
      visible: false

    Label
      !text: tr('Bounty Task')
      font: verdana-11px-rounded
      color: #c0c0c0
      margin-top: 13

    HorizontalSeparator
      margin-top: 2
      margin-bottom: 3

    BountyTaskWidget
      id: bslot1
      margin-top: 1
      margin-left: 2
      @onClick: TaskBoard:toggleWindow('bounty')

    Label
      !text: tr('Weekly Tasks')
      font: verdana-11px-rounded
      color: #c0c0c0
      margin-top: 13

    HorizontalSeparator
      margin-top: 2
      margin-bottom: 4

    WeeklyTasksWidget
      id: wslot1
      margin-left: 2
    
    WeeklyTasksWidget
      id: wslot2
      margin-top: 2
      margin-left: 2
      visible: false

    WeeklyTasksWidget
      id: wslot3
      margin-top: 2
      margin-left: 2
      visible: false

    WeeklyTasksWidget
      id: wslot4
      margin-top: 2
      margin-left: 2
      visible: false

    WeeklyTasksWidget
      id: wslot5
      margin-top: 2
      margin-left: 2
      visible: false

    WeeklyTasksWidget
      id: wslot6
      margin-top: 2
      margin-left: 2
      visible: false
    
    WeeklyTasksWidget
      id: wslot7
      margin-top: 2
      margin-left: 2
      visible: false

    WeeklyTasksWidget
      id: wslot8
      margin-top: 2
      margin-left: 2
      visible: false

    WeeklyTasksWidget
      id: wslot9
      margin-top: 2
      margin-left: 2
      visible: false

  UIWidget
    id: miniborder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    image-source: /images/ui/miniborder-bottom-left
    size: 14 14
    margin-left: 3
    margin-bottom: 3
