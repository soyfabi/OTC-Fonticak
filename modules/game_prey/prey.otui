  height: 15

NewMainWindow
  id: preyWindow
  !text: tr('Prey')
  draggable: true
  font: verdana-11px-monochrome
  text-offset: 0 2
  size: 698 563
  @onEscape: modules.game_prey.hide(true)
  @onHoverChange: modules.game_prey.onHover(self)

  Panel
    id: optionsTabBar
    size: 666 36
    image-source: /images/ui/back-icons
