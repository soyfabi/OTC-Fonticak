Star < UIWidget
  size: 9 10
  image-source: /images/game/prey/prey_star

NoStar < UIWidget
  size: 9 10
  image-source: /images/game/prey/prey_nostar

WildcardLabel < UIWidget
  size: 191 16
  font: verdana-11px-rounded
  color: #c0c0c0
  text-auto-resize: true
  phantom: false
  text-offset: 0 0
  $focus:
    color: #f4f4f4

  UIWidget
    id: icon
    size: 18 18
    image-source: /images/game/prey/prey-noprey-small
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 2
    visible: false

WildcardPreyPanel < Panel
  size: 195 312
  Panel
    id: monsterListFrame
    height: 177
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    image-source: /images/ui/1pixel-down-frame
    image-border: 3
    border-width: 0
    background-color: #404040

    TextList
      id: monsterList
      vertical-scrollbar: monsterListScrollBar
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin-right: 12
      keep-scroll-range: true
      background-color: alpha
      border-width: 0
      @onSetup: |
        g_keyboard.bindKeyPress('Up', function() focusPrevWildcardLabel(self) end, self)
        g_keyboard.bindKeyPress('Down', function() focusNextWildcardLabel(self) end, self)
      layout
        type: grid
        num-columns: 1
        cell-size: 191 16

    VerticalQtScrollBar
      id: monsterListScrollBar
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      step: 16
      pixels-scroll: true
      margin: 1 1 1 0

  TextEdit
    id: searchText
    size: 205 21
    !placeholder: tr('Type to search')
    placeholder-color: #707070
    color: #c0c0c0
    padding: 3 4 2 5
    anchors.top: monsterListFrame.bottom
    anchors.right: parent.right
    anchors.left: parent.left
    margin-top: 6
    @onTextChange: onTextEdit(self)

  OnePixelDownFrame
    id: panel
    size: 134 92
    margin-top: 6
    anchors.top: prev.bottom
    anchors.left: parent.left
    phantom: false
    UICreature
      id: creature
      anchors.verticalCenter: parent.verticalCenter
      anchors.horizontalCenter: parent.horizontalCenter
      size: 94 94
      fixed-creature-size: true
      base-scale: true
      phantom: true

  ChoosePrey
    id: choose
    size: 66 92
    anchors.right: parent.right
    anchors.top: prev.top

LockedPreyPanel < Panel
  size: 223 340
  NoCreaturePanel
    id: noCreature
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right

  UIButton
    id: perm
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 64
    margin-top: 8
    @onClick: modules.game_store.toggle()

    UIWidget
      id: shopPermButton
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter
      image-source: /images/game/prey/button-get-permanent-slot
      size: 205 67
      image-clip: 0 0 205 67
      @onClick: modules.game_prey.storeRedirect(0)
      @onHoverChange: modules.game_prey.onHover(self)

      $pressed:
        image-clip: 0 67 205 67

CreatureAndBonus < Panel
  size: 205 156
  UIWidget
    id: panel
    phantom: true
    anchors.top: parent.top
    anchors.left: parent.left
    image-source: /images/ui/1pixel-down-frame
    image-border: 3
    size: 134 134
    margin-top: 1

  UICreature
    id: creature
    phantom: true
    anchors.verticalCenter: panel.verticalCenter
    anchors.horizontalCenter: panel.horizontalCenter
    size: 128 128
    fixed-creature-size: true
    base-scale: true

  UIWidget
    id: bonus
    phantom: true
    anchors.top: parent.top
    anchors.left: panel.right
    image-source: /images/ui/1pixel-down-frame
    image-border: 3
    size: 66 134
    margin-left: 6
    margin-top: 1

    UIWidget
      id: icon
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      image-source: /images/game/prey/prey-bonus-none
      margin-top: 6

    HorizontalSeparator
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      margin-left: 10
      margin-right: 10

    Panel
      id: grade
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 5
      margin-left: 7
      layout:
        type: grid
        cell-size: 9 10
        cell-spacing: 2
        num-columns: 5

  Panel
    anchors.top: prev.bottom
    margin-top: 3
    anchors.left: parent.left
    anchors.right: parent.right
    size: 205 20
    image-source: /images/ui/button-verydarkgrey-down
    image-border: 3
    image-clip: 0 0 98 40
  ProgressBarSD
    id: timeLeft
    anchors.top: prev.top
    anchors.bottom: prev.bottom
    anchors.left: prev.left
    anchors.right: prev.right
    margin: 1 1 1 1
    size: 203 18
    image-source: /images/bars/progressbar-orange-large
  Label
    id: textLabel
    anchors.top: prev.top
    anchors.horizontalCenter: parent.horizontalCenter
    text-align: center
    font: verdana-11px-rounded
    color: #c0c0c0
    text-auto-resize: true
    margin-top: 2

  UIWidget
    id: activeInfoHover
    anchors.fill: parent
    focusable: false
    opacity: 0.01

