    margin-top: 6
    margin-left: 12
    margin-right: 12
    text-wrap: true
    image-source: /images/ui/2pixel-up-frame-borderimage
    image-border: 3
    font: pVerdana Bold-11px
    color: #c0c0c0
    text-offset: 4 2

  HorizontalSeparator
    id: bottomSep
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: next.top
    margin-left: 12
    margin-right: 12
    margin-bottom: 11

  Button
    id: closeButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-bottom: 12
    margin-right: 12
    size: 43 20
    text: Close
    font: cipsoftFont
    color: #FFFFFF
    @onClick: modules.game_prey.hide(true)

  Panel
    id: gold
    size: 130 20
    anchors.left: bottomSep.left
    anchors.verticalCenter: closeButton.verticalCenter
