      @onHoverChange: modules.game_prey.onHover(self)
      $pressed:
        image-clip: 0 91 66 91
      $!on:
        image-clip: 0 182 66 91

BonusReroll < Panel
  size: 66 91
  Panel
    id: button
    size: 66 66
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    UIButton
      id: rerollBonus
      size: 66 66
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: prev.top
      image-source: /images/game/prey/button-prey-filled-bonus
      image-clip: 0 0 66 66
      @onHoverChange: modules.game_prey.onHover(self)
      $pressed:
        image-clip: 0 66 66 66
      $!on:
        image-clip: 0 132 66 66

  CardLabel
    id: price
    size: 66 20
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 3

RerollButtonFilled < Panel
  size: 66 91
  Panel
    id: button
    size: 66 66
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    UIButton
      id: rerollButton
      size: 66 66
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: prev.top
      image-source: /images/game/prey/button-prey-filled-reroll
      image-clip: 0 0 66 66
      @onMousePress: |
        if self:isOn() then
          self:getParent():recursiveGetChildById("time"):setMarginBottom(2)
          self:getParent():recursiveGetChildById("time"):setMarginLeft(4)
        end
      @onMouseRelease: |
        if self:isOn() then
          self:getParent():recursiveGetChildById("time"):setMarginBottom(3)
          self:getParent():recursiveGetChildById("time"):setMarginLeft(3)
        end
      $pressed:
        image-clip: 0 66 66 66
      $!on:
        image-clip: 0 132 66 66
      @onHoverChange: modules.game_prey.onHover(self)

    ProgressBarSD
      id: time
      size: 60 12
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      margin-bottom: 3
      margin-left: 3
      image-source: /images/bars/progressbar-orange-small
      color: #c0c0c0
      @onHoverChange: modules.game_prey.onHover(self)

      Label
        id: textLabel
        anchors.bottom: parent.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        text-align: center
        font: verdana-11px-rounded
        color: #c0c0c0
        text-auto-resize: true
        margin-bottom: -1

  GoldLabel
    id: price
    size: 66 20
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 3

SelectPreyCreatureFilled < Panel
  size: 65 88
  Panel
    id: button
    size: 65 66
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    UIButton
