      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: prev.top
      image-source: /images/game/prey/button-prey-filled-select
      image-clip: 0 0 65 66
      @onHoverChange: modules.game_prey.onHover(self)

      $pressed:
