      margin-right: 2
      text: 0
      font: verdana-11px-rounded
      color: #c0c0c0
      text-auto-resize: true
      tooltip-font: verdana-11px-rounded
      tooltip-delayed: true

  Panel
    size: 52 20
    id: wildCards
