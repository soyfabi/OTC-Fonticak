//Buttons
RerollButton < Panel
  size: 66 91
  Panel
    id: button
    size: 66 69
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    UIButton
      id: rerollButton
      size: 66 69
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: prev.top
      image-source: /images/game/prey/button-prey-empty-reroll
      image-clip: 0 0 66 69
      @onMousePress: |
        if self:isOn() then
          self:getParent():recursiveGetChildById("time"):setMarginBottom(2)
          self:getParent():recursiveGetChildById("time"):setMarginLeft(4)
        end
      @onMouseRelease: |
        if self:isOn() then
          self:getParent():recursiveGetChildById("time"):setMarginBottom(3)
          self:getParent():recursiveGetChildById("time"):setMarginLeft(3)
        end
      $pressed:
        image-clip: 0 69 66 69
      $!on:
        image-clip: 0 138 66 69
      @onHoverChange: modules.game_prey.onHover(self)

    ProgressBarSD
      id: time
      size: 60 12
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      margin-bottom: 3
      margin-left: 3
      image-source: /images/bars/progressbar-orange-small
      color: #c0c0c0
      @onHoverChange: modules.game_prey.onHover(self)

      Label
        id: textLabel
        anchors.bottom: parent.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        text-align: center
        font: verdana-11px-rounded
        color: #c0c0c0
        text-auto-resize: true
        margin-bottom: -1

  GoldLabel
    id: price
    size: 66 20
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 3

