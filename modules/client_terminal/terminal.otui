TerminalLabel < UILabel
  font: Verdana-10px-antialiased
  text-wrap: true
  text-auto-resize: true
  phantom: true

TerminalSelectText < UITextEdit
  font: Verdana-10px-antialiased
  text-wrap: true
  text-align: bottomLeft
  editable: false
  change-cursor-image: false
  cursor-visible: false
  selection-color: black
  selection-background-color: white
  color: alpha
  focusable: false
  auto-scroll: false

TerminalShortcutButton < UIButton
  font: Verdana-10px-antialiased
  color: white
  size: 44 18
  text-offset: 0 1
  background-color: #1b2b3dcc
  border: 1 #007acc88
  border-radius: 3
  change-cursor-image: true
  cursor: pointer

  $hover:
    background-color: #24507acc
    border: 1 #36a3ffcc

  $pressed:
    background-color: #0d2238dd
    text-offset: 1 2

UIWindow
  id: terminalWindow
  background-color: #0f0f1a
  opacity: 0.95
  border-radius: 6
  padding: 6
  anchors.fill: parent
  clipping: true
  $on:
    border: 1 #13d644cc

  Label
    id: titleBar
    !text: tr('Terminal')
    font: Verdana Bold-11px
    border: 1 black
    color: white
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: closeButton.left
    margin-right: 3
    background-color: #ffffff11
    text-align: left
    text-offset: 4 0
    height: 18
    visible: false

  ScrollablePanel
    id: terminalBuffer
    focusable: false
    anchors.left: parent.left
    anchors.right: terminalScroll.left
    anchors.top: terminalScroll.top
    anchors.bottom: commandTextEdit.top
    layout:
      type: verticalBox
      align-bottom: true
    vertical-scrollbar: terminalScroll
    inverted-scroll: true
    margin-left: 2

  TerminalSelectText
    id: terminalSelectText
    anchors.fill: terminalBuffer
    focusable: false

  VerticalScrollBar
    id: terminalScroll
    anchors.top: closeButton.bottom
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    step: 48
    pixels-scroll: true
    margin-top: 1

  UIButton
    id: closeButton
    !text: tr('X')
    !tooltip: tr('Close')
    font: Verdana Bold-11px
    color: #d0d0d0
    size: 22 18
    padding: 0
    text-align: center
    // Optical center: bold "X" glyph sits slightly right of geometric center.
    text-offset: -1 0
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 0
    margin-right: 0
    background-color: #1b2b3dcc
    border: 1 #13d644aa
    border-radius: 3
    change-cursor-image: true
    cursor: pointer

    $hover:
      background-color: #6b1f1fcc
      border: 1 #ff5555cc
      color: #ffffff

    $pressed:
      background-color: #3a1010dd
      text-offset: 0 1

  UILabel
    id: commandSymbolLabel
    size: 12 14
    fixed-size: true
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-left: 2
    font: Verdana-10px-antialiased
    text: >

  TerminalShortcutButton
    id: clearShortcutButton
    !text: tr('Clear')
    anchors.bottom: parent.bottom
    anchors.right: terminalScroll.left
    margin-right: 3

  UITextEdit
    id: commandTextEdit
    background: #0055ff1a
    border-color: #007acc44
    &baseHeight: 14
    anchors.bottom: parent.bottom
    anchors.left: commandSymbolLabel.right
    anchors.right: clearShortcutButton.left
    margin-left: 1
    margin-right: 3
    padding-left: 2
    font: Verdana-10px-antialiased
    selection-color: black
    selection-background-color: white
    border-width-left: 0
    border-width-top: 0
    multiline: false

    $on:
      border-width-left: 1
      border-width-top: 1
      multiline: true

  ResizeBorder
    id: topResizeBorder
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    enabled: false

  ResizeBorder
    id: leftResizeBorder
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    enabled: false

  ResizeBorder
    id: bottomResizeBorder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    enabled: false

  ResizeBorder
    id: rightResizeBorder
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    enabled: false
