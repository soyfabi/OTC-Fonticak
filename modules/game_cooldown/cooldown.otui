SpellGroupIcon < UIWidget
  size: 22 24
  image-size: 22 24
  image-source: /images/game/spells/slot-mini-spellicon
  focusable: false
  &groupId: 0
  @onSetup: |
    if self.groupId and self.groupId > 0 then
      local icon = self:getChildById('icon')
      if icon then
        local clip = Spells.getSpellGroupIconClip(self.groupId)
        if clip then
          icon:setImageClip(clip)
        end
      end
    end

  UIWidget
    id: icon
    size: 20 20
    image-size: 20 20
    image-source: /images/game/spells/spellgroup-icons-20x20
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.verticalCenter: parent.verticalCenter
    margin-top: -1
    phantom: true
    focusable: false

  Panel
    id: disabledOverlay
    size: 20 20
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.verticalCenter: parent.verticalCenter
    margin-top: -1
    background-color: #000000
    opacity: 0.7
    visible: true
    phantom: true
    focusable: false

SpellIcon < UIWidget
  size: 22 24
  image-size: 22 24
  image-source: /images/game/spells/slot-mini-spellicon
  focusable: false

  UIWidget
    id: icon
    size: 20 20
    image-size: 20 20
    image-source: /images/game/spells/spell-icons-20x20
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.verticalCenter: parent.verticalCenter
    margin-top: -1
    phantom: true
    focusable: false

  Panel
    id: disabledOverlay
    size: 20 20
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.verticalCenter: parent.verticalCenter
    margin-top: -1
    background-color: #000000
    opacity: 0.7
    visible: false
    phantom: true
    focusable: false

SpellProgressRect < UIProgressRect
  background: #FFFFFF00
  percent: 100
  focusable: false
  phantom: true

  Panel
    id: cooldownFillBar
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    height: 2
    width: 0
    visible: false
    margin-left: 1
    margin-bottom: 1
    background-color: #FFFFFFFF
    focusable: false
    phantom: true

SpellSeparator < UIWidget
  size: 2 24
  image-size: 2 24
  image-source: /images/game/spells/spell-separator
  focusable: false

GroupCooldownParticles < UIParticles
  effect: groupcooldown-effect

Panel
  id: cooldownWindow
  !text: tr('')
  height: 26
  margin-top: 1
  focusable: false
  phantom: true

  Panel
    id:contentsPanel2
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 24
    margin-left: 2

    SpellGroupIcon
      id: groupIconAttack
      &groupId: 1
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      margin-left: 1
      !tooltip: tr('Attack')

    SpellProgressRect
      id: progressRectAttack
      anchors.fill: groupIconAttack

    SpellGroupIcon
      id: groupIconHealing
      &groupId: 2
      anchors.bottom: parent.bottom
      anchors.left: groupIconAttack.right
      margin-left: 4
      !tooltip: tr('Healing')

    SpellProgressRect
      id: progressRectHealing
      anchors.fill: groupIconHealing

    SpellGroupIcon
      id: groupIconSupport
      &groupId: 3
      anchors.bottom: parent.bottom
      anchors.left: groupIconHealing.right
      margin-left: 4
      !tooltip: tr('Support')

    SpellProgressRect
      id: progressRectSupport
      anchors.fill: groupIconSupport

    SpellGroupIcon
      id: groupIconSpecial
      &groupId: 4
      anchors.bottom: parent.bottom
      anchors.left: groupIconSupport.right
      margin-left: 4
      !tooltip: tr('Special')

    SpellProgressRect
      id: progressRectSpecial
      anchors.fill: groupIconSpecial

    SpellGroupIcon
      id: groupIconCrippling
      &groupId: 6
      anchors.bottom: parent.bottom
      anchors.left: groupIconSpecial.right
      margin-left: 4
      !tooltip: tr('Crippling')

    SpellProgressRect
      id: progressRectCrippling
      anchors.fill: groupIconCrippling

    SpellGroupIcon
      id: groupIconFocus
      &groupId: 7
      anchors.bottom: parent.bottom
      anchors.left: groupIconCrippling.right
      margin-left: 4
      !tooltip: tr('Focus')

    SpellProgressRect
      id: progressRectFocus
      anchors.fill: groupIconFocus

    Panel
      id: focusMasteryReadyGlow
      anchors.fill: groupIconFocus
      background-color: #c01818aa
      visible: false
      phantom: true
      focusable: false
      !tooltip: 'Focus Mastery ready (+35%% on next damage spell)'

    SpellGroupIcon
      id: groupIconUltimateStrikes
      &groupId: 8
      anchors.bottom: parent.bottom
      anchors.left: groupIconFocus.right
      margin-left: 4
      !tooltip: tr('Ultimate Strike')

    SpellProgressRect
      id: progressRectUltimateStrikes
      anchors.fill: groupIconUltimateStrikes

    SpellGroupIcon
      id: groupIconGreatBeams
      &groupId: 9
      anchors.bottom: parent.bottom
      anchors.left: groupIconUltimateStrikes.right
      margin-left: 4
      !tooltip: tr('Great Beams')

    SpellProgressRect
      id: progressRectGreatBeams
      anchors.fill: groupIconGreatBeams

    SpellGroupIcon
      id: groupIconBurstsOfNature
      &groupId: 10
      anchors.bottom: parent.bottom
      anchors.left: groupIconGreatBeams.right
      margin-left: 4
      !tooltip: tr('Bursts of Nature')

    SpellProgressRect
      id: progressRectBurstsOfNature
      anchors.fill: groupIconBurstsOfNature

    SpellGroupIcon
      id: groupIconVirtue
      &groupId: 11
      anchors.bottom: parent.bottom
      anchors.left: groupIconBurstsOfNature.right
      margin-left: 4
      !tooltip: tr('Stance')

    SpellProgressRect
      id: progressRectVirtue
      anchors.fill: groupIconVirtue

    SpellSeparator
      id: groupIconSeparator
      anchors.bottom: parent.bottom
      anchors.left: groupIconVirtue.right
      margin-left: 4

    Panel
      id: cooldownPanel
      height: 24
      anchors.bottom: parent.bottom
      anchors.left: groupIconSeparator.right
      anchors.right: parent.right
      margin-left: 4
      layout:
        type: horizontalBox
        spacing: 3
