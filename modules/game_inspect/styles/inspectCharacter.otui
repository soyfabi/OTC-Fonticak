InspectEquipSlot < UIWidget
  size: 66 66
  image-source: /images/ui/item
  phantom: false

InspectEquipItem < UIItem
  anchors.centerIn: parent
  size: 64 64
  fixed-item-size: false
  padding: 0
  image-source:
  virtual: true
  phantom: true
  focusable: false
  show-count: false

  UIWidget
    id: tier
    visible: false

  UIWidget
    id: bigtier
    size: 19 16
    image-source: /images/inventory/tiers-strip-big
    image-clip: 0 0 10 9
    image-size: 18 16
    anchors.top: parent.top
    anchors.right: parent.right
    margin-right: -1
    phantom: true
    focusable: false
    visible: false
    image-smooth: true

InspectEquipNeckSlot < InspectEquipSlot
  UIWidget
    id: slotIcon
    anchors.centerIn: parent
    size: 64 64
    image-source: /images/inventory/inventory_neck
    phantom: true

  InspectEquipItem
    id: equippedItem

InspectEquipHeadSlot < InspectEquipSlot
  UIWidget
    id: slotIcon
    anchors.centerIn: parent
    size: 64 64
    image-source: /images/inventory/inventory_head
    phantom: true

  InspectEquipItem
    id: equippedItem

InspectEquipBackSlot < InspectEquipSlot
  UIWidget
    id: slotIcon
    anchors.centerIn: parent
    size: 64 64
    image-source: /images/inventory/inventory_back
    phantom: true

  InspectEquipItem
    id: equippedItem

InspectEquipLeftSlot < InspectEquipSlot
  UIWidget
    id: slotIcon
    anchors.centerIn: parent
    size: 64 64
    image-source: /images/inventory/inventory_left_hand
    phantom: true

  InspectEquipItem
    id: equippedItem

InspectEquipRingSlot < InspectEquipSlot
  UIWidget
    id: slotIcon
    anchors.centerIn: parent
    size: 64 64
    image-source: /images/inventory/inventory_finger
    phantom: true

  InspectEquipItem
    id: equippedItem

InspectEquipBodySlot < InspectEquipSlot
  UIWidget
    id: slotIcon
    anchors.centerIn: parent
    size: 64 64
    image-source: /images/inventory/inventory_torso
    phantom: true

  InspectEquipItem
    id: equippedItem

InspectEquipLegSlot < InspectEquipSlot
  UIWidget
    id: slotIcon
    anchors.centerIn: parent
    size: 64 64
    image-source: /images/inventory/inventory_legs
    phantom: true

  InspectEquipItem
    id: equippedItem

InspectEquipFeetSlot < InspectEquipSlot
  UIWidget
    id: slotIcon
    anchors.centerIn: parent
    size: 64 64
    image-source: /images/inventory/inventory_feet
    phantom: true

  InspectEquipItem
    id: equippedItem

InspectEquipRightSlot < InspectEquipSlot
  UIWidget
    id: slotIcon
    anchors.centerIn: parent
    size: 64 64
    image-source: /images/inventory/inventory_right_hand
    phantom: true

