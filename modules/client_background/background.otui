Panel
  id: background
  image-source: /images/background
  image-smooth: false
  image-fixed-ratio: true
  anchors.top: parent.top
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.bottom: parent.bottom
  margin-top: 1
  focusable: false

  UIParticles
    id: particles
    effect: background-effect
    anchors.fill: parent
    phantom: true

  TerminalShortcutButton
    id: terminalShortcutButton
    !text: tr('Terminal')
    !tooltip: tr('Terminal') .. ' (Ctrl+T)'
    size: 64 18
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-left: 4
    margin-bottom: 2
    focusable: false
    @onClick: modules.client_terminal.toggle()