ModalDialogMessageLabel < Label
  font: Verdana Bold-11px-new
  color: #c0c0c0
  text-align: left
  text-wrap: true

ChoiceListLabel < Label
  height: 16
  font: Verdana Bold-11px-new
  color: #c0c0c0
  text-offset: 1 0
  focusable: true

ChoiceListLabelOdd < ChoiceListLabel
  background-color: #484848

  $focus:
    background-color: #585858
    color: #f4f4f4

  $!focus:
    background-color: #484848
    color: #c0c0c0

ChoiceListLabelEven < ChoiceListLabel
  background-color: #414141

  $focus:
    background-color: #585858
    color: #f4f4f4

  $!focus:
    background-color: #414141
    color: #c0c0c0

ChoiceList < TextList
  id: choiceList
  vertical-scrollbar: choiceScrollBar
  anchors.top: prev.bottom
  anchors.left: parent.left
  anchors.right: parent.right
  margin-top: 5
  margin-bottom: 16
  image-source: /images/ui/1pixel-down-frame
  image-border: 3
  border-width: 0
  background-color: #404040
  padding: 1
  auto-focus: none
  focusable: false
  visible: false

ChoiceScrollBar < VerticalQtScrollBar
  id: choiceScrollBar
  anchors.top: choiceList.top
  anchors.bottom: choiceList.bottom
  anchors.right: choiceList.right
  margin-top: 1
  margin-bottom: 1
  margin-right: 1
  step: 16
  pixels-scroll: true
  visible: false

ModalButton < Button
  size: 43 20
  fixed-size: true
  color: #ffffff
  text-offset: 0 1

ModalDialog < MainWindowHigh
  id: modalDialog
  font: Verdana Bold-11px-new
  color: #909090
  text-offset: 0 2
  size: 245 100
  padding-top: 30
  padding-left: 16
  padding-right: 16
  padding-bottom: 16
  &minimumWidth: 245
  &maximumWidth: 600
  &minimumChoices: 4
  &maximumChoices: 10

  ModalDialogMessageLabel
    id: messageLabel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: -1
    margin-right: -5

  ChoiceList

  HorizontalSeparator
    id: choiceSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: next.top
    margin-bottom: 11

  Panel
    id: buttonsPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 20
    layout: horizontalBox
      align-right: true

  ChoiceScrollBar
