&var-cip-font-new: Verdana Bold-11px-new

StashWindow < MainWindowHigh
  id: stashWindow
  !text: tr('Stash')
  size: 789 546
  text-offset: -1 1

  @onEscape: onSupplyStashClose()

  Panel
    id: supraPanel
    width: 164
    height: 22
    anchors.top: parent.top
    anchors.left: parent.left

  Panel
    id: mainTabContent
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    padding: 1
    border-width-top: 1
    border-width-left: 1
    border-width-right: 1
    border-width-bottom: 1
    border-color-bottom: #808080
    border-color-right: #808080
    border-color-left: #131313
    border-color-top: #131313
    margin-bottom: 42
    margin-top: 2

    VerticalQtScrollBar
      id: itemsPanelListScrollBar
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      step: 37
      
    ScrollablePanel
      id: itemsPanel
      anchors.left: parent.left
      anchors.right: prev.left
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      vertical-scrollbar: itemsPanelListScrollBar
      margin-left: 3
      padding-top: 3

      layout:
        type: grid
        cell-size: 34 34
        cell-spacing: 3
        flow: true
        auto-spacing: true

  Panel
    id: findSupply
    anchors.top: parent.top
    anchors.left: parent.left
    width: 757
    height: 21
    margin-top: -8

    Panel
      id: findSupply
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      width: 162
      height: 20

      TextEdit
        id: searchEdit
        anchors.fill: parent
        font: $var-cip-font-new
        placeholder: "Type to search"
        padding-left: 5
        padding-top: 2
        placeholder-color:#707068
        @onTextChange: modules.game_stash.onStashSearchTextChange()
   
      Button
        id: clearSearchButton
        width: 18
        height: 18
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 1
        icon: /images/ui/button-erase-18x18-up.png
        $pressed:
          icon: /images/ui/button-erase-18x18-down.png

        tooltip: Clear all text from the search field.
        z-index: 1
        @onClick: searchEdit:setText("")
      
    QtComboBox
      id: showFilterComboBox
      !text: tr('Show All')
      text-offset: -12 1
      menu-scroll: true
      menu-height: 400
      menu-scroll-step: 20
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      width: 190
      height: 20
      margin-left: 167
      color: #c0c0c0
      @onOptionChange: modules.game_stash.onShowFilterOptionChange(self)
      @onSetup: |
        self:setCurrentOption(tr('Show All'))

    QtComboBox
      id: showTraderNpc
      menu-scroll: true
      menu-height: 400
      menu-scroll-step: 20
      !text: tr('No Trader Selected')
      text-offset: -11 1
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      width: 190
      height: 20
      margin-left: 362
      color: #c0c0c0
      @onOptionChange: modules.game_stash.onShowTraderNpcOptionChange(self)
      @onSetup: |
        self:addOption(tr('No Trader Selected'))
        self:addOption(tr('Sell to Alaistar'))
        self:addOption(tr('Sell to Alesar'))
        self:addOption(tr('Sell to Alexander'))
        self:addOption(tr('Sell to Arkulius'))
        self:addOption(tr('Sell to Asnarus'))
        self:addOption(tr('Sell to Asphota'))
        self:addOption(tr('Sell to Augustin'))
        self:addOption(tr('Sell to Avan'))
        self:addOption(tr('Sell to Brengus'))
        self:addOption(tr('Sell to Chondur'))
        self:addOption(tr('Sell to Dal the Huntress'))
        self:addOption(tr('Sell to Domizian'))
        self:addOption(tr('Sell to Esrik'))
        self:addOption(tr('Sell to Fadil'))
        self:addOption(tr('Sell to Fiona'))
        self:addOption(tr('Sell to Flint'))
        self:addOption(tr('Sell to Gladys'))
        self:addOption(tr('Sell to Gnomission'))
        self:addOption(tr('Sell to Grizzly Adams'))
        self:addOption(tr('Sell to Haroun'))
        self:addOption(tr('Sell to Inigo'))
        self:addOption(tr('Sell to Irmana'))
        self:addOption(tr('Sell to Khanna'))
        self:addOption(tr('Sell to Kiru'))
        self:addOption(tr('Sell to Lailene'))
        self:addOption(tr('Sell to Luna'))
        self:addOption(tr('Sell to Malunga'))
        self:addOption(tr('Sell to Mugruu'))
        self:addOption(tr('Sell to Nah\'bob'))
        self:addOption(tr('Sell to Rafzan'))
        self:addOption(tr('Sell to Rashid'))
        self:addOption(tr('Sell to Rock in a Hard Place'))
        self:addOption(tr('Sell to Tallia'))
        self:addOption(tr('Sell to Tamoril'))
        self:addOption(tr('Sell to Tamru'))
        self:addOption(tr('Sell to Tarun'))
        self:addOption(tr('Sell to Telas'))
        self:addOption(tr('Sell to Tothdral'))
        self:addOption(tr('Sell to Valindara'))
        self:addOption(tr('Sell to Yaman'))
        self:addOption(tr('Sell to Yasir'))
        self:setCurrentOption(tr('No Trader Selected'))
        
    QtComboBox
      id: showOrganize
      !text: tr('Name (A-Z)')
      text-offset: -11 1
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      width: 190
      height: 20
      margin-left: 567
      color:#c0c0c0
      @onOptionChange: modules.game_stash.onShowOrganizeOptionChange(self)

  HorizontalSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: mainTabContent.bottom
    margin-top: 11

  Panel
    id: buttonsContainer
    anchors.top: prev.bottom
    anchors.left: mainTabContent.left
    anchors.right: mainTabContent.right
    margin-top: 11
    height: 20

    Button
      id: manageContainer
      !text: tr('Manage Containers')
      text-offset: 0 0
      anchors.left: parent.left
      height: 20
      width: 128
      @onClick: |
        modules.game_quickloot.QuickLoot.toggle()
        onSupplyStashClose()

    Button
      id: closeButton
      !text: tr('Close')
      text-offset: 0 0
      anchors.right: parent.right
      height: 20
      width: 43
      @onClick: onSupplyStashClose()

StashSelectAmount < MainWindowHigh
  id: stashSelectAmount
  !text: tr('Retrieve Items')
  size: 245 143
  text-offset: 0 0

  ContainerItemSlot
    id: itemSlot
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: -7
    focusable: false

  Label
    id: infoLabel
    anchors.left: itemSlot.right
    anchors.top: parent.top
    anchors.right: parent.right
    margin-left: 8
    margin-top: -10
    width: 165
    height: 32
    color: #c0c0c0
    text-align: left
    text-wrap: true
    !text: tr('Set or type the number of items you want to retrieve')

  HorizontalQtScrollBar
    id: countScrollBar
    anchors.left: itemSlot.right
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-left: 11
    margin-top: 16
    focusable: false
    default-scroll: true

  HorizontalSeparator
    anchors.bottom: next.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 11

  Button
    id: buttonCancel
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    size: 43 20
    !text: tr('Cancel')

  Button
    id: buttonOk
    anchors.right: prev.left
    anchors.bottom: parent.bottom
    margin-right: 6
    size: 43 20
    !text: tr('Ok')

