        !text: tr('Food')
        color: #C0C0C0
      SkillValueLabel
        color: #C0C0C0

    CharacterSkillBase
      id: stamina
      anchors.top: food.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-left: 4
      margin-right: 6
      SkillNameLabel
        !text: tr('Stamina')
        color: #C0C0C0
      SkillValueLabel
        color: #C0C0C0
      SkillCharacterPercentPanel
        background-color: green

    CharacterSkillBase
      id: trainer
      anchors.top: stamina.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-left: 4
      margin-right: 6
      margin-top: 12
      SkillNameLabel
        !text: tr('Offline Training')
        color: #C0C0C0
      SkillValueLabel
        color: #C0C0C0
      SkillCharacterPercentPanel
        background-color: #C00000

    HorizontalSeparator
      id: leftSeparator2
      visible: false
      anchors.top: trainer.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-left: 5
      margin-right: 6
      margin-top: 17

    CharacterSkillBase
      id: accountStatus
      visible: false
      anchors.top: leftSeparator2.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-left: 4
      margin-right: 6
      margin-top: 11
      SkillNameLabel
        !text: tr('Account Status:')
        color: #C0C0C0
      SkillValueLabel
        !text: tr('Premium')
        color: #C0C0C0

    CharacterSkillBase
      id: accountOnline
      visible: false
      anchors.top: accountStatus.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-left: 4
      margin-right: 6
      SkillNameLabel
        !text: tr('Account Online:')
        color: #C0C0C0
      SkillValueLabel
        !text: tr('Online')
        color: #C0C0C0

    CharacterSkillBase
      id: loyaltyTitle
      visible: false
      anchors.top: accountOnline.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-left: 4
      margin-right: 6
      SkillNameLabel
        !text: tr('Loyalty Title:')
        color: #C0C0C0
      SkillValueLabel
        !text: tr('None')
        color: #C0C0C0

    Label
      id: skillsLabel
      !text: tr('Skills')
      font: verdana-11px-antialised
      color: #C0C0C0
      anchors.top: level.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-left: 123

    CharacterSkillBase
      id: magiclevel
