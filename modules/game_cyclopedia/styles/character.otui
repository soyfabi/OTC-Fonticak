  Panel
    id: offencePanel
    size: 494 415
    anchors.top: CharacterBase.top
    anchors.left: CharacterBase.right
    margin-left: 11
    visible: false
    image-source: /images/ui/1pixel-down-frame
    image-border: 1
    padding: 10

    Label
      id: offenceTitle
      anchors.top: parent.top
      anchors.left: parent.left
      font: verdana-11px-antialised
      color: #dfdfdf
      text-auto-resize: true
      !text: tr('Offence Stats')

    HorizontalSeparator
      id: offenceSeparator
      anchors.top: offenceTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      margin-bottom: 6

    Panel
      id: offenceRows
      anchors.top: offenceSeparator.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 360
      margin-top: 2
      layout:
        type: verticalBox

      CharacterOffenceRow
        id: flatDamageRow
        CharacterStatNameLabel
          !text: tr('Flat Damage and Healing')
      CharacterOffenceRow
        id: attackValueRow
        CharacterStatNameLabel
          !text: tr('Attack Value')
      CharacterOffenceRow
        id: convertedDamageRow
        visible: false
        CharacterStatNameLabel
          !text: tr('Converted Damage')
      CharacterOffenceRow
        id: lifeLeechRow
        visible: false
        CharacterStatNameLabel
          !text: tr('Life Leech')
      CharacterOffenceRow
        id: manaLeechRow
        visible: false
        CharacterStatNameLabel
          !text: tr('Mana Leech')
      CharacterOffenceRow
        id: lifeGainOnHitRow
        visible: false
        CharacterStatNameLabel
          !text: tr('Life Gain on Hit')
      CharacterOffenceRow
        id: lifeGainOnKillRow
        visible: false
        CharacterStatNameLabel
          !text: tr('Life Gain on Kill')
      CharacterOffenceRow
        id: manaGainOnHitRow
        visible: false
        CharacterStatNameLabel
          !text: tr('Mana Gain on Hit')
      CharacterOffenceRow
        id: manaGainOnKillRow
        visible: false
        CharacterStatNameLabel
          !text: tr('Mana Gain on Kill')
      CharacterOffenceRow
        id: criticalChanceRow
        visible: false
        CharacterStatNameLabel
          !text: tr('Critical Hit Chance')
      CharacterOffenceSubRow
        id: criticalChanceProficiencyRow
        visible: false
        CharacterStatSubNameLabel
          !text: tr('from Weapon Proficiency')
      CharacterOffenceRow
        id: criticalDamageRow
        visible: false
        CharacterStatNameLabel
          !text: tr('Critical Extra Damage')
      CharacterOffenceSubRow
        id: criticalDamageProficiencyRow
        visible: false
        CharacterStatSubNameLabel
          !text: tr('from Weapon Proficiency')

  HorizontalSeparator
    id: characterBottomSeparator
    anchors.bottom: closeButton.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 12

  Button
    id: closeButton
    size: 43 20
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-bottom: 2
    margin-right: 2
    image-source: /game_cyclopedia/images/ui/close-button
    image-clip: 0 0 43 20
    image-border: 1
    @onClick: modules.game_cyclopedia.toggle()

    $pressed:
      image-clip: 0 20 43 20

  Button
    id: backButton
    size: 43 20
    anchors.bottom: parent.bottom
    anchors.right: closeButton.left
    margin-bottom: 2
    margin-right: 6
    image-source: /game_cyclopedia/images/ui/back-button
    image-clip: 0 0 43 20
    image-border: 1
    @onClick: modules.game_cyclopedia.onCharacterBack()

    $pressed:
      image-clip: 0 20 43 20
