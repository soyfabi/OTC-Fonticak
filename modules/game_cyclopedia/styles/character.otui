      SkillValueLabel
      SkillCharacterIcon
        anchors.left: parent.left
        margin-left: 1
        image-clip: 0 0 9 9
      SkillCharacterPercentPanel
        anchors.left: icon.right
        margin-top: 15
        margin-left: 6
        background-color: #00C000

