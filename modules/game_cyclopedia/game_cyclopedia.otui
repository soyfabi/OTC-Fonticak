RoundButton < UIWidget
  anchors.top: parent.top
  anchors.left: parent.left
  image-source: /images/modern_ui/round

SpecialLabel < UIButton
  font: verdana-11px-antialised
  width: 100
  color: #dfdfdfff
  opacity: 1.0

BarButton2 < UIButton
  color: #dfdfdfff
  size: 147 34
  text-offset: 0 0
  image-color: #dfdfdf
  image-clip: 0 0 147 34
  image-border: 3
  padding: 0 0 147 34
  opacity: 1.0

  $pressed:
    image-clip: 0 34 147 34

  $checked:
    image-clip: 0 34 147 34

  $disabled:
    color: #dfdfdf88
    opacity: 0.8

CompendiumButton < UIButton
  font: verdana-11px-antialised
  color: #dfdfdfff
  size: 106 23
  text-offset: 0 0
  image-source: /images/modern_ui/button
  image-color: #dfdfdf
  image-clip: 0 0 22 23
  image-border: 3
  padding: 5 10 5 10
  opacity: 1.0

  $hover !disabled:
    image-clip: 0 23 22 23

  $pressed:
    image-clip: 0 46 22 23
    text-offset: 1 1

  $disabled:
    color: #dfdfdf88
    opacity: 0.8

CyclopediaWindow < UIWindow
  anchors.centerIn: parent
  font: verdana-11px-antialised
  size: 200 200
  opacity: 1
  color: #dfdfdf
  text-offset: 0 6
  text-align: top
  image-source: /images/modern_ui/window
  image-border: 6
  image-border-top: 27
  padding-top: 36
  padding-left: 16
  padding-right: 16
  padding-bottom: 16

  $disabled:
    color: #dfdfdf88

FlatLabel < UILabel
  font: verdana-11px-antialised
  color: #dfdfdf
  size: 86 20
  text-offset: 3 3
  image-source: /images/modern_ui/panel_flat
  image-border: 1

  $disabled:
    color: #dfdfdf88

CyclopediaWindow
  size: 700 538
  !text: tr('Cyclopedia')
  color: #909090
  visible: false
  @onEscape: toggle()

  UIWidget
    id: buttonSelection
    anchors.top: parent.top
    anchors.left: parent.left
    size: 668 36
    background-color: #404040
    border-width-top: 1
    border-color-top: black
    border-width-left: 1
    border-color-left: black
    border-width-bottom: 1
    border-color-bottom: #747474
    border-width-right: 1
    border-color-right: #747474

    UIButton
      id: items
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 1
      margin-left: 1
      @onClick: toggleWindow("items")

      $on:
        size: 150 34
        image-clip: 0 0 150 34
        image-source: /images/game/cyclopedia/items_on

      $on $disabled:
        size: 150 34
        image-clip: 0 0 150 34
        image-source: /images/game/cyclopedia/items_on

      $!on:
        size: 34 34
        image-clip: 0 0 34 34
        image-source: /images/game/cyclopedia/items_off

      $pressed:
        size: 34 34
        image-clip: 0 34 34 34
        image-source: /images/game/cyclopedia/items_off

    UIButton
      id: bestiary
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 1
      @onClick: toggleWindow("bestiary")

      $on:
        size: 150 34
        image-clip: 0 0 150 34
        image-source: /images/game/cyclopedia/bestiary_on

      $on $disabled:
        size: 150 34
        image-clip: 0 0 150 34
        image-source: /images/game/cyclopedia/bestiary_on

      $!on:
        size: 34 34
        image-clip: 0 0 34 34
        image-source: /images/game/cyclopedia/bestiary_off

      $pressed:
        size: 34 34
        image-clip: 0 34 34 34
        image-source: /images/game/cyclopedia/bestiary_off

    UIButton
      id: charms
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 1
      @onClick: toggleWindow("charms")

      $on:
        size: 150 34
        image-clip: 0 0 150 34
        image-source: /images/game/cyclopedia/charms_on

      $on $disabled:
        size: 150 34
        image-clip: 0 0 150 34
        image-source: /images/game/cyclopedia/charms_on

      $!on:
        size: 34 34
        image-clip: 0 0 34 34
        image-source: /images/game/cyclopedia/charms_off

      $pressed:
        size: 34 34
        image-clip: 0 34 34 34
        image-source: /images/game/cyclopedia/charms_off

    UIButton
      id: map
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 1
      @onClick: toggleWindow("map")

      $on:
        size: 150 34
        image-clip: 0 0 150 34
        image-source: /images/game/cyclopedia/map_on

      $!on:
        size: 34 34
        image-clip: 0 0 34 34
        image-source: /images/game/cyclopedia/map_off

      $pressed:
        size: 34 34
        image-clip: 0 34 34 34
        image-source: /images/game/cyclopedia/map_off

    UIButton
      id: houses
      visible: false
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 1
      @onClick: toggleWindow("houses")

      $on:
        size: 150 34
        image-clip: 0 0 150 34
        image-source: /images/game/cyclopedia/houses_on

      $!on:
        size: 34 34
        image-clip: 0 0 34 34
        image-source: /images/game/cyclopedia/houses_off

      $pressed:
        size: 34 34
        image-clip: 0 34 34 34
        image-source: /images/game/cyclopedia/houses_off

    UIButton
      id: character
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 1
      @onClick: toggleWindow("character")

      $on:
        size: 150 34
        image-clip: 0 0 150 34
        image-source: /images/game/cyclopedia/character_on

      $!on:
        size: 34 34
        image-clip: 0 0 34 34
        image-source: /images/game/cyclopedia/character_off

      $pressed:
        size: 34 34
        image-clip: 0 34 34 34
        image-source: /images/game/cyclopedia/character_off

  UIWidget
    id: contentContainer
    anchors.top: prev.bottom
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: -4
    clipping: true

  Button
    id: manageContainersButton
    size: 128 20
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    visible: false
    !text: tr('Manage Containers')
    font: verdana-11px-antialised
    color: #c0c0c0
    @onClick: |
      modules.game_cyclopedia.toggle()
      modules.game_quickloot.QuickLoot.toggle()

  Button
    id: closeButton
    size: 43 20
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    !text: tr('Close')
    font: cipsoftFont
    color: #dfdfdfff
    @onClick: toggle()

  Button
    id: backButton
    size: 43 20
    anchors.verticalCenter: closeButton.verticalCenter
    anchors.right: closeButton.left
    margin-right: 6
    !text: tr('Back')
    font: cipsoftFont
    color: #dfdfdfff
    enabled: false
    @onClick: toggleBack()

  UIWidget
    id: GoldBase
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-bottom: 4
    visible: false
    size: 342 20

    UIWidget
      id: goldPanel
      image-source: /images/modern_ui/image1015925
      image-border: 1
      size: 110 20
      anchors.bottom: parent.bottom
      anchors.left: parent.left

      UIWidget
        id: Icon
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        margin-bottom: 3
        margin-right: 3
        image-source: /images/modern_ui/gold
        !tooltip: tr("Gold Coins")

      Label
        id: Value
        anchors.bottom: parent.bottom
        anchors.right: Icon.left
        margin-bottom: 2
        margin-right: 5
        font: verdana-11px-monochrome
        text-align: right
        width: 85
        !text: tr('0')
        color: #BDBDBD

    UIWidget
      id: charmPanel
      image-source: /images/modern_ui/image1015925
      image-border: 1
      size: 110 20
      anchors.bottom: parent.bottom
      anchors.left: goldPanel.right
      margin-left: 6
      !tooltip: tr('Charm Points\n\nEarned by unlocking entries in the Bestiary.')

      UIWidget
        id: charmIcon
        image-source: /images/game/cyclopedia/ui/charm-points
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        margin-bottom: 3
        margin-right: 3

      Label
        id: charmPoints
        anchors.bottom: parent.bottom
        anchors.right: charmIcon.left
        margin-bottom: 2
        margin-right: 2
        font: verdana-11px-monochrome
        text-align: right
        width: 85
        !text: tr('0')
        color: #BDBDBD

    UIWidget
      id: echoesPanel
      image-source: /images/modern_ui/image1015925
      image-border: 1
      size: 110 20
      anchors.bottom: parent.bottom
      anchors.left: charmPanel.right
      margin-left: 6
      !tooltip: tr('Minor Charm Echoes\n\nEarned by unlocking or upgrading Major Charm and promoting your character.')

      UIWidget
        id: echoesIcon
        image-source: /images/game/cyclopedia/ui/minor-charm-echoes
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        margin-bottom: 3
        margin-right: 3

      Label
        id: echoesPoints
        anchors.bottom: parent.bottom
        anchors.right: echoesIcon.left
        margin-bottom: 2
        margin-right: 2
        font: verdana-11px-monochrome
        text-align: right
        width: 85
        !text: tr('0')
        color: #BDBDBD

  HorizontalSeparator
    id: horizontalSeparator
    anchors.bottom: closeButton.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 12