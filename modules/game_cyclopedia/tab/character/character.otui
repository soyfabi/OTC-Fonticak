&var-cip-font-new: Verdana Bold-11px-new
&var-cip-font-lowspace: Verdana Bold-11-px-lowspace

UIWidget
  id: Cat6
  anchors.fill: parent
  visible: false
  UIWidget
    id: CharacterBase
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 10
    image-source: /images/ui/popupwindow-sem-borda-interna
    image-border: 20
    size: 164 148
    font: $var-cip-font-new
    color: #929292
    text-offset: 0 0
    text-align: top
    !text: ''
    change-cursor-image: true
    cursor: pointer
    @onClick: modules.game_cyclopedia.Cyclopedia.selectCharacterPage()

    UIWidget
      id: nameHeader
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 20
      margin-top: 8
      margin-left: 8
      margin-right: 8
      image-source: /images/ui/2pixel-up-frame-borderimage-dark
      image-border: 3

      Label
        id: nameLabel
        anchors.centerIn: parent
        font: $var-cip-font-new
        text-auto-resize: true
        text-align: center
        color: #C1C1C1
        !text: tr('Player Name')

    UICreature
      id: Outfit
      size: 64 64
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: nameHeader.bottom
      anchors.bottom: infoFooter.top
      margin-top: 4
      margin-bottom: 2
      fixed-creature-size: true
      base-scale: true
      phantom: true

    UIWidget
      id: infoFooter
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      height: 28
      margin-left: 8
      margin-right: 8
      margin-bottom: 12

      Label
        id: InfoLabel
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.verticalCenter: parent.verticalCenter
        font: $var-cip-font-new
        !text: tr('Level 0\nVocation')
        text-auto-resize: true
        text-align: center
        color: #C1C1C1

    Label
      id: worldInfoLabel
      visible: false
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.bottom: Outfit.top
      font: $var-cip-font-new
      !text: tr('World')
      text-auto-resize: true
      text-align: center
      color: #C0C0C0
      margin-bottom: 2

  UIWidget
    id: OptionsBase
    anchors.left: CharacterBase.left
    anchors.top: CharacterBase.bottom
    anchors.bottom: parent.bottom
    margin-top: 6
    margin-bottom: 30
    image-source: /images/ui/2pixel_up_frame_borderimage_dark
    image-size: 164 278
    image-border: 10
    width: 170

  UIWidget
    id: InfoBase
    anchors.top: CharacterBase.top
    anchors.left: CharacterBase.right
    anchors.bottom: OptionsBase.bottom
    anchors.right: parent.right
    margin-left: 11
    margin-bottom: 7
    image-source: /images/ui/1pixel-down-frame
    image-border: 5

    Panel
      id: outfitPanel
      margin-left: -13
      margin-top: 5
      anchors.left: parent.left
      anchors.top: parent.top
      size: 140 140
      visible: false

      UICreature
        id: Sprite
        size: 128 128
        anchors.centerIn: parent
        fixed-creature-size: true
        base-scale: true
        creature-center: true
        ignore-displacement-shift: true
        phantom: true

    Panel
      id: inventoryPanel
      margin-left: -12
      margin-top: 5
      anchors.left: parent.left
      anchors.top: parent.top
      size: 140 140
      HeadSlot
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
      BodySlot
        anchors.top: prev.bottom
        anchors.horizontalCenter: prev.horizontalCenter
        margin-top: 3
      LegSlot
        anchors.top: prev.bottom
        anchors.horizontalCenter: prev.horizontalCenter
        margin-top: 3
      FeetSlot
        anchors.top: prev.bottom
        anchors.horizontalCenter: prev.horizontalCenter
        margin-top: 3
      NeckSlot
        anchors.top: slot1.top
        anchors.right: slot1.left
        margin-top: 18
        margin-right: 3
      LeftSlot
        anchors.top: prev.bottom
        anchors.horizontalCenter: prev.horizontalCenter
        margin-top: 3
      FingerSlot
        anchors.top: prev.bottom
        anchors.horizontalCenter: prev.horizontalCenter
        margin-top: 3
      BackSlot
        anchors.top: slot1.top
        anchors.left: slot1.right
        margin-top: 18
        margin-left: 3
      RightSlot
        anchors.top: prev.bottom
        anchors.horizontalCenter: prev.horizontalCenter
        margin-top: 3
      AmmoSlot
        anchors.top: prev.bottom
        anchors.horizontalCenter: prev.horizontalCenter
        margin-top: 3

    Button
      id: CharacterButton
      anchors.left: inventoryPanel.right
      anchors.top: parent.top
      margin-top: 5
      margin-left: -11
      size: 33 33
      icon-source: /game_cyclopedia/images/icon-playerdetails
      icon-offset: 0 0
      &state: 1
      @onClick: modules.game_cyclopedia.Cyclopedia.characterButton(self)

    Button
      id: WheelButton
      anchors.left: CharacterButton.right
      anchors.top: CharacterButton.top
      margin-left: 3
      size: 33 33
      icon-source: /game_cyclopedia/images/button_wheel
      icon-offset: 0 0
      @onClick: modules.game_cyclopedia.Cyclopedia.openWheelOfDestiny()
      $pressed:
        icon-offset: 1 1

    UIWidget
      id: DetailsBase
      anchors.top: inventoryPanel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 26
      margin-left: 5
      margin-right: 5
      margin-bottom: 5
      height: 140
      image-source: /images/ui/1pixel-down-frame
      image-border: 5
      background-color: #363636

      UIScrollArea
        id: List
        vertical-scrollbar: ListScrollbar
        anchors.fill: parent
        size: 200 60
        padding-left: 2
        padding-top: 7
        padding-bottom: 3
        padding-right: 15
        layout:
          type: verticalBox
          spacing: 0

        UIWidget
          !text: tr('Status: Loading, please wait...')
          color: #BEBEBE

      VerticalQtScrollBar
        id: ListScrollbar
        anchors.top: List.top
        anchors.right: List.right
        anchors.bottom: List.bottom
        margin: 1 1 1 0
        step: 80
        pixel-scroll: true

    Label
      id: InspectLabel
      anchors.bottom: DetailsBase.top
      anchors.left: DetailsBase.left
      margin-bottom: 6
      text-auto-resize: true
      font: $var-cip-font-new
      !text: tr('You are inspecting') .. ": " .. "Player Name"
      text-offset: -1 0
      color: #c0c0c0

  UIWidget
    id: CharacterStats
    size: 494 415
    anchors.top: CharacterBase.top
    anchors.left: CharacterBase.right
    margin-left: 11
    visible: false
    image-source: /images/ui/1pixel-down-frame
    image-border: 1

    VerticalSeparator
      id: separator
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      margin-top: 5
      margin-bottom: 5

    CharacterSkillBase
      id: level
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: separator.right
      margin-left: 4
      margin-right: 6
      SkillNameLabel
        !text: tr('Level')
        color: #C0C0C0
      SkillValueLabel
        color: #C0C0C0
      SkillCharacterPercentPanel
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 13
        margin-right: 2
        background-color: #C00000

    CharacterSkillBase
      id: experience
      anchors.top: level.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-left: 4
      margin-right: 6
      margin-top: 12
      SkillNameLabel
        !text: tr('Experience')
        color: #C0C0C0
      SkillValueLabel
        color: #C0C0C0

    CharacterSkillBase
      id: expGainRate
      anchors.top: experience.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-left: 4
      margin-right: 6
      SkillNameLabel
        !text: tr('XP Gain Rate')
        color: #C0C0C0
      SkillValueLabel
        color: #C0C0C0

    UIWidget
      id: xpBoostRow
      height: 14
      anchors.top: expGainRate.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-top: 3
      margin-left: 5
      margin-right: 6

      HorizontalSeparator
        id: xpBoostSeparator
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: parent.left
        anchors.right: parent.right

      UIWidget
        id: xpBoostButton
        visible: false
        image-source: /images/ui/button-storexp
        !tooltip: tr('Increase your experience gain with a temporary XP Boost!')
        tooltip-delayed: true
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.verticalCenter: parent.verticalCenter
        @onClick: modules.game_store.openPremiumBoost()
        $pressed:
          image-source: /images/ui/button-storexp-pressed

    CharacterSkillBase
      id: health
      anchors.top: xpBoostRow.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-left: 4
      margin-right: 6
      margin-top: 4
      SkillNameLabel
        !text: tr('Hit Points')
        color: #C0C0C0
      SkillValueLabel
        color: #C0C0C0

    CharacterSkillBase
      id: mana
      anchors.top: health.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-left: 4
      margin-right: 6
      SkillNameLabel
        !text: tr('Mana')
        color: #C0C0C0
      SkillValueLabel
        color: #C0C0C0

    CharacterSkillBase
      id: soul
      anchors.top: mana.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-left: 4
      margin-right: 6
      SkillNameLabel
        !text: tr('Soul Points')
        color: #C0C0C0
      SkillValueLabel
        color: #C0C0C0

    CharacterSkillBase
      id: capacity
      anchors.top: soul.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-left: 4
      margin-right: 6
      SkillNameLabel
        !text: tr('Capacity')
        color: #C0C0C0
      SkillValueLabel
        color: #C0C0C0

    CharacterSkillBase
      id: speed
      anchors.top: capacity.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-left: 4
      margin-right: 6
      SkillNameLabel
        !text: tr('Speed')
        color: #C0C0C0
      SkillValueLabel
        color: #C0C0C0

    CharacterSkillBase
      id: food
      anchors.top: speed.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-left: 4
      margin-right: 6
      SkillNameLabel
        !text: tr('Food')
        color: #C0C0C0
      SkillValueLabel
        color: #C0C0C0

    CharacterSkillBase
      id: stamina
      anchors.top: food.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-left: 4
      margin-right: 6
      SkillNameLabel
        !text: tr('Stamina')
        color: #C0C0C0
      SkillValueLabel
        color: #C0C0C0
      SkillCharacterPercentPanel
        background-color: green

    CharacterSkillBase
      id: trainer
      anchors.top: stamina.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-left: 4
      margin-right: 6
      margin-top: 12
      SkillNameLabel
        !text: tr('Offline Training')
        color: #C0C0C0
      SkillValueLabel
        color: #C0C0C0
      SkillCharacterPercentPanel
        background-color: #C00000

    HorizontalSeparator
      id: leftSeparator2
      anchors.top: trainer.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-left: 5
      margin-right: 6
      margin-top: 17

    CharacterSkillBase
      id: accountStatus
      anchors.top: leftSeparator2.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-left: 4
      margin-right: 6
      margin-top: 11
      SkillNameLabel
        !text: tr('Account Status:')
        color: #C0C0C0
      SkillValueLabel
        !text: tr('Premium')
        color: #C0C0C0

    CharacterSkillBase
      id: accountOnline
      anchors.top: accountStatus.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-left: 4
      margin-right: 6
      SkillNameLabel
        !text: tr('Account Online:')
        color: #C0C0C0
      SkillValueLabel
        !text: tr('Online')
        color: #C0C0C0

    CharacterSkillBase
      id: loyaltyTitle
      anchors.top: accountOnline.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-left: 4
      margin-right: 6
      SkillNameLabel
        !text: tr('Loyalty Title:')
        color: #C0C0C0
      SkillValueLabel
        !text: tr('None')
        color: #C0C0C0

    Label
      id: skillsLabel
      !text: tr('Skills')
      font: $var-cip-font-new
      color: #C0C0C0
      anchors.top: level.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-left: 123

    CharacterSkillBase
      id: magiclevel
      height: 25
      anchors.top: skillsLabel.bottom
      anchors.left: separator.left
      anchors.right: parent.right
      margin-top: 5
      CharacterOverviewSkillNameLabel
        !text: tr('Magic')
        color: #C0C0C0
      SkillValueLabel
      SkillCharacterIcon
        anchors.left: parent.left
        margin-left: 1
        image-clip: 27 0 9 9
      SkillCharacterPercentPanel
        anchors.left: icon.right
        margin-top: 15
        margin-left: 6
        margin-right: 2
        anchors.right: parent.right
        background-color: #00C000

    CharacterSkillBase
      id: skillId0
      height: 25
      anchors.top: magiclevel.bottom
      anchors.left: separator.left
      anchors.right: parent.right
      CharacterOverviewSkillNameLabel
        !text: tr('Fist')
        color: #C0C0C0
      SkillValueLabel
      SkillCharacterIcon
        anchors.left: parent.left
        margin-left: 1
        image-clip: 0 0 9 9
      SkillCharacterPercentPanel
        anchors.left: icon.right
        margin-top: 15
        margin-left: 6
        margin-right: 2
        anchors.right: parent.right
        background-color: #00C000

    CharacterSkillBase
      id: skillId1
      height: 25
      anchors.top: skillId0.bottom
      anchors.left: separator.left
      anchors.right: parent.right
      CharacterOverviewSkillNameLabel
        !text: tr('Club')
        color: #C0C0C0
      SkillValueLabel
      SkillCharacterIcon
        anchors.left: parent.left
        margin-left: 1
        image-clip: 45 0 9 9
      SkillCharacterPercentPanel
        anchors.left: icon.right
        margin-top: 15
        margin-left: 6
        margin-right: 2
        anchors.right: parent.right
        background-color: #00C000

    CharacterSkillBase
      id: skillId2
      height: 25
      anchors.top: skillId1.bottom
      anchors.left: separator.left
      anchors.right: parent.right
      CharacterOverviewSkillNameLabel
        !text: tr('Sword')
        color: #C0C0C0
      SkillValueLabel
      SkillCharacterIcon
        anchors.left: parent.left
        margin-left: 1
        image-clip: 36 0 9 9
      SkillCharacterPercentPanel
        anchors.left: icon.right
        margin-top: 15
        margin-left: 6
        margin-right: 2
        anchors.right: parent.right
        background-color: #00C000

    CharacterSkillBase
      id: skillId3
      height: 25
      anchors.top: skillId2.bottom
      anchors.left: separator.left
      anchors.right: parent.right
      CharacterOverviewSkillNameLabel
        !text: tr('Axe')
        color: #C0C0C0
      SkillValueLabel
      SkillCharacterIcon
        anchors.left: parent.left
        margin-left: 1
        image-clip: 54 0 9 9
      SkillCharacterPercentPanel
        anchors.left: icon.right
        margin-top: 15
        margin-left: 6
        margin-right: 2
        anchors.right: parent.right
        background-color: #00C000

    CharacterSkillBase
      id: skillId4
      height: 25
      anchors.top: skillId3.bottom
      anchors.left: separator.left
      anchors.right: parent.right
      CharacterOverviewSkillNameLabel
        !text: tr('Distance')
        color: #C0C0C0
      SkillValueLabel
      SkillCharacterIcon
        anchors.left: parent.left
        margin-left: 1
        image-clip: 18 0 9 9
      SkillCharacterPercentPanel
        anchors.left: icon.right
        margin-top: 15
        margin-left: 6
        margin-right: 2
        anchors.right: parent.right
        background-color: #00C000

    CharacterSkillBase
      id: skillId5
      height: 25
      anchors.top: skillId4.bottom
      anchors.left: separator.left
      anchors.right: parent.right
      CharacterOverviewSkillNameLabel
        !text: tr('Shielding')
        color: #C0C0C0
      SkillValueLabel
      SkillCharacterIcon
        anchors.left: parent.left
        margin-left: 1
        image-clip: 63 0 9 9
      SkillCharacterPercentPanel
        anchors.left: icon.right
        margin-top: 15
        margin-left: 6
        margin-right: 2
        anchors.right: parent.right
        background-color: #00C000

    CharacterSkillBase
      id: skillId6
      height: 25
      anchors.top: skillId5.bottom
      anchors.left: separator.left
      anchors.right: parent.right
      CharacterOverviewSkillNameLabel
        !text: tr('Fishing')
        color: #C0C0C0
      SkillValueLabel
      SkillCharacterIcon
        anchors.left: parent.left
        margin-left: 1
        image-clip: 72 0 9 9
      SkillCharacterPercentPanel
        anchors.left: icon.right
        margin-top: 15
        margin-left: 6
        margin-right: 2
        anchors.right: parent.right
        background-color: #00C000

    Label
      !text: tr('Account Badges')
      font: $var-cip-font-new
      color: #C0C0C0
      margin-top: 4
      anchors.top: skillId6.bottom
      anchors.left: separator.left
      anchors.right: parent.right
      margin-left: 72

    UIScrollArea
      id: ListBadge
      vertical-scrollbar: ListBadgeScrollbar
      size: 237 138
      anchors.top: prev.bottom
      anchors.left: separator.left
      margin-top: 5
      margin-left: 6
      image-source: /images/ui/1pixel-down-frame
      image-border: 1
      padding-top: 3
      padding-left: 6
      layout:
        type: grid
        cell-size: 64 64
        cell-spacing-height: 4
        cell-spacing-width: 10
        flow: true
        fit-children: false
        

    VerticalQtScrollBar
      id: ListBadgeScrollbar
      anchors.top: ListBadge.top
      anchors.right: ListBadge.right
      anchors.bottom: ListBadge.bottom
      margin: 1
      step: 5
      pixel-scroll: true

  BorderBox
    id: CombatStats
    anchors.top: CharacterBase.top
    anchors.left: CharacterBase.right
    anchors.bottom: OptionsBase.bottom
    anchors.right: parent.right
    margin-left: 10
    visible: false

    VerticalSeparator
      id: separator
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      margin-top: 5
      margin-bottom: 5
    CharacterSkillBase
      id: attack
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: separator.right
      margin-top: 5
      margin-left: 5
      SkillNameLabel
        !text: tr('Attack Value:')
        color: #C0C0C0
      SkillValueLabel
        color: #C0C0C0
        anchors.right: next.left
        margin-right: 8
        !text: ('100')
      SkillCharacterIcon
        margin-top: 2
        anchors.right: parent.right
    CharacterSkillBase
      id: converted
      anchors.top: attack.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-top: 0
      SkillNameLabel
        !text: tr('Converted Damage:')
        color: #C0C0C0
      SkillValueLabel
        id: none
        color: #C0C0C0
        !text: tr('None')
        margin-right: 2
        visible: false
      SkillValueLabel
        color: #C0C0C0
        anchors.right: next.left
        margin-right: 8
        !text: ('100')
      SkillCharacterIcon
        margin-top: 2
        anchors.right: parent.right
    CharacterSkillBase
      id: defence
      anchors.top: converted.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-top: 0
      SkillNameLabel
        !text: tr('Defence Value:')
        color: #C0C0C0
      SkillValueLabel
        color: #C0C0C0
        margin-right: 2
    CharacterSkillBase
      id: armor
      anchors.top: defence.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-top: 1
      SkillNameLabel
        !text: tr('Armor Value:')
        color: #C0C0C0
      SkillValueLabel
        color: #C0C0C0
        margin-right: 2
    CharacterSkillBase
      id: mitigation
      anchors.top: armor.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-top: 0
      SkillNameLabel
        !text: tr('Mitigation:')
        color: #C0C0C0
      SkillValueLabel
        color: #C0C0C0
        margin-right: 2
    CharacterSkillBase
      id: blessings
      anchors.top: mitigation.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-top: 1
      SkillNameLabel
        !text: tr('Blessings:')
        color: #C0C0C0
      SkillValueLabel
        color: #C0C0C0
        margin-right: 20
      UIButton
        id: blessButton
        size: 12 12
        anchors.top: parent.top
        anchors.right: parent.right
        margin-top: 1
        margin-right: 3
        image-clip: 0 0 12 12
        image-source: /images/inventory/button_blessings_grey
        @onClick: modules.game_blessing.toggle()
        $pressed:
          image-source: /images/inventory/button_blessings_grey
          image-clip: 12 0 12 12
        $on:
          image-source: /images/inventory/button_blessings_grey
          image-clip: 12 0 12 12
        $on pressed:
          image-source: /images/inventory/button_blessings_grey
          image-clip: 12 0 12 12
    CharacterSkillBase
      id: reduction
      anchors.top: blessings.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-top: 1
      SkillNameLabel
        !text: tr('Damage Reduction:')
        color: #C0C0C0
    Panel
      id: reductionNone
      anchors.top: reduction.bottom
      anchors.left: reduction.left
      anchors.right: separator.right
      margin-left: 10
      margin-top: 10
      size: 232 233
      layout:
        type: verticalBox
        fit-children: true
    HorizontalSeparator
      anchors.top: prev.bottom
      anchors.left: reduction.left
      anchors.right: separator.right
      margin-right: 10

    CharacterSkillBase
      id: concoction
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: separator.right
      margin-top: 1
      SkillNameLabel
        !text: tr('Concoctions:')
        color: #C0C0C0  
    CharacterSkillBase
      id: concoctionPanel
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: separator.right

      layout:
        type: grid
        cell-size: 32 32
        flow: true

    CharacterSkillBase
      id: criticalHit
      anchors.top: attack.top
      anchors.left: separator.left
      anchors.right: parent.right
      margin-top: 1
      SkillNameLabel
        !text: tr('Critical Hit:')
        color: #C0C0C0
    CharacterSkillBase
      id: criticalChance
      anchors.top: criticalHit.bottom
      anchors.left: separator.left
      anchors.right: parent.right
      margin-left: 15
      margin-top: 0
