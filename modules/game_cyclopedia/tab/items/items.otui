&var-cip-font: verdana-11px-antialised
&var-cip-font-new: Verdana Bold-11px

UIWidget
  id: Cat1
  anchors.fill: parent

  UILabel
    id: Categorylabel
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 10
    margin-left: -1
    !text: tr('Categories') .. ':' 
    font: $var-cip-font-new
    text-auto-resize: true
    color: #c0c0c0

  TextList
    id: CategoryList
    vertical-scrollbar: CategoryScrollbar
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 28
    image-source: /images/ui/1pixel-down-frame
    image-border: 5
    background-color: #363636
    border-width: 0
    size: 200 60
    padding-left: 1
    padding-top: 1
    padding-bottom: 1
    focusable: false
 
  VerticalQtScrollBar 
    id: CategoryScrollbar
    anchors.top: CategoryList.top
    anchors.right: CategoryList.right
    anchors.bottom: CategoryList.bottom
    margin-top: 1
    margin-right: 1
    margin-bottom: 1
    step: 10
    pixels-scroll: true

  VerticalSeparator
    id: MidSep
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom 
    margin-top: 10
    margin-bottom: 30
    margin-left: 210
 
  Button
    id: LevelButton
    size: 37 20
    anchors.left: parent.left
    anchors.top: CategoryList.bottom
    margin-top: 31
    margin-left: -1
    !text: tr("Level")
    font: verdana-11px-rounded
    color: #dfdfdfff
    @onClick: modules.game_cyclopedia.Cyclopedia.onItemsFilterButtonClick(self)

  Button
    id: VocationButton
    size: 37 20
    anchors.left: LevelButton.right
    anchors.top: LevelButton.top
    margin-left: 5
    !text: tr("Voc.")
    font: verdana-11px-rounded
    color: #dfdfdfff
    @onClick: modules.game_cyclopedia.Cyclopedia.onItemsFilterButtonClick(self)

  Button
    id: H1Button
    size: 37 20
    anchors.left: VocationButton.right
    anchors.top: LevelButton.top
    margin-left: 5
    !text: tr("1H")
    font: verdana-11px-rounded
    color: #dfdfdfff
    @onClick: modules.game_cyclopedia.Cyclopedia.onItemsFilterButtonClick(self)

  Button
    id: H2Button
    size: 37 20
    anchors.left: H1Button.right
    anchors.top: LevelButton.top
    margin-left: 5
    !text: tr("2H")
    font: verdana-11px-rounded
    color: #dfdfdfff
    @onClick: modules.game_cyclopedia.Cyclopedia.onItemsFilterButtonClick(self)

  ComboBox
    id: ItemFilter
    size: 77 20
    !text: tr('All')
    anchors.top: LevelButton.bottom
    anchors.left: parent.left
    margin-top: 5
    @onOptionChange: modules.game_cyclopedia.Cyclopedia.classificationFilter(self:getCurrentOption().data)

  Label
    id: ItemsLabel
    anchors.top: ItemFilter.bottom
    anchors.left: parent.left
    margin-top: 9
    margin-left: -1
    !text: tr("Items") .. ':'
    font: $var-cip-font-new
    text-auto-resize: true
    color: #c0c0c0

  Panel
    id: ItemListBase
    anchors.left: parent.left
    anchors.top: ItemsLabel.bottom
    margin-top: 6
    size: 200 187
    image-source: /images/ui/1pixel-down-frame
    image-border: 5
    background-color: #404040

    UIScrollArea
      id: List
      anchors.fill: ItemListBase
      focusable: false
      margin-top: 5
      size: 200 187
      image-border: 10
      padding-top: 1
      padding-bottom: 1
      layout:
        type: grid
        cell-size: 200 35
        cell-spacing: 1
        flow: true

    VerticalQtScrollBar
      id: ListScrollbar
      anchors.top: List.top
      anchors.right: List.right
      anchors.bottom: List.bottom
      margin-top: 1
      margin-right: 1
      margin-bottom: 1
      step: 1

  UIWidget
    size: 34 34
    id: SelectedItem
    anchors.left: parent.left
    anchors.top: ItemListBase.bottom
    image-source: /images/ui/item
    margin-top: 6
 
    UIWidget
      id: Rarity
      size: 32 32
      anchors.centerIn: parent
      phantom: true

    UIItem
      id: Sprite
      anchors.fill: parent

  Label
    id: SearchLabel
    anchors.left: SelectedItem.right
    anchors.top: SelectedItem.top
    margin-left: 5
    !text: tr('Search') .. ':'
    text-auto-resize: true
    font: $var-cip-font-new
    color: #c0c0c0

  TextEdit
    id: SearchEdit
    anchors.bottom: SelectedItem.bottom
    anchors.left: SelectedItem.right
    anchors.right: ItemListBase.right
    focusable: true
    //font: verdana-10px-antialiased
    padding-top: 0
    padding-right: 15
    margin-left: 6 
    height: 16
    placeholder: Type to search
    placeholder-color: #6E706F
    @onTextChange: modules.game_cyclopedia.Cyclopedia.onItemSearchTextChange(self:getText())

  UIWidget
    id: SearchClearButton
    size: 12 12
    anchors.right: SearchEdit.right
    anchors.verticalCenter: SearchEdit.verticalCenter
    margin-right: 2
    image-source: /images/ui/button-erase-18x18-up
    image-color: white
    opacity: 0.8
    !tooltip: tr('Clear all text from the search field')
    @onClick: modules.game_cyclopedia.Cyclopedia.onSearchClearButtonClick()
    $hover:
      image-source: /images/ui/button-erase-18x18-up
    $pressed:
      image-source: /images/ui/button-erase-18x18-down

  UIWidget
    id: LootValue
    height: 64
    anchors.left: parent.left
    anchors.right: SearchClearButton.right
    anchors.top: SelectedItem.bottom
    margin-top: 4

    Label
      id: LootValueLabel
      anchors.left: parent.left
      anchors.top: parent.top
      margin-top: 11
      margin-left: 19
      !text: tr('Loot Value Source') .. ':'
      font: $var-cip-font-new
      text-auto-resize: true
      color: #c0c0c0

    CheckBoxCircle
      id: NpcBuyCheck
      anchors.top: LootValueLabel.bottom
      anchors.left: LootValueLabel.left
      margin-top: 6
      margin-left: 1

      !text: tr('NPC Buy Value')
      font: $var-cip-font-new
      color: #c0c0c0
      text-offset: 15 -1
      width: 130
      checked: true
      $hover !disabled:
        text-offset: 15 -1
        color: #c0c0c0

    CheckBoxCircle
      id: MarketCheck
      anchors.top: NpcBuyCheck.bottom
      anchors.left: LootValueLabel.left
      margin-top: 3
      margin-left: 1
      !text: tr('Market Average Value')
      font: $var-cip-font-new
      color: #c0c0c0
      text-offset: 15 -1
      width: 150
      $hover !disabled:
        text-offset: 15 -1
        color: #c0c0c0

  Label
    id: EmptyLabel
    anchors.top: parent.top
    anchors.left: MidSep.right
    margin-top: 10
    margin-left: 10
    !text: tr('Please select an item from the list to see its details here.')
    font: $var-cip-font-new 
    color: #C0C0C0 
    text-auto-resize: true

  UIWidget
    id: InfoBase
    anchors.left: MidSep.right
    anchors.top: parent.top
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    visible: false

    Label
      id: BasicDetailsLabel
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 10
      margin-top: 10
      !text: tr('Basic Item Details') .. ':'
      font: $var-cip-font-new
      text-auto-resize: true
      color: #c0c0c0

    Panel
      id: DetailsBase
      anchors.left: BasicDetailsLabel.left
      anchors.top: BasicDetailsLabel.bottom
      anchors.right: parent.right
      image-source: /images/ui/1pixel-down-frame
      image-border: 5
      margin-top: 6
      margin-left: 1
      height: 150
      background-color: #363636

      UIScrollArea
        id: List
        vertical-scrollbar: ListScrollbar
        anchors.fill: parent
        size: 200 60
        padding-left: 6
        padding-top: 4
        padding-bottom: 3
        padding-right: 18
        layout:
          type: verticalBox
          spacing: 1

        UIWidget
          !text: tr('Status: Loading, please wait...')

      VerticalQtScrollBar
        id: ListScrollbar
        anchors.top: List.top
        anchors.right: List.right
        anchors.bottom: List.bottom
        margin-top: 1
        margin-right: 1
        margin-bottom: 1
        step: 80
        pixels-scroll: true

      UIButton
        id: copyItemDetails
        size: 20 20
        anchors.bottom: parent.bottom
        anchors.right: ListScrollbar.left
        margin-bottom: 3
        margin-right: 2
        image-source: /images/game/wheel/change_preset_icon
        image-clip: 0 0 20 20
        !tooltip: tr('Copy information to clipboard')
        $pressed:
          image-clip: 0 20 20 20
        $!pressed:
          image-clip: 0 0 20 20
        @onClick: modules.game_cyclopedia.Cyclopedia.copyItemDetailsToClipboard()

    Panel
      id: SellBase
      anchors.left: DetailsBase.left
      anchors.top: DetailsBase.bottom
      anchors.right: parent.horizontalCenter
      image-source: /images/ui/1pixel-down-frame
      image-border: 5
      margin-top: 20
      margin-right: -3
      height: 85
      background-color: #404040

      UIScrollArea
        id: List
        vertical-scrollbar: ListScrollbar
        anchors.fill: parent
        size: 200 60
        padding-left: 1
        padding-top: 1
        padding-bottom: 1
        margin-left: 1
        layout:
          type: grid
          cell-size: 210 28
          cell-spacing: 0
          flow: true

      VerticalQtScrollBar
        id: ListScrollbar
        anchors.top: List.top
        anchors.right: List.right
        anchors.bottom: List.bottom
        margin-top: 1
        margin-right: 1
        margin-bottom: 1
        step: 80
        pixels-scroll: true

    Label
      id: SellLabel
      anchors.bottom: SellBase.top
      anchors.left: SellBase.left
      margin-bottom: 6
      margin-left: -1
      !text: tr('Sell To') .. ':'
      font: $var-cip-font-new
      text-auto-resize: true
      color: #c0c0c0

    Panel
      id: BuyBase
      anchors.left: parent.horizontalCenter
      anchors.top: SellBase.top
      anchors.right: parent.right
      image-source: /images/ui/1pixel-down-frame
      image-border: 5
      margin-left: 9
      height: 85
      background-color: #404040

      UIScrollArea
        id: List
        vertical-scrollbar: ListScrollbar
        anchors.fill: parent
        size: 200 60
        padding-left: 1
        padding-top: 1
        padding-bottom: 1
        margin-left: 1
        layout:
          type: grid
          cell-size: 210 28
          cell-spacing: 0
          flow: true

      VerticalQtScrollBar
        id: ListScrollbar
        anchors.top: List.top
        anchors.right: List.right
        anchors.bottom: List.bottom
        margin-top: 1
        margin-right: 1
        margin-bottom: 1
        step: 80
        pixels-scroll: true

    Label
      id: BuyLabel
      anchors.bottom: BuyBase.top
      anchors.left: BuyBase.left
      margin-bottom: 6
      margin-left: -1
      !text: tr('Buy From') .. ':'
      font: $var-cip-font-new
      text-auto-resize: true
      color: #c0c0c0

    UIWidget
      id: MarketGoldPriceBase
      anchors.top: BuyBase.bottom 
      anchors.right: parent.right
      margin-top: 14
      image-source: /images/ui/item66
      image-border: 10
      size: 104 20

      UIWidget
        id: Icon
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 3
        margin-top: 1
        image-source: /images/icons/icon-goldcoin

      Label
        id: Value
        anchors.right: Icon.left
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 2
        text-offset: 0 1
        !text: tr('0')
        font: $var-cip-font-new
        text-auto-resize: true
        color: #c0c0c0

    Label
      id: MarketPriceLabel
      anchors.left: SellBase.left
      anchors.bottom: MarketGoldPriceBase.bottom
      !text: tr('Average Market Price') .. ':'
      font: $var-cip-font-new
      margin-bottom: 3
      margin-left: -1
      text-auto-resize: true
      color: #c0c0c0

    TextEdit
      id: OwnValueEdit
      anchors.top: MarketGoldPriceBase.bottom
      anchors.right: parent.right
      anchors.left: MarketGoldPriceBase.left
      margin-top: 1
      padding-right: 13
      font: $var-cip-font-new
      text-align: right
      text-offset: 0 2
      clipping: true

    Label
      id: OwnValuePlaceholder
      anchors.left: OwnValueEdit.left
      anchors.right: OwnValueEdit.right
      anchors.verticalCenter: OwnValueEdit.verticalCenter
      margin-left: 4
      margin-right: 13
      phantom: true
      !text: tr('Type to set')
      text-align: left
      color: #6E706F
      clipping: true

    Label
      id: OwnLootLabel
      anchors.left: SellBase.left
      anchors.bottom: OwnValueEdit.bottom
      !text: tr('Prefer Own Loot Value') .. ':'
      font: $var-cip-font-new
      margin-bottom: 3
      margin-left: -1
      text-auto-resize: true
      color: #c0c0c0

    UIWidget
      id: ResultGoldBase 
      anchors.top: OwnValueEdit.bottom
      anchors.right: parent.right
      margin-top: 1
      image-source: /images/ui/item66
      image-border: 10
      size: 104 20

      UIWidget
        id: Rarity
        anchors.fill: parent
        image-border: 8
        margin: 1

      UIWidget
        id: Icon
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 3
        margin-top: 1
        image-source: /images/icons/icon-goldcoin

      Label
        id: Value
        anchors.right: Icon.left
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 2
        text-offset: 0 1
        !text: tr('0')
        font: $var-cip-font-new
        text-auto-resize: true
        color: #c0c0c0

    Label
      id: ResultLabel
      anchors.left: SellBase.left
      anchors.bottom: ResultGoldBase.bottom
      !text: tr('Resulting Value') .. ':'
      font: $var-cip-font-new
      margin-bottom: 3
      margin-left: -1
      text-auto-resize: true
      color: #c0c0c0

    CheckBox
      id: TrackCheck
      anchors.left: SellBase.left
      anchors.bottom: parent.bottom
      margin-bottom: 43
      !text: tr('Track drops of this item')
      text-offset: 15 0
      font: $var-cip-font-new
      text-auto-resize: true
      color: #c0c0c0

    CheckBox
      id: quickLootSkipCheck
      anchors.horizontalCenter: BuyBase.horizontalCenter
      anchors.bottom: parent.bottom
      margin-bottom: 43
      width: 176
      !text: tr('Skip when Quick Looting')
      text-offset: 15 -1
      font: $var-cip-font-new
      color: #c0c0c0
      $hover !disabled:
        text-offset: 15 -1
        color: #c0c0c0

    CheckBox
      id: quickLootLootCheck
      anchors.left: quickLootSkipCheck.left
      anchors.bottom: quickLootSkipCheck.top
      margin-bottom: 4
      width: 176
      !text: tr('Loot when Quick Looting')
      text-offset: 15 -1
      font: $var-cip-font-new
      color: #c0c0c0
      $hover !disabled:
        text-offset: 15 -1
        color: #c0c0c0

ItemCategory < UIWidget
  font: $var-cip-font-new
  height: 16
  color: #C0C0C0
  text-align: left
  text-offset: 1 -1
  @onCheckChange: modules.game_cyclopedia.Cyclopedia.onCategoryChange(self)
  $checked:
    color: #F6F6F6

ItemsListBaseItem < UIWidget
  background-color: alpha
  UIWidget
    id: SelectionFill
    phantom: true
    anchors.fill: parent
    margin-left: 1
    margin-bottom: -1
    background-color: #00000000
  UIWidget
    size: 34 34
    id: ItemBackground
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    image-source: /images/ui/item
    margin-left: 2
  UIWidget
    id: Rarity
    size: 32 32
    anchors.centerIn: ItemBackground
    phantom: true
  UIItem
    id: Sprite
    anchors.fill: ItemBackground
    virtual: true
    draggable: false
  UILabel
    id: Name
    size: 143 32
    anchors.left: ItemBackground.right
    anchors.verticalCenter: ItemBackground.verticalCenter
    margin-left: 3
    text-wrap: true
    text-align: left
    !text: tr('Item Name')
    font: $var-cip-font-new
    color: #F6F6F6
