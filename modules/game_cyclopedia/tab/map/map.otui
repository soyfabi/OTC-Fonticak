            size: 44 20
            anchors.left: parent.left
            anchors.bottom: parent.bottom
            margin-left: 39
            margin-bottom: 7

            Button
              id: zoomOut
              image-source: /images/automap/automap_buttons
              image-clip: 0 20 20 20
              image-border: 0
              padding: 0
              anchors.left: parent.left
              anchors.bottom: parent.bottom
              size: 20 20
              @onClick: modules.game_cyclopedia.Cyclopedia.setZooom(false)
              $hover !disabled:
                image-source: /images/automap/automap_buttons
                image-clip: 0 20 20 20
              $pressed !disabled:
                image-source: /images/automap/automap_buttons
                image-clip: 20 20 20 20

            Button
              id: zoomIn
              image-source: /images/automap/automap_buttons
              image-clip: 0 40 20 20
              image-border: 0
              padding: 0
              anchors.left: zoomOut.right
              anchors.bottom: parent.bottom
              margin-left: 4
              size: 20 20
              @onClick: modules.game_cyclopedia.Cyclopedia.setZooom(true)
              $hover !disabled:
                image-source: /images/automap/automap_buttons
                image-clip: 0 40 20 20
              $pressed !disabled:
                image-source: /images/automap/automap_buttons
                image-clip: 20 40 20 20

        UIWidget
          id: AreaBase
          margin-top: 5
          margin-left: 11
          size: 146 0
          fixed-size: true
          visible: false
          image-source: /images/ui/t2pixel-up-frame-borderimage
          image-border: 20
          color: #929292
          text-offset: 0 2
          text-align: top
          font: verdana-11px-monochrome

          UIWidget
            id: areaToggleButton
            size: 12 12
            anchors.top: parent.top
            anchors.right: parent.right
            margin-top: 2
            margin-right: 2
            image-source: /game_cyclopedia/images/button-arrow-down
            image-clip: 0 12 12 12
            @onClick: modules.game_cyclopedia.Cyclopedia.toggleMapSection('area')

          Label
            id: areaName
            anchors.top: parent.top
            anchors.left: parent.left
            anchors.right: parent.right
            margin-top: 20
            margin-left: 7
            margin-right: 7
            height: 14
            font: $var-cip-font-new
            color: #c0c0c0
            text-align: center

          UIWidget
            id: discoveryProgress
            anchors.top: areaName.bottom
            anchors.left: parent.left
            anchors.right: parent.right
            margin-top: 2
            margin-left: 7
            margin-right: 7
            height: 20
            image-source: /images/ui/item66
            image-border: 10

            Label
              id: discoveryPercent
              anchors.fill: parent
              !text: tr('0%%')
              font: $var-cip-font-new
              color: #c0c0c0
              text-align: center

          Label
            id: respawnRateTitle
            anchors.top: discoveryProgress.bottom
            anchors.left: parent.left
            anchors.right: parent.right
            margin-top: 3
            margin-left: 7
            margin-right: 7
            height: 28
            !text: tr('Improved Respawn\nRate')
            font: $var-cip-font-new
            color: #c0c0c0
            text-align: center

          UIWidget
            id: respawnRateValue
            anchors.top: respawnRateTitle.bottom
            anchors.left: parent.left
            anchors.right: parent.right
            margin-left: 7
            margin-right: 7
            height: 20
            image-source: /images/ui/item66
            image-border: 10

            Label
              anchors.fill: parent
              !text: tr('0')
              font: $var-cip-font-new
              color: #c0c0c0
              text-align: center
              text-offset: -5 0

            UIWidget
              size: 9 9
              anchors.verticalCenter: parent.verticalCenter
              anchors.horizontalCenter: parent.horizontalCenter
              margin-left: 5
              image-auto-resize: true
              image-source: /images/icons/icon-goldcoin
              phantom: true

          UIWidget
            id: donationRow
            anchors.top: respawnRateValue.bottom
            anchors.left: parent.left
            anchors.right: parent.right
            margin-top: 5
            margin-left: 7
            margin-right: 7
            height: 18

            TextEdit
              id: amountEdit
              anchors.left: parent.left
              anchors.top: parent.top
              size: 66 18
              max-length: 10
              only-number: true
              enabled: false
              !placeholder: tr('Amount')
              placeholder-color: #6E706F
              padding-right: 14
              @onTextChange: modules.game_cyclopedia.Cyclopedia.onMapAreaAmountTextChange(self, self:getText())

            UIWidget
              size: 9 9
              anchors.verticalCenter: amountEdit.verticalCenter
              anchors.right: amountEdit.right
              margin-right: 4
              image-auto-resize: true
              image-source: /images/icons/icon-goldcoin
              phantom: true

            Button
              id: donateButton
              anchors.left: amountEdit.right
              anchors.right: parent.right
              anchors.top: parent.top
              margin-left: 4
              height: 18
              enabled: false
              !text: tr('Donate')
              font: $var-cip-font-new
              @onClick: modules.game_cyclopedia.Cyclopedia.onMapAreaDonateClick()

          Label
            id: areaDescription
            anchors.top: donationRow.bottom
            anchors.left: parent.left
            anchors.right: parent.right
            margin-top: 7
            margin-left: 7
            margin-right: 7
            height: 30
            font: $var-cip-font-new
            color: #c0c0c0
            text-align: center
            visible: false

          Label
            id: discoveryStatus
            anchors.top: areaDescription.bottom
            anchors.left: parent.left
            anchors.right: parent.right
            margin-top: 1
            margin-left: 7
            margin-right: 7
            height: 16
            !text: tr('Not discoverable.')
            font: $var-cip-font-new
            color: #c0c0c0
            text-align: center
            visible: false

      VerticalQtScrollBar
        id: FilterListScrollBar
        anchors.top: InternalBase.top
        anchors.right: InternalBase.right
        anchors.bottom: InternalBase.bottom
        margin-top: 0
        margin-right: 0
        margin-bottom: 0
        step: 80
        pixel-scroll: true

  UIWidget
    id: MapBase
    anchors.top: InformationBase.top
    anchors.left: InformationBase.right
    margin-left: 6
    margin-bottom: 25
    size: 493 415
    image-source: /images/ui/1pixel-down-frame
    image-border: 10
    UIMinimap 
      id: minimap
      anchors.fill: parent
      margin: 1
      clipping: true
      draggable: true
      focusable: false
      autowalk: true
      cross: true
      color: black
      // Zoom bounds chosen from the data, not by eye (scale = 2^zoom, 1 tile = scale px,
      // drawing window ~491x413 px):
      //   -2 = scale 0.25 -> ~1964x1652 tiles, i.e. the whole main continent. Below this
      //        the engine drops to the worst LOD (threshold 0.15 in satellitemap.cpp) and stops
      //        drawing city names and markers, and the world shrinks to an unreadable speck.
      //    2 = scale 4 -> ~123x103 tiles. Above that blur begins: the satellite has 2 px per tile,
      //        and Map View tiles only 1 px, so zoom 3-4 is already a 4-8x magnification of the source.
      min-zoom: -2
      max-zoom: 2

MapLayerSelector < UIWidget
  UIWidget
    id: layersPanel
    size: 20 68
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-right: 7
    focusable: false

    UIWidget
      id: automapLayers
      image-source: /images/automap/automap_indicator_maplayers
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      image-clip: 98 0 14 67
      size: 14 67
      phantom: true

    UIWidget
      image-source: /images/ui/separator_vertical
      image-border: 1
      margin-left: 3
      margin-top: 4
      margin-bottom: 4
      anchors.left: automapLayers.right 
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      width: 2
      phantom: true

    UIWidget
      id: layersMark
      anchors.left: prev.right
      anchors.top: automapLayers.top
      image-source: /images/automap/automap_indicator_slider_left
      margin-left: -3
      margin-top: 28
      phantom: true
