    margin-top: 5

TrackerButton < Panel
  height: 34
  margin-bottom: 5
  phantom: false
  border-width: 1
  border-color: alpha
  padding: 1

  UICreature
    id: creature
    size: 16 16
    anchors.left: parent.left
    anchors.top: parent.top
    phantom: true

  UIWidget
    id: spacer
    width: 3
    anchors.left: creature.right
    anchors.top: creature.top

  Label
    id: label
    anchors.left: spacer.right
    anchors.top: creature.top
    text-auto-resize: true
    color: #888888
    margin-left: 2

  Label
    id: kills
    anchors.centerIn: ProgressBorder2
    text-align: center
    text-auto-resize: true
    color: #888888
    margin-bottom: -1

  LifeProgressBar
    id: killsBar
    height: 8
    anchors.left: spacer.right
    anchors.right: parent.right
    anchors.top: label.bottom
    margin-top: 2
    phantom: true
    visible: false
    
  ProgressBackground
    id: ProgressBorder2
    anchors.left: spacer.right
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: creature.bottom
    margin-top: 2
    size: 52 14

  ProgressBackground
    id: ProgressBorder1
    anchors.right: ProgressBorder2.left
    anchors.bottom: ProgressBorder2.bottom
    margin-right: 2
    size: 51 14

  ProgressBackground
    id: ProgressBorder3
    anchors.left: ProgressBorder2.right
    anchors.bottom: ProgressBorder2.bottom
    margin-left: 2
    size: 51 14

  UIWidget
    id: killsBar2
    anchors.left: ProgressBorder1.left
    anchors.bottom: ProgressBorder2.bottom
    margin-left: 1
    margin-bottom: 1
    height: 12
    phantom: true
    image-source: /images/bars/progressbar-orange-large

  UIWidget
    id: ProgressBack33
    anchors.left: ProgressBorder2.left
    anchors.bottom: ProgressBorder2.bottom
    margin-left: 1
    margin-bottom: 1
    height: 12
    phantom: true
    image-source: /images/bars/progressbar-orange-large

  UIWidget
    id: ProgressBack55
    anchors.left: ProgressBorder3.left
    anchors.bottom: ProgressBorder2.bottom
    margin-left: 1
    margin-bottom: 1
    height: 12
    phantom: true
    image-source: /images/bars/progressbar-orange-large


BestiaryTracker < MiniWindow
  id: BestiaryTracker
  @onClose: modules.game_cyclopedia.Cyclopedia.onTrackerClose(self:getText())
  &save: true

  UIWidget
    id: miniwindowIcon
    anchors.top: miniwindowHeader.top
    anchors.left: miniwindowHeader.left
    margin-top: 2
    margin-left: 4
    size: 12 12
    image-source: /images/icons/icon-bestiarytracker-widget
    image-smooth: false

  Label
    id: miniwindowTitle
    anchors.top: miniwindowHeader.top
    anchors.left: miniwindowHeader.left
    anchors.right: miniwindowHeader.right
    margin-top: 2
    margin-left: 20
    margin-right: 50
    font: verdana-11px-monochrome
    height: 13
    color: #9d9d9dff

  MiniWindowContents
    id: contentsPanel
    anchors.top: miniwindowTopBar.bottom
    anchors.left: parent.left
    anchors.right: miniwindowScrollBar.left
    anchors.bottom: parent.bottom
    margin-left: 3
    margin-top: -2
    margin-right: 1
    vertical-scrollbar: miniwindowScrollBar
    padding-left: 1
    padding-right: 1
    padding-bottom: 3
    layout: verticalBox 


