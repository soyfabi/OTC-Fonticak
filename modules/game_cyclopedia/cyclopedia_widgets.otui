&var-cip-font-new: Verdana Bold-11px-new
&var-cip-font-lowspace: Verdana Bold-11-px-lowspace
&character-item-store-icon-size: 13 11
&character-item-store-icon-clip: 0 0 26 22
&character-item-store-icon-display: 13 11
&character-item-store-icon-source: /images/ui/miniStoreIcon

CharacterItemMiniStoreBadge < UIWidget
  id: storeIcon
  size: $character-item-store-icon-size
  margin-bottom: 1
  margin-right: 1
  image-source: $character-item-store-icon-source
  image-clip: $character-item-store-icon-clip
  image-size: $character-item-store-icon-display
  phantom: true
  focusable: false
  visible: false

HouseIcon < UIWidget
  //image-source: /game_cyclopedia/images/house-owner-icon
  margin-left: 0

HousePreviewTile < UIItem
  size: 8 8
  phantom: true
  virtual: true
  item-smooth: true
  image-smooth: true
HouseBidArea < UIWidget
  height: 100
  margin-top: 2
  Label
    !text: tr('Set bid limit:')
    font: $var-cip-font-new
    color: #909090
    text-offset: 0 -1
    text-align: right
    size: 90 15
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 10
  TextEdit
    id: textEdit
    size: 100 16
    text-align: left
    !placeholder: tr('Bid Limit')
    placeholder-color: #6E706F
    anchors.top: parent.top
    anchors.left: prev.right
    padding-right: 3
    margin-top: -2
    margin-left: 7
  UIWidget
    image-source: /images/icons/icon-goldcoin
    anchors.top: prev.top
    anchors.left: prev.right
    margin-top: 4
    margin-left: 6
  UIWidget
    id: errorBid
    size: 12 12
    !tooltip: tr('Field must be completed.')
    anchors.left: prev.right
    anchors.verticalCenter: textEdit.verticalCenter
    image-source: /images/icons/show_gui_help_red
    margin-left: 6
    visible: false
  UIWidget
    anchors.right: parent.right
    anchors.top: prev.top
    image-source: /images/icons/show_gui_help_grey
    !tooltip: tr('Bids increase in steps of 1[color=#ffffff]$[/color]. If you set a higher bid limit than the\ncurrent highest bidder, you will automatically outbid the current\nbid by 1[color=#ffffff]$[/color]. If you set a lower bid limit, the current highest bidder\nwill still hold the highest bid.\nIf there is no other character who is bidding for the house, your bid\nwiill be set to 0[color=#ffffff]$[/color].')
    margin-right: 1
  Label
    id: information
    font: $var-cip-font-new
    color: #C0C0C0
    text-auto-resize: true
    text-wrap: true
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 24
House < UICheckBox
  text-align: top
  text-offset: -1 2
  font: $var-cip-font-new
  color: #909090
  image-source: /images/ui/window-high
  image-border: 5
  border: 0 white
  padding: 5
  padding-top: 18
  @onCheckChange: |
    if self.selectionBorder then
      self.selectionBorder:setVisible(self:isChecked())
    end
  UIWidget
    id: selectionBorder
    anchors.fill: parent
    margin-left: -7
    margin-right: -7
    margin-top: -20
    margin-bottom: -7
    border: 2 white
    visible: false
    phantom: true
    focusable: false
  UIWidget
    id: sizeColumn
    height: 15
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 1
    width: 101
    Label
      id: sizeLabel
      anchors.top: parent.top
      anchors.left: parent.left
      text-align: left
      !text: tr('Size:')
      font: $var-cip-font-new
      color: #909090
    Label
      id: sizeValue
      anchors.top: parent.top
      anchors.right: parent.right
      text-align: right
      font: $var-cip-font-new
      color: #C0C0C0
  UIWidget
    id: bedsColumn
    height: 15
    anchors.top: sizeColumn.top
    anchors.left: sizeColumn.right
    margin-left: 6
    width: 97
    Label
      id: bedsText
      anchors.top: parent.top
      anchors.left: parent.left
      text-align: left
      font: $var-cip-font-new
      color: #909090
  UIWidget
    id: rentColumn
    height: 15
    anchors.top: sizeColumn.top
    anchors.left: bedsColumn.right
    margin-left: 8
    width: 82
    Label
      id: rentLabel
      anchors.top: parent.top
      anchors.left: parent.left
      text-align: left
      !text: tr('Rent:')
      font: $var-cip-font-new
      color: #909090
    Label
      id: rentValue
      anchors.top: parent.top
      anchors.right: parent.right
      text-align: right
      font: $var-cip-font-new
      color: #C0C0C0
  UIWidget
    id: rentGold
    anchors.left: rentColumn.right
    anchors.verticalCenter: rentColumn.verticalCenter
    margin-left: 4
    margin-top: -1
    image-source: /images/icons/icon-goldcoin
  Panel
    id: icons
    size: 73 13
    anchors.verticalCenter: rentColumn.verticalCenter
    anchors.left: rentGold.right
    margin-top: -1
    margin-left: 5
    layout:
      type: horizontalBox
      align-right: true
      flow: true
  Label
    id: statusLabel
    size: 53 15
    text-align: left
    !text: tr('Status:')
    font: $var-cip-font-new
    color: #909090
    anchors.top: sizeColumn.bottom
    anchors.left: parent.left
    margin-top: 3
  Label
    id: statusState
    text-auto-resize: true
    font: $var-cip-font-new
    color: #00F000
    anchors.top: statusLabel.top
    anchors.left: statusLabel.right
    margin-top: 1
  Label
    id: statusDetail
    text-auto-resize: true
    font: $var-cip-font-new
    color: #C0C0C0
    anchors.top: statusLabel.top
    anchors.left: statusState.right
    margin-left: 1
    margin-top: 1
  UIWidget
    id: description
    //image-source: /game_cyclopedia/images/house-description
    anchors.top: sold.top
    anchors.left: sold.left
    visible: false
CharacterBadge < UIWidget
  image-source: /game_cyclopedia/images/character_icons/friend-badge-icons

CharacterAppearance < Panel
  image-source: /images/ui/button-grey-up
  image-border: 3
  border: 1 alpha
  focusable: false
  phantom: false
  change-cursor-image: true
  cursor: pointer
  $pressed:
    image-source: /images/ui/button-grey-down
  @onClick: modules.game_cyclopedia.Cyclopedia.onCharacterAppearanceClick(self)

  Panel
    id: selectionIconRow
    height: 64
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    phantom: true

  UIWidget
    id: storeIcon
    size: 19 16
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 5
    margin-right: 5
    image-source: /images/icons/icon-tibiastore
    phantom: true
    visible: false

  UICreature
    id: creature
    size: 64 64
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    fixed-creature-size: true
    base-scale: true
    margin-bottom: 41
    margin-right: 44
    phantom: true

  Label
    id: name
    anchors.top: selectionIconRow.bottom
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 18
    text-align: bottom
    text-wrap: true
    font: $var-cip-font-new
    color: #c0c0c0

CyclopediaBlessButton < UIButton
  size: 12 12
  image-source: /images/inventory/button_blessings_grey
  image-clip: 0 0 12 12
  focusable: false

  $pressed:
    image-clip: 12 0 12 12

MiscTimedItemGrid < UIWidget
  phantom: true
  layout:
    type: grid
    cell-size: 34 34
    cell-spacing: 5
    num-columns: 6
    flow: true

CharacterGridItem < UIWidget
  size: 34 34

  UIWidget
    id: ItemBackground
    size: 34 34
    anchors.fill: parent
    image-source: /images/ui/item

  UIWidget
    id: rarity
    size: 32 32
    anchors.centerIn: ItemBackground
    phantom: true
    focusable: false

  UIItem
    id: item
    anchors.fill: ItemBackground
    font: verdana-11px-rounded
    show-count: false
    virtual-count: true
    focusable: false
    border-color: white
    color: white

  UIWidget
    id: tier
    size: 9 8
    image-source: /images/inventory/tiers-strip
    image-clip: 0 0 9 8
    image-size: 9 8
    margin-top: 1
    margin-right: 1
    anchors.top: item.top
    anchors.right: item.right
    phantom: true
    focusable: false
    visible: false
    image-smooth: true

  CharacterItemMiniStoreBadge
    anchors.bottom: ItemBackground.bottom
    anchors.right: ItemBackground.right

  Label
    id: amount
    !text: tr('0')
    color: #C0C0C0
    font: verdana-11px-rounded
    text-auto-resize: true
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-right: 1
    margin-bottom: -1
CharacterListItem < UIWidget
  size: 480 36

  UIWidget
    id: ItemBackground
    size: 34 34
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 2
    image-source: /images/ui/item

  UIWidget
    id: rarity
    size: 32 32
    anchors.centerIn: ItemBackground
    phantom: true
    focusable: false

  UIItem
    id: item
    anchors.fill: ItemBackground
    font: verdana-11px-rounded
    show-count: false
    virtual-count: true
    focusable: false
    border-color: white
    color: white

  UIWidget
    id: tier
    size: 9 8
    image-source: /images/inventory/tiers-strip
    image-clip: 0 0 9 8
    image-size: 9 8
    margin-top: 1
    margin-right: 1
    anchors.top: item.top
    anchors.right: item.right
    phantom: true
    focusable: false
    visible: false
    image-smooth: true

  CharacterItemMiniStoreBadge
    anchors.bottom: ItemBackground.bottom
    anchors.right: ItemBackground.right

  Label
    id: name
    !text: tr('Boots')
    font: $var-cip-font-new
    color: #C0C0C0
    text-auto-resize: true
    anchors.verticalCenter: ItemBackground.verticalCenter
    anchors.left: ItemBackground.right
    anchors.right: separator.left
    margin-left: 5
    margin-right: 5
    margin-top: 1

  VerticalSeparator
    id: separator
    anchors.top: parent.top
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: -1
    margin-bottom: -1
    margin-right: 130

  Label
    id: amount
    !text: tr('1')
    font: $var-cip-font-new
    color: #C0C0C0
    text-auto-resize: true
    anchors.verticalCenter: ItemBackground.verticalCenter
    anchors.left: separator.left
    anchors.right: parent.right
    margin-left: 3
    margin-top: 1

Achievement < UICheckBox
  image-source: /images/ui/popupwindow-sem-borda-interna
  image-border: 5
  padding-bottom: 12

  UIWidget
    id: icon
    image-source: /game_cyclopedia/images/icon-achievement
    image-repeated: true
    width: 22
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 2
    margin-top: 3

  Label
    id: title
    font: $var-cip-font-new
    text-align: center
    color: #909090
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    margin-left: 4
    margin-right: 4
    height: 14

  Label
    id: date
    font: $var-cip-font-new
    text-auto-resize: true
    color: #909090
    anchors.top: title.top
    anchors.right: parent.right
    margin-right: 5
    visible: false

  Label
    id: description
    font: $var-cip-font-lowspace
    color: #C0C0C0
    text-wrap: true
    text-auto-resize: true
    anchors.top: title.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    margin-left: 11
    margin-right: 11
    margin-bottom: 6
CharacterDeath < UIWidget
  height: 16
  min-height: 16
  max-height: 16
  clipping: true
  focusable: true
  change-cursor-image: true
  cursor: pointer
  Label
    id: date
    font: $var-cip-font-new
    height: 13
    text-wrap: false
    text-offset: 0 -1
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 1
    margin-top: 1
    $on:
      color: #F4F4F4
    $!on:
      color: #C0C0C0
  VerticalSeparatorFlat
    id: separator
    height: 16
    fixed-size: true
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 153
  Label
    id: cause
    font: $var-cip-font-new
    height: 13
    text-wrap: false
    text-offset: 0 -1
    anchors.top: parent.top
    anchors.left: separator.left
    anchors.right: parent.right
    margin-left: 3
    margin-top: 1
    $on:
      color: #F4F4F4
    $!on:
      color: #C0C0C0
CharacterKill < UIWidget
  height: 16
  min-height: 16
  max-height: 16
  clipping: true
  focusable: true
  change-cursor-image: true
  cursor: pointer
  Label
    id: date
    font: $var-cip-font-new
    height: 13
    text-wrap: false
    text-offset: 0 -1
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 1
    margin-top: 1
    $on:
      color: #F4F4F4
    $!on:
      color: #C0C0C0
  VerticalSeparatorFlat
    id: separator
    height: 16
    fixed-size: true
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 153
  Label
    id: description
    font: $var-cip-font-new
    height: 13
    text-wrap: false
    text-offset: 0 -1
    anchors.top: parent.top
    anchors.left: separator.left
    anchors.right: separatorTwo.left
    margin-left: 3
    margin-top: 1
    $on:
      color: #F4F4F4
    $!on:
      color: #C0C0C0
  VerticalSeparatorFlat
    id: separatorTwo
    height: 16
    fixed-size: true
    anchors.top: parent.top
    anchors.right: parent.right
    margin-right: 80
  Label
    id: status
    font: $var-cip-font-new
    height: 13
    text-wrap: false
    text-offset: 0 -1
    anchors.top: parent.top
    anchors.left: separatorTwo.left
    anchors.right: parent.right
    margin-left: 3
    margin-top: 1
CharacterElementReduction < UIWidget
  height: 20
  Label
    id: name
    !text: tr('Physical')
    text-auto-resize: true
    anchors.top: parent.top
    anchors.left: parent.left
    color: #C0C0C0
  Label
    id: value
    !text: ('+5%')
    color: #44AD25
    text-auto-resize: true
    anchors.top: parent.top
    anchors.right: parent.right
    margin-right: 20
  UIWidget
    id: icon
    size: 9 9
    image-source: /images/game/creatures/icons-skills

    anchors.top: parent.top
    anchors.left: value.right
    margin-left: 5
    margin-top: 2
SkillCharacterIcon < UIWidget
  id: icon
  size: 9 9
  anchors.top: parent.top
  margin-top: 13
  image-source: /images/game/creatures/icons-skills
CharacterSkillBase < UIWidget
  height: 14
  margin-left: 5
  margin-right: 5
  margin-top: 5

SkillCharacterPercentPanel < ProgressBar
  id: percent
  background-color: #00C000
  height: 5
  margin-top: 13
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.top: parent.top
  image-source: /images/ui/progressbar
  image-border: 1
  phantom: false

SkillNameLabel < Label
  font: $var-cip-font-new
  anchors.left: parent.left
  anchors.top: parent.top
  anchors.bottom: parent.bottom
  margin-right: 3
  color: #C0C0C0
  phantom: true
  focusable: false

SkillValueLabel < Label
  id: value
  font: $var-cip-font-new
  text-align: topright
  text-auto-resize: true
  anchors.right: parent.right
  anchors.top: parent.top
  anchors.bottom: parent.bottom
  margin-top: 1
  margin-right: 2
  color: #C0C0C0
  phantom: true
  focusable: false

CharacterOverviewSkillNameLabel < SkillNameLabel
  margin-left: 14

SelectBossBossSlots < UICheckBox
  image-source: /images/ui/t2pixel-up-frame-borderimage
  text-offset: 0 2
  text-align: top
  image-border: 5
  !text: tr('?')
  font: verdana-11px-monochrome
  color: #909090
  border: 0 white
  @onClick: modules.game_cyclopedia.Cyclopedia.bossSlotSelectBoss(self)
  $checked:
    border: 1 white
  $!checked:
    border: 0 white
  UICreature
    id: Sprite
    size: 64 64
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-bottom: 7
    margin-right: 12
    fixed-creature-size: true
    phantom: true
  UIWidget
    id: TypeIcon
    anchors.right: Sprite.left
    anchors.top: Sprite.top
    image-source: /images/icons/icon-bosstiary-bane
    margin-right: -7
    margin-top: -10
SlotBossSlots < UIWidget
  size: 223 360
  image-source: /images/ui/t2pixel-up-frame-borderimage
  image-border: 20
  color: #929292
  text-offset: 0 2
  text-align: top
  Label
    id: LockLabel
    anchors.centerIn: parent
    text-auto-resize: true
    !text: tr('Unlocks if you reach the\nProwess level for any boss')
    font: verdana-11px-monochrome
    text-align: center
    margin-top: -10
    color: #c0c0c0
    visible: true
  UIWidget
    id: SelectBoss
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin: 3
    margin-top: 16
    visible: false
    BorderBox
      id: ListBase
      size: 213 281
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 6
      margin-left: 2
      UIScrollArea
        id: List
        vertical-scrollbar: ListScrollbar
        anchors.fill: parent
        padding-left: 7
        padding-top: 7
        padding-bottom: 1
        layout:
          type: grid
          cell-size: 88 103
          cell-spacing: 4
          flow: true
      VerticalQtScrollBar
        id: ListScrollbar
        anchors.top: List.top
        anchors.right: List.right
        anchors.bottom: List.bottom
        margin-top: 1
        margin-right: 1
        margin-bottom: 1
        step: 80
        pixel-scroll: true
    TextEdit
      id: SearchEdit
      height: 20
      anchors.top: ListBase.bottom
      anchors.right: ListBase.right
      anchors.left: ListBase.left
      margin-top: 6
      padding-top: 2
      padding-right: 15
      placeholder: Type to search
      placeholder-color: #6E706F
      @onTextChange: modules.game_cyclopedia.Cyclopedia.SelectBossSearchText(self:getText())
    UIWidget
      id: SearchClearButton
      anchors.right: SearchEdit.right
      anchors.top: SearchEdit.top
      margin-top: 1
      margin-right: 1
      image-source: /images/ui/button-erase-18x18-up
      @onClick: modules.game_cyclopedia.Cyclopedia.SelectBossSearchText("", true, self)
      $pressed:
        image-source: /images/ui/button-erase-18x18-down
    Button
      id: SelectButton
      size: 43 20
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      !text: tr('Select')
      //font: verdana-bold-8px-antialiased
      text-offset: 0 0
      color: #C0C0C0
      enabled: false
      margin-bottom: 4
      margin-right: 2
  UIWidget
    id: ActivedBoss
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin: 3
    margin-top: 20
    visible: false
    UICreature
      id: Sprite
      size: 64 64
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: parent.top
      margin-top: 9
      margin-right: 1
      fixed-creature-size: true
      phantom: true
    UIWidget
      id: TypeIcon
      anchors.right: Sprite.left
      anchors.top: Sprite.top
      image-source: /images/icons/icon-bosstiary-bane
      margin-right: 10
    BossSlotProgress
      id: Progress
      anchors.top: Sprite.bottom
      anchors.horizontalCenter: Sprite.horizontalCenter
      margin-top: 40
      margin-left: 1
    Label
      anchors.horizontalCenter: Progress.horizontalCenter
      anchors.bottom: Progress.top
      margin-bottom: 1
      text-auto-resize: true
      !text: tr('Total Kills')
      font: verdana-11px-monochrome
      color: #c0c0c0
      text-align: center
      text-offset: 0 4
    Label
      id: EquipmentLabel
      anchors.horizontalCenter: Progress.horizontalCenter
      anchors.top: Progress.bottom
      text-auto-resize: true
      !text: ('Equipment loot bonus: 118%')
      font: verdana-11px-monochrome
      color: #c0c0c0
      text-align: center
      margin-top: 15
    ProgressBackground
      id: ValueBackground
      size: 128 20
      anchors.bottom: parent.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-bottom: 4
    Label
      id: Value
      anchors.horizontalCenter: prev.horizontalCenter
      anchors.verticalCenter: prev.verticalCenter
      margin-left: -6
      text-auto-resize: true
      !text: ('0')
      font: verdana-11px-monochrome
      text-align: center
      text-offset: 2 2
    UIWidget
      image-source: /images/icons/icon-goldcoin
      anchors.left: Value.right
      anchors.verticalCenter: Value.verticalCenter
      margin-left: 3
      margin-top: 1
    Button
      id: RemoveButton
      height: 20
      anchors.bottom: ValueBackground.bottom
      anchors.right: ValueBackground.right
      anchors.left: ValueBackground.left
      margin-bottom: 25
      !text: tr('Remove')
      //font: verdana-bold-8px-antialiased
      text-offset: 0 0
      color: #C0C0C0
BossSlotProgress < UIWidget
  size: 140 35
  ProgressBackground
    id: ProgressBorder2
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.bottom: parent.bottom
    margin-bottom: 18
    size: 42 14
  ProgressBackground
    id: ProgressBorder1
    anchors.right: ProgressBorder2.left
    anchors.bottom: ProgressBorder2.bottom
    margin-right: 2
    size: 42 14
  ProgressBackground
    id: ProgressBorder3
    anchors.left: ProgressBorder2.right
    anchors.bottom: ProgressBorder2.bottom
    margin-left: 2
    size: 42 14
  UIWidget
    id: ProgressBack
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-bottom: 21
    margin-right: 7
    margin-left: 7
    height: 13
    image-border: 10
    phantom: true
  UIWidget
    id: fill
    anchors.fill: ProgressBack
    image-source: /images/bars/progressbar-orange-large
    margin-top: 3
    phantom: true
  UIWidget
    anchors.left: ProgressBorder1.right
    anchors.top: ProgressBorder1.top
    image-source: /images/ui/progress-separator
    margin-right: 4
    phantom: true
  UIWidget
    anchors.left: ProgressBorder2.right
    anchors.top: ProgressBorder1.top
    image-source: /images/ui/progress-separator
    phantom: true
  UIWidget
