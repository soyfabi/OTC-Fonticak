CharacterCategoryItem < UIWidget
  size: 150 22
  background-color: alpha
  image-source: /images/ui/1pixel-down-frame
  image-border: 5

  UIWidget
    id: Button
    size: 148 20
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 1
    margin-top: 1
    image-source: /images/ui/button-grey-up
    image-border: 5
    opacity: 1.0
    change-cursor-image: true
    cursor: pointer
    $pressed:
      image-source: /images/ui/button-grey-down
    $checked:
      image-source: /images/ui/button-grey-down
    @onMousePress: |
      self.Icon:setMarginLeft(7)
      self.Icon:setMarginTop(1)
      self.Title:setTextOffset('1 1')
      if self.Arrow:isVisible() then
        self.Arrow:setMarginRight(5)
      end
    @onMouseRelease: |
      if not self:isChecked() then
        self.Icon:setMarginLeft(6)
        self.Icon:setMarginTop(0)
        self.Title:setTextOffset('0 0')
        if self.Arrow:isVisible() then
          self.Arrow:setMarginRight(6)
        end
      end

    UIWidget
      id: Icon
      size: 13 13
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6
      margin-top: 0
      phantom: true
      $checked:
        margin-left: 7
        margin-top: 1
      $!checked:
        margin-left: 6
        margin-top: 0

    Label
      id: Title
      anchors.left: Icon.right
      anchors.bottom: Icon.bottom
      margin-left: 4
      margin-bottom: 1
      text-auto-resize: true
      !text: tr('General Stats')
      font: cipsoftFont
      color: #FFFFFF
      phantom: true
      $checked:
        text-offset: 1 1
      $!checked:
        text-offset: 0 0

    UIWidget
      id: Arrow
      size: 7 7
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 6
      phantom: true
      image-source: images/icon-arrow7x7-down
      visible: false

