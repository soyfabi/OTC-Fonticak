InventoryItemCyclopedia < Item
  virtual: true
  show-count: false
  @onItemChange: |
    local icon = self.quickloot or self:getChildById('quickloot')
    if icon then
      icon:setVisible(false)
    end

  CharacterItemMiniStoreBadge
    anchors.bottom: parent.bottom
    anchors.right: parent.right

