TextEdit < UITextEdit
  font: Verdana Bold-11px
  color: #c0c0c0
  padding-left: 2
  height: 16
  opacity: 1
  image-source: /images/ui/textedit
  image-border: 1
  selection-background-color: #808080
  cursor: none
  blink-speed: 600
  $disabled:
    color: #27272788
    opacity: 0.5

PasswordTextEdit < TextEdit
  text-hidden: true
  font: pVerdana Bold-11px
  color: #c0c0c0
  padding-top: 2
  padding-left: 3

MultilineTextEdit < TextEdit
  multiline: true

TextQtEdit < UITextEdit
  font: Verdana Bold-11px
  color: #c0c0c0ff
  size: 97 20
  text-offset: 0 4
  opacity: 1
  padding: 0 0 0 4
  padding-bottom: 1
  image-source: /images/ui/textedit
  image-border: 1
  selection-color: #ffffffff
  selection-background-color: #808080ff
  change-cursor-image: false

TextQtHideToggleBox < TextQtEdit
  editable: false
  selectable: false
  focusable: false
  cursor-visible: false
  width: 22
  height: 20
  max-length: 0

HiddenTextQtEdit < TextQtEdit
  text-hidden: true

HiddenTextQtToggleEdit < HiddenTextQtEdit

  UICheckBox
    size: 19 20
    anchors.right: parent.right
    margin-right: -2
    anchors.verticalCenter: parent.verticalCenter
    image-rect: 0 0 19 20
    image-source: /images/ui/hide_eye
    @onCheckChange: |
      self:getParent():setTextHidden(not self:isChecked())
      self:getParent():setTextWrap(false)

    $!checked:
      image-clip: 0 0 19 20

    $checked:
      image-clip: 0 20 19 20
      
AccTextEdit < TextEdit
  font: pVerdana Bold-11px
  color: #c0c0c0
  padding-left: 3
  padding-top: 2
  height: 16
  opacity: 1
  image-source: /images/ui/textedit
  image-border: 1
  selection-background-color: #808080
  cursor: none
  blink-speed: 600
  $disabled:
    color: #27272788
    opacity: 0.5
