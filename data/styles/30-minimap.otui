&var-cip-font-new: Verdana Bold-11px

MinimapFlag < UIWidget
  size: 11 11
  focusable: false
  clipping: true

MinimapMarkText < Label
  font: Verdana Bold-11px-outline
  text-auto-resize: true
  margin-left: 9
  clipping: true
  phantom: false
  focusable: false

MinimapCross < UIWidget
  focusable: false
  phantom: true
  clipping: true
  image: /images/game/minimap/cross
  size: 16 16

MinimapNearbyPlayerPin < UIWidget
  focusable: false
  size: 20 20

  UIWidget
    id: pulseHalo
    anchors.fill: parent
    phantom: true
    focusable: false
    opacity: 0
    image-smooth: true
    image-source: /images/game/minimap/nearby-player-halo

  UIWidget
    size: 8 8
    anchors.centerIn: parent
    phantom: true
    focusable: false
    image-smooth: true
    image-source: /images/game/minimap/nearby-player-dot

MinimapFloorUpButton < Button
  size: 20 20
  margin-right: 28
  margin-bottom: 28
  anchors.right: parent.right
  anchors.bottom: parent.bottom
  icon-source: /images/game/minimap/floor_up
  icon-clip: 0 32 16 16
  $pressed:
    icon-clip: 0 0 16 16
  $hover !pressed:
    icon-clip: 0 16 16 16

MinimapFloorDownButton < Button
  size: 20 20
  margin-right: 28
  margin-bottom: 4
  anchors.right: parent.right
  anchors.bottom: parent.bottom
  icon-source: /images/game/minimap/floor_down
  icon-clip: 0 32 16 16
  $pressed:
    icon-clip: 0 0 16 16
  $hover !pressed:
    icon-clip: 0 16 16 16

MinimapZoomInButton < Button
  text: +
  size: 20 20
  margin-right: 4
  margin-bottom: 28
  anchors.right: parent.right
  anchors.bottom: parent.bottom
  //icon-source: /images/game/minimap/zoom_in

MinimapZoomOutButton < Button
  text: -
  size: 20 20
  margin-right: 4
  margin-bottom: 4
  anchors.right: parent.right
  anchors.bottom: parent.bottom
  //icon-source: /images/game/minimap/zoom_out

MinimapMapControl < Button
  size: 20 20
  padding: 0
  focusable: false
  icon-rect: 2 2 16 16
  icon-color: #ffffff

  $on:
    icon-color: #8fda82

MinimapHdControl < MinimapMapControl
  icon-source: /images/topbuttons/minimap

  UIWidget
    id: highlight
    anchors.centerIn: parent
    size: 22 22
    image-source: /images/topbuttons/highlight
    phantom: true
    focusable: false

  UIWidget
    id: brightButton
    anchors.fill: parent
    image-source: /images/ui/bright-x20
    phantom: true
    focusable: false

MinimapFreeViewControl < MinimapMapControl
  icon-source: /images/game/minimap/free-view

MinimapDownloadButton < Button
  size: 113 23
  padding: 0
  ttf-font: Inter-Medium
  ttf-font-size: 9
  image-source: /images/ui/buttons-blue
  text-offset: 0 0
  focusable: false

  UIWidget
    id: brightButton
    anchors.fill: parent
    margin: 1
    image-source: /images/game/minimap/download-button-shine
    image-smooth: true
    phantom: true
    focusable: false

  UIWidget
    id: highlight
    anchors.fill: parent
    image-source: /images/store/rectangle-highlight
    image-border: 1
    phantom: true
    focusable: false

MinimapDownloadProgress < UIWidget
  anchors.horizontalCenter: parent.horizontalCenter
  anchors.bottom: parent.bottom
  margin-bottom: 4
  size: 108 32
  image-source: /images/ui/1pixel_down_frame
  image-border: 4
  background-color: #222222ee
  phantom: true
  visible: false
  @onDestroy: |
    if self.hourglassEvent then
      removeEvent(self.hourglassEvent)
      self.hourglassEvent = nil
    end

  UIWidget
    id: hourglass
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    size: 16 20
    image-source: /images/game/minimap/download-hourglass
    phantom: true

  Label
    id: progressText
    anchors.left: hourglass.right
    anchors.right: parent.right
    anchors.top: parent.top
    margin-top: 3
    text-align: center
    phantom: true

  ProgressBar
    id: progressBar
    anchors.left: hourglass.right
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 4
    margin-right: 5
    margin-bottom: 4
    height: 7
    background-color: #89c361
    phantom: true

MinimapFogControl < MinimapMapControl
  icon-source: /images/game/minimap/fog-of-war

MinimapCenterControl < MinimapMapControl
  icon-source: /images/game/minimap/cross

MinimapResetButton < MinimapCenterControl
  !tooltip: tr('Center the minimap on your character.')
  anchors.left: parent.left
  anchors.top: parent.top
  margin: 4

Minimap < UIMinimap
  draggable: true
  focusable: false
  cross: true
  color: black

  MinimapFloorUpButton
    id: floorUpButton
    @onClick: self:getParent():floorUp(1)

  MinimapFloorDownButton
    id: floorDownButton
    @onClick: self:getParent():floorDown(1)

  MinimapZoomInButton
    id: zoomInButton
    @onClick: self:getParent():smoothZoomBy(1)

  MinimapZoomOutButton
    id: zoomOutButton
    @onClick: self:getParent():smoothZoomBy(-1)

  MinimapResetButton
    id: resetButton
    @onClick: self:getParent():reset()


// Minimap Flag Create Window


MinimapFlagButton < CheckBoxButton
  size: 16 16
  image-source: /images/ui/button-grey-up
  image-border: 3
  $checked:
    image-source: /images/ui/button-grey-down

MinimapMarkColorSwatch < CheckBoxButton
  size: 22 20
  padding: 0
  image-source: /images/ui/button-grey-up
  image-border: 3
  border-width: 1
  border-color: #4c4c4c
  cursor: pointer

  $hover:
    border-color: #b0b0b0

  $checked:
    border-color: #f3d46d
    image-source: /images/ui/button-grey-down

  UIWidget
    id: sample
    anchors.fill: parent
    margin: 3
    border-width: 1
    border-color: #191919
    phantom: true
    focusable: false

MinimapFlagWindow < MainWindowHigh
  font: $var-cip-font-new
  color: #909090
  text-offset: 0 2
  size: 285 302

  Label
    id: mapTextLabel
    font: $var-cip-font-new
    color: #c0c0c0
    !text: tr('Map text')
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: -7
    margin-left: -1

  Label
    id: mapTextCount
    font: $var-cip-font-new
    color: #c0c0c0
    text: 0/10
    text-align: right
    anchors.top: mapTextLabel.top
    anchors.right: parent.right

  TextEdit
    id: mapText
    height: 18
    margin-top: 5
    anchors.left: parent.left
    anchors.top: mapTextLabel.bottom
    anchors.right: parent.right

  Label
    id: descriptionLabel
    font: $var-cip-font-new
    color: #c0c0c0
    !text: tr('Enter a short description') .. ':'
    anchors.left: mapText.left
    anchors.top: mapText.bottom
    margin-top: 7

  TextEdit
    id: description
    height: 16
    anchors.left: mapText.left
    anchors.right: mapText.right
    anchors.top: descriptionLabel.bottom
    margin-top: 4

  Label
    id: textColorLabel
    font: $var-cip-font-new
    color: #c0c0c0
    !text: tr('Text color') .. ':'
    anchors.left: mapText.left
    anchors.top: description.bottom
    margin-top: 7

  UIWidget
    id: textColorPalette
    height: 20
    anchors.left: mapText.left
    anchors.right: mapText.right
    anchors.top: textColorLabel.bottom
    margin-top: 4
    layout:
      type: horizontalBox
      spacing: 4

  Label
    id: flagLabel
    font: $var-cip-font-new
    color: #c0c0c0
    !text: tr('Select a type') .. ':'
    anchors.left: parent.left
    anchors.top: textColorPalette.bottom
    margin-top: 9
    margin-left: -1

  UIWidget
    id: flagPalette
    anchors.left: parent.left
    anchors.top: flagLabel.bottom
    margin-top: 5
    size: 214 82
    layout:
      type: grid
      cell-size: 16 16
      cell-spacing: 6
      num-columns: 10

  HorizontalSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: flagPalette.bottom
    margin-top: 6

  Button
    id: okButton
    size: 43 20
    !text: tr('Ok')
    text-offset: 0 0
    anchors.right: next.left
    anchors.bottom: parent.bottom
    margin-right: 11

  Button
    id: cancelButton
    size: 43 20
    !text: tr('Cancel')
    text-offset: 0 0
    anchors.right: parent.right
    anchors.bottom: parent.bottom
