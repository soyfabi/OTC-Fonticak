&var-cip-font-new: Verdana Bold-11px

MinimapFlag < UIWidget
  size: 11 11
  focusable: false
  clipping: true

MinimapCross < UIWidget
  focusable: false
  phantom: true
  clipping: true
  image: /images/game/minimap/cross
  size: 16 16

MinimapNearbyPlayerPin < UIWidget
  focusable: false
  size: 20 20

  UIWidget
    id: pulseHalo
    anchors.fill: parent
    phantom: true
    focusable: false
    opacity: 0
    image-smooth: true
    image-source: /images/game/minimap/nearby-player-halo

  UIWidget
    size: 8 8
    anchors.centerIn: parent
    phantom: true
    focusable: false
    image-smooth: true
    image-source: /images/game/minimap/nearby-player-dot

MinimapFloorUpButton < Button
  size: 20 20
  margin-right: 28
  margin-bottom: 28
  anchors.right: parent.right
  anchors.bottom: parent.bottom
  icon-source: /images/game/minimap/floor_up
  icon-clip: 0 32 16 16
  $pressed:
    icon-clip: 0 0 16 16
  $hover !pressed:
    icon-clip: 0 16 16 16

MinimapFloorDownButton < Button
  size: 20 20
  margin-right: 28
  margin-bottom: 4
  anchors.right: parent.right
  anchors.bottom: parent.bottom
  icon-source: /images/game/minimap/floor_down
  icon-clip: 0 32 16 16
  $pressed:
    icon-clip: 0 0 16 16
  $hover !pressed:
    icon-clip: 0 16 16 16

MinimapZoomInButton < Button
  text: +
  size: 20 20
  margin-right: 4
  margin-bottom: 28
  anchors.right: parent.right
  anchors.bottom: parent.bottom
  //icon-source: /images/game/minimap/zoom_in

MinimapZoomOutButton < Button
  text: -
  size: 20 20
  margin-right: 4
  margin-bottom: 4
  anchors.right: parent.right
  anchors.bottom: parent.bottom
  //icon-source: /images/game/minimap/zoom_out

MinimapMapControl < Button
  size: 20 20
  padding: 0
  focusable: false
  icon-rect: 2 2 16 16
  icon-color: #ffffff

  $on:
    icon-color: #8fda82

MinimapHdControl < MinimapMapControl
  icon-source: /images/topbuttons/minimap

  UIWidget
    id: highlight
    anchors.centerIn: parent
    size: 22 22
    image-source: /images/topbuttons/highlight
    phantom: true
    focusable: false

  UIWidget
    id: brightButton
    anchors.fill: parent
    image-source: /images/ui/bright-x20
    phantom: true
    focusable: false

MinimapFreeViewControl < MinimapMapControl
  icon-source: /images/game/minimap/free-view

MinimapDownloadButton < QtButton
  size: 110 23
  padding: 2 4 2 4
  font: Verdana Bold-10px
  color: #ffffff
  image-smooth: false
  text-wrap: false
  focusable: false

  UIWidget
    id: highlight
    anchors.fill: parent
    border-width: 1
    border-color: #55aaff
    phantom: true
    focusable: false

MinimapFogControl < MinimapMapControl
  icon-source: /images/game/minimap/fog-of-war

MinimapCenterControl < MinimapMapControl
  icon-source: /images/game/minimap/cross

MinimapResetButton < MinimapCenterControl
  !tooltip: tr('Center the minimap on your character.')
  anchors.left: parent.left
  anchors.top: parent.top
  margin: 4

Minimap < UIMinimap
  draggable: true
  focusable: false
  cross: true
  color: black

  MinimapFloorUpButton
    id: floorUpButton
    @onClick: self:getParent():floorUp(1)

  MinimapFloorDownButton
    id: floorDownButton
    @onClick: self:getParent():floorDown(1)

  MinimapZoomInButton
    id: zoomInButton
    @onClick: self:getParent():smoothZoomBy(1)

  MinimapZoomOutButton
    id: zoomOutButton
    @onClick: self:getParent():smoothZoomBy(-1)

  MinimapResetButton
    id: resetButton
    @onClick: self:getParent():reset()


// Minimap Flag Create Window


MinimapFlagButton < CheckBoxButton
  size: 16 16
  image-source: /images/ui/button-grey-up
  image-border: 3
  $checked:
    image-source: /images/ui/button-grey-down
  margin-left: 6
  anchors.left: prev.right
  anchors.top: prev.top

MinimapFlagWindow < MainWindowHigh
  font: $var-cip-font-new
  color: #909090
  text-offset: 0 2
  size: 285 176

  Label
    id: descriptionLabel
    font: $var-cip-font-new
    color: #c0c0c0
    !text: tr('Enter a short description') .. ':'
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: -7
    margin-left: -1

  TextEdit
    height: 16
    id: description
    margin-top: 5
    anchors.left: parent.left
    anchors.top: descriptionLabel.bottom
    anchors.right: parent.right

  Label
    id: flagLabel
    font: $var-cip-font-new
    color: #c0c0c0
    !text: tr('Select a type') .. ':'
    anchors.left: parent.left
    anchors.top: description.bottom
    margin-top: 11 
    margin-left: -1

  MinimapFlagButton
    id: flag0
    icon: /images/game/minimap/flag0
    anchors.left: parent.left
    anchors.top: prev.bottom
    margin-top: 5
    margin-left: 0

  MinimapFlagButton
    id: flag1
    icon: /images/game/minimap/flag1

  MinimapFlagButton
    id: flag2
    icon: /images/game/minimap/flag2
 
  MinimapFlagButton
    id: flag3
    icon: /images/game/minimap/flag3

  MinimapFlagButton
    id: flag4
    icon: /images/game/minimap/flag4

  MinimapFlagButton
    id: flag5
    icon: /images/game/minimap/flag5

  MinimapFlagButton
    id: flag6
    icon: /images/game/minimap/flag6

  MinimapFlagButton
    id: flag7
    icon: /images/game/minimap/flag7

  MinimapFlagButton
    id: flag8
    icon: /images/game/minimap/flag8

  MinimapFlagButton
    id: flag9
    icon: /images/game/minimap/flag9

  MinimapFlagButton
    id: flag10
    icon: /images/game/minimap/flag10
    anchors.left: parent.left
    anchors.top: prev.bottom
    margin-top: 6
    margin-left: 0

  MinimapFlagButton
    id: flag11
    icon: /images/game/minimap/flag11

  MinimapFlagButton
    id: flag12
    icon: /images/game/minimap/flag12

  MinimapFlagButton
    id: flag13
    icon: /images/game/minimap/flag13

  MinimapFlagButton
    id: flag14
    icon: /images/game/minimap/flag14

  MinimapFlagButton
    id: flag15
    icon: /images/game/minimap/flag15

  MinimapFlagButton
    id: flag16
    icon: /images/game/minimap/flag16

  MinimapFlagButton
    id: flag17
    icon: /images/game/minimap/flag17

  MinimapFlagButton
    id: flag18
    icon: /images/game/minimap/flag18

  MinimapFlagButton
    id: flag19
    icon: /images/game/minimap/flag19

  HorizontalSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: flag19.bottom
    margin-top: 6

  Button
    id: okButton
    size: 43 20
    !text: tr('Ok')
    text-offset: 0 0
    anchors.right: next.left
    anchors.bottom: parent.bottom
    margin-right: 11

  Button
    id: cancelButton
    size: 43 20
    !text: tr('Cancel')
    text-offset: 0 0
    anchors.right: parent.right
    anchors.bottom: parent.bottom
