InvManaBar < UIStatsBar
  size: 10 30
  image-border: 1

StatsBarUp < UIStatsBar
  StatsBarDarkBackground
    anchors.fill: parent
    phantom: true

  UIWidget
    id: bar
    width: 1
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin: 1
    image-repeated: true

  StatsHorizontalBarGrade
    id: horizontalGrade
    anchors.fill: parent
    visible: false

  Label
    id: text
    anchors.verticalCenter: parent.verticalCenter
    anchors.horizontalCenter: parent.horizontalCenter
    text-align: center
    visible: false
    !text: '9999999999/9999999999'

StatsBarProficiencyProgressPanel < Panel
  id: proficiencyPanel
  visible: false
  size: 106 13
  fixed-size: true
  margin-right: 4

  UIWidget
    id: proficiencyBg
    size: 100 13
    anchors.top: parent.top
    anchors.left: parent.left
    image-source: /images/game/topbar/proficiency-bg
    !tooltip: tr('Proficiency Progress: 0 / 0')
    tooltip-delayed: true

    ProgressBarSD
      id: proficiencyProgress
      anchors.fill: parent
      image-source: /images/bars/progressbar-teal-11px
      margin: 1
      percent: 0

    Label
      id: proficiencyLabel
      anchors.fill: parent
      margin-right: 1
      text-align: center
      font: Verdana Bold-11px
      color: #f4f4f4
      text: ---
      phantom: true

  UIWidget
    id: proficiencyIcon
    size: 9 11
    anchors.top: parent.top
    anchors.right: proficiencyBg.right
    margin-top: 1
    margin-right: -4
    phantom: true
    on: false
    image-source: /images/game/topbar/icon-proficiencytree-off
    $on:
      image-source: /images/game/topbar/icon-proficiencytree-on

StatsBarProficiencyWidget < Panel
  id: topBarProficiencyRow
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.top: skills.bottom
  margin-top: -5
  height: 15
  phantom: true
  focusable: false

  Panel
    id: topBarProficiencyRowInner
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: parent.top
    height: 15
    phantom: true
    layout:
      type: horizontalBox
      fit-children: true

    Panel
      id: proficiencyTopBar
      height: 15
      phantom: true
      layout:
        type: horizontalBox
        fit-children: true

      Panel
        id: proficiencyButtonColumn
        size: 13 13
        fixed-size: true
        margin-right: 2
        phantom: true
        clipping: false

        UIButton
          id: proficiencyButton
          size: 13 13
          anchors.centerIn: parent
          image-source: /images/game/topbar/proficiency-button-default
          image-clip: 0 0 13 13
          !tooltip: tr('Open Weapon Proficiency Dialog')
          tooltip-delayed: true
          @onClick: modules.game_proficiency.requestOpenWindow()
          $pressed:
            image-clip: 0 13 13 13

        UIWidget
          id: highlightProficiencyButton
          size: 15 15
          phantom: true
          clipping: false
          image-source: /images/animations/button-highlight-15x15
          anchors.horizontalCenter: proficiencyButton.horizontalCenter
          anchors.verticalCenter: proficiencyButton.verticalCenter
          visible: false

      StatsBarProficiencyProgressPanel

    Panel
      id: icons
      image-border: 3
      image-source: /images/ui/button-verydarkgrey-down
      size: 106 13
      fixed-size: true
      padding-left: 2
      layout:
        type: horizontalBox

    MonkStats
      margin-left: 5
      margin-right: 9
      fixed-size: true

StatsBarTopWithShrink < UIWidget
  UIWidget
    anchors.fill: parent
    image-source: /images/ui/background
    image-repeated: true

  UIWidget
    anchors.right: rightIncreaseSidePanels.left
    anchors.left: leftIncreaseSidePanels.right
    anchors.top: parent.top
    height: 2
    background-color: white
    opacity: 0.35

  UIWidget
    anchors.right: rightIncreaseSidePanels.left
    anchors.top: parent.top
    anchors.bottom: rightDecreaseSidePanels.bottom
    margin-bottom: -2
    margin-top: 2
    width: 2
    background-color: black
    opacity: 0.35

  UIWidget
    anchors.right: parent.right
    anchors.left: prev.left
    anchors.top: rightDecreaseSidePanels.bottom
    height: 2
    background-color: white
    opacity: 0.35

  UIWidget
    anchors.right: parent.right
    anchors.top: prev.bottom
    anchors.bottom: parent.bottom
    width: 2
    background-color: black
    opacity: 0.35

  UIWidget
    anchors.right: parent.right
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-left: 2
    margin-right: 2
    height: 2
    background-color: black
    opacity: 0.35

  UIWidget
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.top: leftDecreaseSidePanels.bottom
    width: 1
    background-color: white
    opacity: 0.35

  UIWidget
    anchors.left: parent.left
    anchors.top: leftDecreaseSidePanels.bottom
    anchors.right: leftDecreaseSidePanels.right
    margin-left: 1
    height: 1
    background-color: white
    opacity: 0.35

  UIWidget
    anchors.left: leftDecreaseSidePanels.right
    anchors.bottom: leftDecreaseSidePanels.bottom
    anchors.top: parent.top
    margin-top: 2
    width: 2
    background-color: black
    opacity: 0.35

  UIWidget
    id: leftIncreaseSidePanels
    anchors.left: parent.left
    anchors.top: parent.top
    size: 9 27

  UIWidget
    id: leftDecreaseSidePanels
    anchors.left: parent.left
    anchors.top: leftIncreaseSidePanels.bottom
    size: 9 27

  UIWidget
    id: rightIncreaseSidePanels
    anchors.right: parent.right
    anchors.top: parent.top
    size: 9 27

  UIWidget
    id: rightDecreaseSidePanels
    anchors.right: parent.right
    anchors.top: rightIncreaseSidePanels.bottom
    size: 9 27

TopStatsSkillElement < UIWidget
  height: 20

  Label
    id: level
    !text: '99999'
    color: #c0c0c0ff
    text-align: right
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 10

  UIWidget
    id: icon
    size: 9 9
    anchors.verticalCenter: level.verticalCenter
    anchors.left: level.right
    margin-left: 7

  StatsBarUp
    id: bar
    anchors.verticalCenter: level.verticalCenter
    anchors.left: icon.right
    anchors.right: statsbarXpBoostSlot.left
    !statsbar-size: 'tiny'
    !statsbar-orientation: 'horizontal'
    statsbar-text: true
    margin-left: 5
    margin-right: 2
    height: 7

  Panel
    id: statsbarXpBoostSlot
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    width: 0
    margin-right: 0

    UIWidget
      id: statsbarXpBoostButton
      size: 76 14
      fixed-size: true
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      visible: false
      image-source: /images/ui/button-storexp
      !tooltip: tr('Purchase XP Boost')
      tooltip-delayed: true
      @onClick: modules.game_store.openPremiumBoost()
      $pressed:
        image-source: /images/ui/button-storexp-pressed

HarmonyIcon < UIWidget
  size: 13 13
  image-source: /images/game/topbar/icon-combopoint-empty
  $on:
    image-source: /images/game/topbar/icon-combopoint-filled

MonkStats < UIWidget
  id: monkStats
  enabled: false
  $disabled:
    visible: false
    margin-left: 0
    margin-top: 0
    size: 0 0
  $!disabled:
    visible: true
    margin-left: 6
    width: 96
    height: 13

  Panel
    id: harmonies
    anchors.left: parent.left
    anchors.top: parent.top
    size: 73 13
    layout:
      type: horizontalBox
      spacing: 2
    HarmonyIcon
    HarmonyIcon
    HarmonyIcon
    HarmonyIcon
    HarmonyIcon

  VerticalSeparator
    id: separatorHarmoniesSerene
    anchors.left: harmonies.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin-left: 4
    width: 2

  UIWidget
    id: serene
    anchors.left: separatorHarmoniesSerene.right
    anchors.top: parent.top
    margin-left: 4
    size: 13 13
    image-source: /images/game/topbar/icon-serene-off
    $on:
      image-source: /images/game/topbar/icon-serene-on
    $disabled:
      visible: false
      size: 0 0
    $!disabled:
      visible: true
      size: 13 13

TopStatsBarLargeOnTop < UIWidget
  StatsBarTopWithShrink
    anchors.fill: parent

  Panel
    id: largeTopCenterRow
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: parent.top
    margin-top: 4
    height: 27
    phantom: true
    clipping: true
    focusable: false
    layout:
      type: horizontalBox
      fit-children: true

    Panel
      id: proficiencyButtonLargeWrap
      size: 27 27
      fixed-size: true
      margin-right: 5
      phantom: true
      clipping: false
      focusable: false

      UIButton
        id: proficiencyButtonLarge
        anchors.fill: parent
        image-source: /images/game/topbar/proficiency-button-large-unequipped
        image-clip: 0 0 27 27
        !tooltip: tr('Open Weapon Proficiency Dialog')
        tooltip-delayed: true
        @onClick: modules.game_proficiency.requestOpenWindow()
        $hover !pressed:
          image-clip: 0 0 27 27
        $pressed:
          image-clip: 0 27 27 27

      UIWidget
        id: highlightProficiencyButtonLarge
        size: 23 23
        phantom: true
        clipping: false
        image-source: /images/animations/button-highlight-23x23
        anchors.horizontalCenter: proficiencyButtonLarge.horizontalCenter
        anchors.verticalCenter: proficiencyButtonLarge.verticalCenter
        visible: false

    StatsBarProficiencyProgressPanel

    Panel
      id: icons
      image-border: 3
      image-source: /images/ui/button-verydarkgrey-down
      size: 53 27
      fixed-size: true
      padding-left: 2
      layout:
        type: horizontalBox

    MonkStats
      margin-left: 5
      margin-right: 9
      fixed-size: true
      height: 27

  StatsBarUp
    id: health
    anchors.top: largeTopCenterRow.top
    anchors.left: parent.left
    anchors.right: largeTopCenterRow.left
    !statsbar-type: 'health'
    !statsbar-size: 'large'
    !statsbar-orientation: 'horizontal'
    statsbar-text: true
    margin-left: 15
    margin-right: 7
    height: 27

  StatsBarUp
    id: mana
    anchors.top: largeTopCenterRow.top
    anchors.right: parent.right
    anchors.left: largeTopCenterRow.right
    !statsbar-type: 'mana'
    !statsbar-size: 'large'
    !statsbar-orientation: 'horizontal'
    statsbar-text: true
    margin-right: 12
    margin-left: 6
    height: 27

  StatsBarUp
    id: manashield
    anchors.top: largeTopCenterRow.bottom
    anchors.right: parent.right
    anchors.left: largeTopCenterRow.right
    !statsbar-type: 'manashield'
    !statsbar-size: 'small'
    !statsbar-orientation: 'horizontal'
    statsbar-text: true
    margin-top: 0
    margin-right: 12
    margin-left: 6
    height: 14

  Panel
    id: skills
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: manashield.bottom
    margin-top: 2
    margin-left: 10
    margin-right: 12
    height: 0

